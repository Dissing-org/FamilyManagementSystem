@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject ChildApiClient ChildApi

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6]">@L["Timeline.Title"]</h3>
            <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B]">@L["Timeline.Subtitle"]</p>
        </div>
        <button @onclick="() => _showAddMemoryModal = true" class="inline-flex items-center gap-2 px-4 py-2 bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] font-bold text-sm rounded-xl shadow-xs transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            @L["Timeline.AddMemory"]
        </button>
    </div>

    @if (_loading)
    {
        <div class="py-12 text-center text-[#7F6A5D] dark:text-[#A8988B] text-sm">@L["Timeline.Loading"]</div>
    }
    else if (_milestones.Count == 0)
    {
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-[#D9822B]/15 text-[#8F4E0E] dark:bg-[#D9822B]/25 dark:text-[#F4C596] flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
            </div>
            <h4 class="text-base font-bold text-[#2B1D16] dark:text-[#FAF0E6]">@L["Timeline.EmptyTitle"]</h4>
            <p class="text-sm text-[#7F6A5D] dark:text-[#A8988B] mt-1 mb-6">@L["Timeline.EmptySubtitle"]</p>
            <button @onclick="() => _showAddMemoryModal = true" class="px-5 py-2.5 bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:text-[#7B2F14] text-white text-sm font-semibold rounded-xl shadow-xs">
                @L["Timeline.RecordFirstMemory"]
            </button>
        </div>
    }
    else
    {
        <!-- Chronological Timeline Stream -->
        <div class="relative pl-6 sm:pl-8 border-l-2 border-[#EADECF] dark:border-[#3D2F28] space-y-6 my-4">
            @foreach (var m in _milestones)
            {
                <div class="relative group">
                    <!-- Timeline Dot -->
                    <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-[#C85A32] dark:bg-[#FDEEE9] border-4 border-white dark:border-[#1C1512] shadow-xs"></div>

                    <!-- Memory Card -->
                    <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-5 shadow-xs transition-shadow hover:shadow-md">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold @GetCategoryBadgeColor(m.Category)">
                                    @L.MilestoneCategory(m.Category)
                                </span>
                                <h4 class="text-base font-bold text-[#2B1D16] dark:text-[#FAF0E6]">@L.MilestoneText(m.Title)</h4>
                            </div>

                            <div class="flex items-center gap-2 text-xs font-medium text-[#7F6A5D] dark:text-[#A8988B]">
                                @if (m.AchievedDate.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        @L.FormatDate(m.AchievedDate.Value)
                                    </span>
                                }
                                @if (m.AchievedAgeMonths.HasValue)
                                {
                                    <span class="px-2 py-0.5 rounded bg-[#FAF6F0] dark:bg-[#1C1512] text-[#7F6A5D] dark:text-[#EADECF] border border-[#EADECF]/50 dark:border-[#3D2F28]/50 font-semibold text-[11px]">
                                        @L.Format("Timeline.AtAge", L.FormatAgeMonths(m.AchievedAgeMonths.Value))
                                    </span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(m.Notes))
                        {
                            <p class="text-sm text-[#2B1D16] dark:text-[#FAF0E6] mt-2 whitespace-pre-wrap leading-relaxed">
                                @m.Notes
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showAddMemoryModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#261D19] rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] p-6 max-w-md w-full shadow-2xl">
            <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6] mb-4">@L["Timeline.Modal.Title"]</h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Timeline.Modal.TitleLabel"]</label>
                    <input @bind="_newTitle" placeholder="@L["Timeline.Modal.TitlePlaceholder"]" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Common.Category"]</label>
                        <select @bind="_newCategory" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]">
                            <option value="GrossMotor">@L.MilestoneCategory("GrossMotor")</option>
                            <option value="FineMotor">@L.MilestoneCategory("FineMotor")</option>
                            <option value="LanguageSpeech">@L.MilestoneCategory("LanguageSpeech")</option>
                            <option value="Cognitive">@L.MilestoneCategory("Cognitive")</option>
                            <option value="SocialEmotional">@L.MilestoneCategory("SocialEmotional")</option>
                            <option value="Dental">@L.MilestoneCategory("Dental")</option>
                            <option value="HealthSelfCare">@L.MilestoneCategory("HealthSelfCare")</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Roadmap.Modal.DateAchieved"]</label>
                        <input @bind="_newAchievedDate" type="date" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Timeline.Modal.StoryLabel"]</label>
                    <textarea @bind="_newNotes" rows="3" placeholder="@L["Timeline.Modal.StoryPlaceholder"]" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showAddMemoryModal = false" class="px-4 py-2 text-sm font-semibold text-[#7F6A5D] dark:text-[#EADECF] hover:bg-[#FAF6F0] dark:hover:bg-[#3D2F28]/50 rounded-xl">@L["Common.Cancel"]</button>
                <button @onclick="SaveMemoryAsync" class="px-5 py-2 text-sm font-semibold bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] rounded-xl shadow-xs">@L["Timeline.Modal.SaveMemory"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ChildId { get; set; }
    [Parameter] public EventCallback OnMilestonesChanged { get; set; }

    private List<ChildMilestoneModel> _milestones = new();
    private bool _loading = true;
    private bool _showAddMemoryModal;

    private string _newTitle = string.Empty;
    private string _newCategory = "GrossMotor";
    private DateTime _newAchievedDate = DateTime.Today;
    private string? _newNotes;

    protected override async Task OnParametersSetAsync()
    {
        await LoadMilestonesAsync();
    }

    private async Task LoadMilestonesAsync()
    {
        _loading = true;
        _milestones = await ChildApi.GetMilestonesAsync(ChildId, status: "Achieved");
        _loading = false;
    }

    private async Task SaveMemoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;

        var result = await ChildApi.CreateMilestoneAsync(
            ChildId,
            _newTitle,
            _newCategory,
            isAchieved: true,
            expectedAgeMonths: null,
            expectedWindowMaxMonths: null,
            achievedDate: _newAchievedDate,
            description: null,
            notes: _newNotes,
            photoUrl: null);

        if (result != null)
        {
            _showAddMemoryModal = false;
            _newTitle = string.Empty;
            _newNotes = null;
            await LoadMilestonesAsync();
            await OnMilestonesChanged.InvokeAsync();
        }
    }

    private string GetCategoryBadgeColor(string cat) => cat switch
    {
        "GrossMotor" => "bg-[#C85A32]/15 text-[#C85A32] dark:bg-[#C85A32]/30 dark:text-[#FDEEE9]",
        "FineMotor" => "bg-[#D9822B]/15 text-[#8F4E0E] dark:bg-[#D9822B]/25 dark:text-[#F4C596]",
        "LanguageSpeech" => "bg-[#5B7553]/15 text-[#5B7553] dark:bg-[#5B7553]/30 dark:text-[#9BBA93]",
        "Dental" => "bg-[#FAF0E6] text-[#7B2F14] dark:bg-[#3D2F28] dark:text-[#EADECF]",
        "SocialEmotional" => "bg-[#FDEEE9] text-[#7B2F14] dark:bg-[#3D2F28] dark:text-[#FDEEE9]",
        _ => "bg-[#FAF6F0] text-[#7F6A5D] dark:bg-[#1C1512] dark:text-[#EADECF]"
    };
}