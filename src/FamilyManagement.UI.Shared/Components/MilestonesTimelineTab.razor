@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject ChildApiClient ChildApi

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h3 class="text-lg font-bold text-slate-900">@L["Timeline.Title"]</h3>
            <p class="text-xs text-slate-500">@L["Timeline.Subtitle"]</p>
        </div>
        <button @onclick="() => _showAddMemoryModal = true" class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm rounded-xl shadow-xs transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            @L["Timeline.AddMemory"]
        </button>
    </div>

    @if (_loading)
    {
        <div class="py-12 text-center text-slate-500 text-sm">@L["Timeline.Loading"]</div>
    }
    else if (_milestones.Count == 0)
    {
        <div class="bg-white border border-slate-200/80 rounded-2xl p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-sky-50 text-sky-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                </svg>
            </div>
            <h4 class="text-base font-bold text-slate-900">@L["Timeline.EmptyTitle"]</h4>
            <p class="text-sm text-slate-500 mt-1 mb-6">@L["Timeline.EmptySubtitle"]</p>
            <button @onclick="() => _showAddMemoryModal = true" class="px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold rounded-xl shadow-xs">
                @L["Timeline.RecordFirstMemory"]
            </button>
        </div>
    }
    else
    {
        <!-- Chronological Timeline Stream -->
        <div class="relative pl-6 sm:pl-8 border-l-2 border-slate-200/80 space-y-6 my-4">
            @foreach (var m in _milestones)
            {
                <div class="relative group">
                    <!-- Timeline Dot -->
                    <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-sky-600 border-4 border-white shadow-xs"></div>

                    <!-- Memory Card -->
                    <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs transition-shadow hover:shadow-md">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold @GetCategoryBadgeColor(m.Category)">
                                    @L.MilestoneCategory(m.Category)
                                </span>
                                <h4 class="text-base font-bold text-slate-900">@L.MilestoneText(m.Title)</h4>
                            </div>

                            <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                                @if (m.AchievedDate.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        @L.FormatDate(m.AchievedDate.Value)
                                    </span>
                                }
                                @if (m.AchievedAgeMonths.HasValue)
                                {
                                    <span class="px-2 py-0.5 rounded bg-slate-50 text-slate-700 border border-slate-200/60 font-semibold text-[11px]">
                                        @L.Format("Timeline.AtAge", L.FormatAgeMonths(m.AchievedAgeMonths.Value))
                                    </span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(m.Notes))
                        {
                            <p class="text-sm text-slate-700 mt-2 whitespace-pre-wrap leading-relaxed">
                                @m.Notes
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showAddMemoryModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-w-md w-full shadow-xl">
            <h3 class="text-lg font-bold text-slate-900 mb-4">@L["Timeline.Modal.Title"]</h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Timeline.Modal.TitleLabel"]</label>
                    <input @bind="_newTitle" placeholder="@L["Timeline.Modal.TitlePlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Common.Category"]</label>
                        <select @bind="_newCategory" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white">
                            <option value="GrossMotor">@L.MilestoneCategory("GrossMotor")</option>
                            <option value="FineMotor">@L.MilestoneCategory("FineMotor")</option>
                            <option value="LanguageSpeech">@L.MilestoneCategory("LanguageSpeech")</option>
                            <option value="Cognitive">@L.MilestoneCategory("Cognitive")</option>
                            <option value="SocialEmotional">@L.MilestoneCategory("SocialEmotional")</option>
                            <option value="Dental">@L.MilestoneCategory("Dental")</option>
                            <option value="HealthSelfCare">@L.MilestoneCategory("HealthSelfCare")</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Roadmap.Modal.DateAchieved"]</label>
                        <input @bind="_newAchievedDate" type="date" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Timeline.Modal.StoryLabel"]</label>
                    <textarea @bind="_newNotes" rows="3" placeholder="@L["Timeline.Modal.StoryPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showAddMemoryModal = false" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">@L["Common.Cancel"]</button>
                <button @onclick="SaveMemoryAsync" class="px-5 py-2 text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-xs transition-colors">@L["Timeline.Modal.SaveMemory"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ChildId { get; set; }
    [Parameter] public EventCallback OnMilestonesChanged { get; set; }

    private List<ChildMilestoneModel> _milestones = new();
    private bool _loading = true;
    private bool _showAddMemoryModal;

    private string _newTitle = string.Empty;
    private string _newCategory = "GrossMotor";
    private DateTime _newAchievedDate = DateTime.Today;
    private string? _newNotes;

    protected override async Task OnParametersSetAsync()
    {
        await LoadMilestonesAsync();
    }

    private async Task LoadMilestonesAsync()
    {
        _loading = true;
        _milestones = await ChildApi.GetMilestonesAsync(ChildId, status: "Achieved");
        _loading = false;
    }

    private async Task SaveMemoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;

        var result = await ChildApi.CreateMilestoneAsync(
            ChildId,
            _newTitle,
            _newCategory,
            isAchieved: true,
            expectedAgeMonths: null,
            expectedWindowMaxMonths: null,
            achievedDate: _newAchievedDate,
            description: null,
            notes: _newNotes,
            photoUrl: null);

        if (result != null)
        {
            _showAddMemoryModal = false;
            _newTitle = string.Empty;
            _newNotes = null;
            await LoadMilestonesAsync();
            await OnMilestonesChanged.InvokeAsync();
        }
    }

    private static string GetCategoryBadgeColor(string cat) => cat switch
    {
        "GrossMotor" => "bg-blue-50 text-blue-700 border border-blue-200/60",
        "FineMotor" => "bg-amber-50 text-amber-800 border border-amber-200/60",
        "LanguageSpeech" => "bg-emerald-50 text-emerald-700 border border-emerald-200/60",
        "Dental" => "bg-cyan-50 text-cyan-700 border border-cyan-200/60",
        "SocialEmotional" => "bg-purple-50 text-purple-700 border border-purple-200/60",
        _ => "bg-slate-50 text-slate-700 border border-slate-200/60"
    };
}