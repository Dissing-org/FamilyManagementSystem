@using FamilyManagement.UI.Shared.Models
@inject FamilyManagement.UI.Shared.Services.IApiBaseUrlProvider ApiBaseUrlProvider

<div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 hover:shadow-md transition-shadow duration-200 p-5 flex flex-col justify-between">
    <div>
        <!-- Top bar: Category & Date -->
        <div class="flex items-center justify-between gap-2 mb-3">
            <CategoryBadge Category="@Receipt.Category" />
            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">@Receipt.FormattedDate</span>
        </div>

        <!-- Merchant & Amount -->
        <div class="mb-3">
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 truncate" title="@Receipt.Merchant">
                @Receipt.Merchant
            </h3>
            <div class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 mt-1">
                @Receipt.FormattedAmount
            </div>
        </div>

        <!-- Notes if present -->
        @if (!string.IsNullOrWhiteSpace(Receipt.Notes))
        {
            <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 italic mb-4 bg-slate-50 dark:bg-slate-700/50 p-2 rounded-lg">
                "@Receipt.Notes"
            </p>
        }
    </div>

    <!-- Actions Bar -->
    <div class="pt-3 border-t border-slate-100 dark:border-slate-700/70 flex items-center justify-between gap-2 mt-2">
        @if (!string.IsNullOrWhiteSpace(Receipt.WebViewLink))
        {
            <a href="@GetResolvedViewLink()" target="_blank" rel="noopener noreferrer" 
               class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                @(Receipt.WebViewLink.Contains("drive.google.com") ? "View in Drive" : "View Receipt")
            </a>
        }
        else
        {
            <span class="text-xs text-slate-400">@Receipt.FileName</span>
        }

        <button @onclick="() => OnDelete.InvokeAsync(Receipt.Id)" 
                class="text-xs font-medium text-rose-600 dark:text-rose-400 hover:text-rose-800 hover:bg-rose-50 dark:hover:bg-rose-900/30 px-2 py-1 rounded transition-colors"
                title="Archive receipt">
            Delete
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ReceiptViewModel Receipt { get; set; } = null!;

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    private string GetResolvedViewLink()
    {
        if (string.IsNullOrWhiteSpace(Receipt.WebViewLink)) return string.Empty;
        if (Receipt.WebViewLink.StartsWith("/api/"))
        {
            var baseUri = ApiBaseUrlProvider.GetBaseUrl()?.TrimEnd('/') ?? "";
            return $"{baseUri}{Receipt.WebViewLink}";
        }
        return Receipt.WebViewLink;
    }
}
