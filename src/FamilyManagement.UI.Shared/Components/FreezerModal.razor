@using FamilyManagement.UI.Shared.Models

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-fade-in">
    <div class="relative w-full max-w-md bg-white border border-slate-200/80 rounded-3xl shadow-xl overflow-hidden flex flex-col">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">
                        @(IsEdit ? L["Freezer.EditFreezerTitle"] : L["Freezer.AddFreezerTitle"])
                    </h3>
                    <p class="text-xs text-slate-500">
                        @L["Freezer.FreezerModalSubtitle"]
                    </p>
                </div>
            </div>
            <button @onclick="OnClose" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Form Body -->
        <div class="p-6 space-y-4">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="p-3 rounded-xl bg-rose-50 text-rose-700 border border-rose-200/60 text-xs">
                    @_errorMessage
                </div>
            }

            <!-- Freezer Name -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Freezer.Name"] *
                </label>
                <input type="text"
                       @bind="_model.Name"
                       placeholder="f.eks. Køkkenfryser, Kummefryser garage"
                       class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
            </div>

            <!-- Location -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Freezer.LocationLabel"]
                </label>
                <input type="text"
                       @bind="_model.Location"
                       placeholder="f.eks. Køkken, Bryggers, Kælder"
                       class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
            </div>

            <!-- Display Order -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Common.DisplayOrder"]
                </label>
                <input type="number"
                       @bind="_model.DisplayOrder"
                       class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2.5">
            <button @onclick="OnClose"
                    class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:text-slate-800 hover:bg-slate-200/60 transition-colors">
                @L["Common.Cancel"]
            </button>
            <button @onclick="HandleSaveAsync"
                    disabled="@_isSaving"
                    class="px-5 py-2 rounded-xl text-xs font-bold bg-sky-600 text-white hover:bg-sky-700 shadow-xs disabled:opacity-50 transition-all flex items-center gap-1.5 cursor-pointer">
                @if (_isSaving)
                {
                    <span class="animate-spin h-3.5 w-3.5 border-2 border-white border-t-transparent rounded-full"></span>
                }
                <span>@(IsEdit ? L["Common.Save"] : L["Freezer.CreateFreezer"])</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public FreezerDto? ExistingFreezer { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<FreezerDto> OnSaved { get; set; }

    [Inject]
    public FreezerApiClient ApiClient { get; set; } = null!;

    private bool IsEdit => ExistingFreezer is not null;
    private CreateFreezerRequest _model = new();
    private bool _isSaving;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (ExistingFreezer is not null)
        {
            _model = new CreateFreezerRequest
            {
                Name = ExistingFreezer.Name,
                Location = ExistingFreezer.Location,
                DisplayOrder = ExistingFreezer.DisplayOrder
            };
        }
    }

    private async Task HandleSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = L["Freezer.NameRequired"];
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (IsEdit)
            {
                var updateReq = new UpdateFreezerRequest
                {
                    Id = ExistingFreezer!.Id,
                    Name = _model.Name,
                    Location = _model.Location,
                    DisplayOrder = _model.DisplayOrder
                };

                var res = await ApiClient.UpdateFreezerAsync(ExistingFreezer.Id, updateReq);
                if (res.Success && res.Freezer != null)
                {
                    await OnSaved.InvokeAsync(res.Freezer);
                }
                else
                {
                    _errorMessage = res.Error ?? "Failed to update freezer.";
                }
            }
            else
            {
                var res = await ApiClient.CreateFreezerAsync(_model);
                if (res.Success && res.Freezer != null)
                {
                    // If newly created, add a default drawer
                    await ApiClient.CreateCompartmentAsync(res.Freezer.Id, new CreateCompartmentRequest
                    {
                        FreezerId = res.Freezer.Id,
                        Name = "Skuffe 1",
                        DisplayOrder = 0
                    });

                    await OnSaved.InvokeAsync(res.Freezer);
                }
                else
                {
                    _errorMessage = res.Error ?? "Failed to create freezer.";
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
