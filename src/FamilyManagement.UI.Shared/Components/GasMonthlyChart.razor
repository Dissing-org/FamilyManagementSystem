@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
            <h3 class="text-lg font-bold text-slate-900">@L["Gas.ChartTitle"]</h3>
            <p class="text-xs text-slate-500">@L["Gas.ChartSubtitle"]</p>
        </div>
        
        <!-- Legend -->
        <div class="flex items-center gap-4 text-xs font-semibold text-slate-600">
            <div class="flex items-center gap-1.5">
                <span class="w-3.5 h-3.5 rounded-sm bg-amber-500"></span>
                <span>@L["Gas.VolumeAxis"]</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="w-3.5 h-1.5 rounded-full bg-sky-600"></span>
                <span>@L["Gas.CostAxis"]</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="w-3.5 h-3.5 rounded-sm bg-amber-200 border border-dashed border-amber-500"></span>
                <span>@L["Gas.ProjectedBadge"]</span>
            </div>
        </div>
    </div>

    @if (Series == null || Series.Count == 0 || Series.All(s => s.ConsumedM3 == 0 && s.TotalCostDkk == 0))
    {
        <div class="py-16 text-center text-slate-400">
            <svg class="w-12 h-12 mx-auto mb-3 opacity-40 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <p class="text-sm font-medium text-slate-500">@L["Gas.EmptySubtitle"]</p>
        </div>
    }
    else
    {
        var maxM3 = Math.Max(50m, Series.Max(s => s.ConsumedM3) * 1.15m);
        var maxCost = Math.Max(500m, Series.Max(s => s.TotalCostDkk) * 1.15m);
        var chartWidth = 900;
        var chartHeight = 280;
        var paddingLeft = 50;
        var paddingRight = 60;
        var paddingTop = 20;
        var paddingBottom = 40;
        var plotWidth = chartWidth - paddingLeft - paddingRight;
        var plotHeight = chartHeight - paddingTop - paddingBottom;
        var count = Series.Count;
        var barWidth = Math.Max(12, (plotWidth / count) - 16);

        <div class="w-full overflow-x-auto">
            <div class="min-w-[650px] relative">
                <svg viewBox="0 0 @chartWidth @chartHeight" class="w-full h-auto overflow-visible select-none font-sans">
                    <!-- Grid Lines (4 horizontal) -->
                    @for (int i = 0; i <= 4; i++)
                    {
                        var y = paddingTop + (plotHeight * i / 4);
                        var m3Val = maxM3 * (4 - i) / 4;
                        var costVal = maxCost * (4 - i) / 4;

                        <line x1="@paddingLeft" y1="@y" x2="@(chartWidth - paddingRight)" y2="@y" stroke="#f1f5f9" stroke-width="1.5" />
                        
                        <!-- Left Y-axis (m3) -->
                        @:<text x="@(paddingLeft - 8)" y="@(y + 4)" text-anchor="end" class="text-[10px] fill-slate-400 font-medium">@($"{m3Val:N0}")</text>
                        <!-- Right Y-axis (kr) -->
                        @:<text x="@(chartWidth - paddingRight + 8)" y="@(y + 4)" text-anchor="start" class="text-[10px] fill-sky-600/70 font-medium">@($"{costVal:N0} kr")</text>
                    }

                    <!-- Bars (Volume m3) -->
                    @for (int i = 0; i < count; i++)
                    {
                        var item = Series[i];
                        var slotWidth = (float)plotWidth / count;
                        var x = paddingLeft + (i * slotWidth) + (slotWidth / 2) - (barWidth / 2);
                        var barHeight = maxM3 > 0 ? (float)(item.ConsumedM3 / maxM3) * plotHeight : 0;
                        var y = paddingTop + plotHeight - barHeight;
                        var monthName = GetMonthShort(item.Month);

                        <!-- Bar -->
                        <rect x="@x" y="@y" width="@barWidth" height="@barHeight" rx="4"
                              fill="@(item.IsProjected ? "#fef3c7" : "#f59e0b")"
                              stroke="@(item.IsProjected ? "#f59e0b" : "none")"
                              stroke-width="@(item.IsProjected ? "1.5" : "0")"
                              stroke-dasharray="@(item.IsProjected ? "3,3" : "none")"
                              class="transition-all hover:opacity-80 cursor-pointer">
                            <title>@($"{monthName} {item.Year}: {item.ConsumedM3:N1} m³ ({item.TotalCostDkk:N0} kr.)")</title>
                        </rect>

                        <!-- Value on top of bar if space permits -->
                        @if (item.ConsumedM3 > 0)
                        {
                            @:<text x="@(x + barWidth / 2)" y="@(Math.Max(paddingTop + 12, y - 6))" text-anchor="middle" class="text-[10px] font-bold @(item.IsProjected ? "fill-amber-600" : "fill-slate-700")">@($"{item.ConsumedM3:N0}")</text>
                        }

                        <!-- X Axis Label -->
                        @:<text x="@(x + barWidth / 2)" y="@(chartHeight - 14)" text-anchor="middle" class="text-[11px] font-semibold @(item.IsProjected ? "fill-sky-700 font-black" : "fill-slate-500")">@monthName</text>
                    }

                    <!-- Cost Line Path & Points -->
                    @{
                        var points = new List<string>();
                        for (int i = 0; i < count; i++)
                        {
                            var item = Series[i];
                            var slotWidth = (float)plotWidth / count;
                            var px = paddingLeft + (i * slotWidth) + (slotWidth / 2);
                            var py = paddingTop + plotHeight - (maxCost > 0 ? (float)(item.TotalCostDkk / maxCost) * plotHeight : 0);
                            points.Add($"{px:F1},{py:F1}");
                        }
                        var pathD = "M " + string.Join(" L ", points);
                    }

                    <path d="@pathD" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

                    @for (int i = 0; i < count; i++)
                    {
                        var item = Series[i];
                        var slotWidth = (float)plotWidth / count;
                        var px = paddingLeft + (i * slotWidth) + (slotWidth / 2);
                        var py = paddingTop + plotHeight - (maxCost > 0 ? (float)(item.TotalCostDkk / maxCost) * plotHeight : 0);

                        <circle cx="@px" cy="@py" r="@(item.IsProjected ? "5" : "4")"
                                fill="@(item.IsProjected ? "#38bdf8" : "#0284c7")"
                                stroke="#ffffff" stroke-width="2" class="cursor-pointer">
                            <title>@($"{GetMonthShort(item.Month)} {item.Year}: {item.TotalCostDkk:N0} kr. (Forventet: {item.ConsumedM3:N1} m³)")</title>
                        </circle>
                    }
                </svg>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<GasMonthlySeriesDto> Series { get; set; } = new();

    private static string GetMonthShort(int month) => month switch
    {
        1 => "Jan",
        2 => "Feb",
        3 => "Mar",
        4 => "Apr",
        5 => "Maj",
        6 => "Jun",
        7 => "Jul",
        8 => "Aug",
        9 => "Sep",
        10 => "Okt",
        11 => "Nov",
        12 => "Dec",
        _ => month.ToString()
    };
}
