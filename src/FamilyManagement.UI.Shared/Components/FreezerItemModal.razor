@using FamilyManagement.UI.Shared.Models

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-fade-in">
    <div class="relative w-full max-w-lg bg-white border border-slate-200/80 rounded-3xl shadow-xl overflow-hidden flex flex-col max-h-[90vh]">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">
                        @(IsEdit ? L["Freezer.EditItemTitle"] : L["Freezer.AddItemTitle"])
                    </h3>
                    <p class="text-xs text-slate-500">
                        @L["Freezer.ItemModalSubtitle"]
                    </p>
                </div>
            </div>
            <button @onclick="OnClose" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Form Body -->
        <div class="p-6 overflow-y-auto space-y-4">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="p-3 rounded-xl bg-rose-50 text-rose-700 border border-rose-200/60 text-xs">
                    @_errorMessage
                </div>
            }

            <!-- Item Name with Catalog Combobox -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Freezer.ItemName"] *
                </label>
                <FreezerItemCombobox Value="@_model.Name"
                                     ValueChanged="OnItemNameChanged"
                                     CatalogItems="_catalogItems"
                                     OnItemSelected="OnCatalogItemSelected"
                                     OnDeleteItem="OnDeleteCatalogItem" />
            </div>

            <!-- Freezer & Compartment Selection -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Freezer.Location"] *
                </label>
                <select @bind="_model.CompartmentId"
                        class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all">
                    @foreach (var freezer in Freezers)
                    {
                        <optgroup label="@freezer.Name">
                            @foreach (var comp in freezer.Compartments)
                            {
                                <option value="@comp.Id">@comp.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            <!-- Category & Unit -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        @L["Freezer.Category"] *
                    </label>
                    <select value="@_model.Category"
                            @onchange="OnCategoryChanged"
                            class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all">
                        <option value="MeatAndPoultry">@L["Freezer.Category.MeatAndPoultry"]</option>
                        <option value="Seafood">@L["Freezer.Category.Seafood"]</option>
                        <option value="VegetablesAndFruits">@L["Freezer.Category.VegetablesAndFruits"]</option>
                        <option value="PreparedMeals">@L["Freezer.Category.PreparedMeals"]</option>
                        <option value="Bakery">@L["Freezer.Category.Bakery"]</option>
                        <option value="DessertsAndIceCream">@L["Freezer.Category.DessertsAndIceCream"]</option>
                        <option value="Other">@L["Freezer.Category.Other"]</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        @L["Freezer.Unit"] *
                    </label>
                    <select @bind="_model.Unit"
                            class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all">
                        <option value="Pieces">@L["Freezer.Unit.Pieces"]</option>
                        <option value="Packages">@L["Freezer.Unit.Packages"]</option>
                        <option value="Portions">@L["Freezer.Unit.Portions"]</option>
                        <option value="Grams">@L["Freezer.Unit.Grams"]</option>
                        <option value="Kilograms">@L["Freezer.Unit.Kilograms"]</option>
                        <option value="Liters">@L["Freezer.Unit.Liters"]</option>
                    </select>
                </div>
            </div>

            <!-- Quantity & Minimum Threshold -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        @L["Freezer.Quantity"] *
                    </label>
                    <input type="number"
                           step="any"
                           min="0"
                           @bind="_model.Quantity"
                           class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        @L["Freezer.MinimumQuantity"]
                    </label>
                    <input type="number"
                           step="any"
                           min="0"
                           @bind="_model.MinimumQuantity"
                           placeholder="Valgfrit genbestillingsniveau"
                           class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
                </div>
            </div>

            <!-- Freeze Date & Expiry Date -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        @L["Freezer.FreezeDate"] *
                    </label>
                    <input type="date"
                           value="@_model.FreezeDate.ToString("yyyy-MM-dd")"
                           @onchange="OnFreezeDateChanged"
                           class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
                        @L["Freezer.ExpiryDate"]
                    </label>
                    <input type="date"
                           value="@(_model.ExpiryDate?.ToString("yyyy-MM-dd") ?? "")"
                           @onchange="OnExpiryDateChanged"
                           class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
                </div>
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Common.Notes"]
                </label>
                <textarea @bind="_model.Notes"
                          rows="2"
                          placeholder="f.eks. optøningstid, opskrift, dato tilberedt..."
                          class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all"></textarea>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2.5">
            <button @onclick="OnClose"
                    class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:text-slate-800 hover:bg-slate-200/60 transition-colors">
                @L["Common.Cancel"]
            </button>
            <button @onclick="HandleSaveAsync"
                    disabled="@_isSaving"
                    class="px-5 py-2 rounded-xl text-xs font-bold bg-sky-600 text-white hover:bg-sky-700 shadow-xs disabled:opacity-50 transition-all flex items-center gap-1.5 cursor-pointer">
                @if (_isSaving)
                {
                    <span class="animate-spin h-3.5 w-3.5 border-2 border-white border-t-transparent rounded-full"></span>
                }
                <span>@(IsEdit ? L["Common.Save"] : L["Freezer.SaveItem"])</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public FreezerItemDto? ExistingItem { get; set; }

    [Parameter]
    public Guid? DefaultCompartmentId { get; set; }

    [Parameter]
    public IReadOnlyList<FreezerDto> Freezers { get; set; } = Array.Empty<FreezerDto>();

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<FreezerItemDto> OnSaved { get; set; }

    [Inject]
    public FreezerApiClient ApiClient { get; set; } = null!;

    private bool IsEdit => ExistingItem is not null;
    private CreateFreezerItemRequest _model = new();
    private bool _isSaving;
    private string? _errorMessage;
    private List<FreezerCatalogItemDto> _catalogItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        try
        {
            _catalogItems = await ApiClient.GetCatalogAsync();
        }
        catch
        {
            _catalogItems = new();
        }
    }

    private void OnItemNameChanged(string name)
    {
        _model.Name = name;
    }

    private void OnCatalogItemSelected(FreezerCatalogItemDto item)
    {
        _model.Name = item.Name;
        _model.Category = item.DefaultCategory;
        _model.Unit = item.DefaultUnit;
        if (item.DefaultMinimumQuantity.HasValue && (!_model.MinimumQuantity.HasValue || _model.MinimumQuantity.Value == 0))
        {
            _model.MinimumQuantity = item.DefaultMinimumQuantity.Value;
        }
        RecalculateExpiry();
    }

    private async Task OnDeleteCatalogItem(Guid id)
    {
        var success = await ApiClient.DeleteCatalogItemAsync(id);
        if (success)
        {
            _catalogItems.RemoveAll(c => c.Id == id);
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        if (ExistingItem is not null)
        {
            _model = new CreateFreezerItemRequest
            {
                CompartmentId = ExistingItem.CompartmentId,
                Name = ExistingItem.Name,
                Category = ExistingItem.Category,
                Quantity = ExistingItem.Quantity,
                Unit = ExistingItem.Unit,
                FreezeDate = ExistingItem.FreezeDate,
                ExpiryDate = ExistingItem.ExpiryDate,
                MinimumQuantity = ExistingItem.MinimumQuantity,
                Notes = ExistingItem.Notes
            };
        }
        else
        {
            _model.CompartmentId = DefaultCompartmentId ?? Freezers.FirstOrDefault()?.Compartments.FirstOrDefault()?.Id ?? Guid.Empty;
            _model.FreezeDate = DateTime.UtcNow.Date;
            RecalculateExpiry();
        }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        _model.Category = e.Value?.ToString() ?? "Other";
        RecalculateExpiry();
    }

    private void OnFreezeDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsedDate))
        {
            _model.FreezeDate = parsedDate;
            RecalculateExpiry();
        }
    }

    private void OnExpiryDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsedDate))
        {
            _model.ExpiryDate = parsedDate;
        }
        else
        {
            _model.ExpiryDate = null;
        }
    }

    private void RecalculateExpiry()
    {
        var days = _model.Category switch
        {
            "MeatAndPoultry" => 180,
            "Seafood" => 120,
            "VegetablesAndFruits" => 300,
            "PreparedMeals" => 90,
            "Bakery" => 90,
            "DessertsAndIceCream" => 180,
            _ => 180
        };

        _model.ExpiryDate = _model.FreezeDate.AddDays(days);
    }

    private async Task HandleSaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = L["Freezer.ItemNameRequired"];
            return;
        }

        if (_model.CompartmentId == Guid.Empty)
        {
            _errorMessage = L["Freezer.CompartmentRequired"];
            return;
        }

        if (_model.Quantity <= 0)
        {
            _errorMessage = L["Freezer.QuantityGreaterThanZero"];
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            if (IsEdit)
            {
                var updateReq = new UpdateFreezerItemRequest
                {
                    Id = ExistingItem!.Id,
                    CompartmentId = _model.CompartmentId,
                    Name = _model.Name,
                    Category = _model.Category,
                    Quantity = _model.Quantity,
                    Unit = _model.Unit,
                    FreezeDate = _model.FreezeDate,
                    ExpiryDate = _model.ExpiryDate,
                    MinimumQuantity = _model.MinimumQuantity,
                    Notes = _model.Notes
                };

                var res = await ApiClient.UpdateItemAsync(ExistingItem.Id, updateReq);
                if (res.Success && res.Item != null)
                {
                    await OnSaved.InvokeAsync(res.Item);
                }
                else
                {
                    _errorMessage = res.Error ?? "Failed to update item.";
                }
            }
            else
            {
                var res = await ApiClient.CreateItemAsync(_model);
                if (res.Success && res.Item != null)
                {
                    await OnSaved.InvokeAsync(res.Item);
                }
                else
                {
                    _errorMessage = res.Error ?? "Failed to create item.";
                }
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
