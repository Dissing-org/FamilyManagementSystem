@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject GasApiClient GasApi

<div class="fixed inset-0 z-50 overflow-y-auto flex items-center justify-center p-3 sm:p-4 bg-slate-900/40 backdrop-blur-xs"
     @onclick="Close">
    <div class="relative w-full max-w-lg bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl shadow-xl overflow-hidden flex flex-col max-h-[calc(100dvh-2rem)]"
         @onclick:stopPropagation="true"
         role="dialog"
         aria-modal="true"
         aria-labelledby="gas-pricing-title">
        
        <!-- Pinned Header -->
        <div class="px-5 py-4 sm:px-6 border-b border-slate-100 flex items-center justify-between shrink-0">
            <div>
                <h3 id="gas-pricing-title" class="text-base sm:text-lg font-bold text-slate-900">@L["Gas.Settings.Title"]</h3>
                <p class="text-xs text-slate-500 leading-tight mt-0.5">@L["Gas.Settings.Subtitle"]</p>
            </div>
            <button type="button" @onclick="Close" aria-label="@L["Common.Cancel"]"
                    class="w-10 h-10 min-w-[40px] min-h-[40px] flex items-center justify-center rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Scrollable Form Body -->
        <div class="p-5 sm:p-6 overflow-y-auto flex-1 space-y-4">
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="p-3 rounded-xl text-xs font-semibold @(_isStatusError ? "bg-rose-50 border border-rose-200 text-rose-700" : "bg-emerald-50 border border-emerald-200 text-emerald-800")">
                    @_statusMessage
                </div>
            }

            <!-- Sync OK Button Strip -->
            <div class="bg-amber-50/70 border border-amber-200/70 rounded-xl p-3.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="min-w-0">
                    <span class="text-xs font-bold text-amber-900 block truncate">OK Gas Variabelpris</span>
                    <span class="text-[11px] text-amber-700/80 leading-relaxed block">
                        @if (_settings?.LastSyncedAt.HasValue == true)
                        {
                            @($"{L["Gas.Settings.LastSynced"]}: {L.FormatDate(_settings.LastSyncedAt.Value, "d. MMM yyyy HH:mm")}")
                        }
                        else
                        {
                            <span>@L["Gas.Settings.Disclaimer"]</span>
                        }
                    </span>
                </div>
                <button type="button" @onclick="SyncFromOkAsync" disabled="@_syncing"
                        class="px-3.5 py-2 sm:py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg shadow-xs transition-colors shrink-0 disabled:opacity-50 flex items-center justify-center gap-1.5 min-h-[38px]">
                    @if (_syncing)
                    {
                        <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                        <span>@L["Gas.Settings.Syncing"]</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span>@L["Gas.Settings.SyncNow"]</span>
                    }
                </button>
            </div>

            <!-- Commodity Price -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Settings.CommodityPrice"]</label>
                <div class="relative">
                    <input type="number" step="any" min="0" inputmode="decimal" @bind="_commodityPrice"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white pr-16" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 pointer-events-none">kr./m³</span>
                </div>
            </div>

            <!-- Distribution & Tax Tariff -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Settings.DistributionTax"]</label>
                <div class="relative">
                    <input type="number" step="any" min="0" inputmode="decimal" @bind="_distributionTax"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white pr-16" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 pointer-events-none">kr./m³</span>
                </div>
            </div>

            <!-- Monthly Subscription -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Settings.Subscription"]</label>
                <div class="relative">
                    <input type="number" step="any" min="0" inputmode="decimal" @bind="_monthlySubscription"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white pr-16" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 pointer-events-none">kr./md.</span>
                </div>
            </div>

            <!-- Total Preview -->
            <div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-3">
                <span class="text-xs font-bold text-slate-600">@L["Gas.Settings.TotalRate"]:</span>
                <span class="text-sm sm:text-base font-black text-slate-900">
                    @($"{_commodityPrice + _distributionTax:N2} kr./m³")
                    <span class="text-xs font-medium text-slate-500"> + @($"{_monthlySubscription:N2} kr./md.")</span>
                </span>
            </div>
        </div>

        <!-- Pinned Footer -->
        <div class="px-5 py-3.5 sm:px-6 sm:py-4 bg-slate-50/80 border-t border-slate-100 flex items-center justify-end gap-3 shrink-0">
            <button type="button" @onclick="Close" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 transition-colors min-h-[44px]">
                @L["Common.Cancel"]
            </button>
            <button type="button" @onclick="SaveSettingsAsync" disabled="@_saving"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold rounded-xl shadow-xs transition-colors disabled:opacity-50 min-h-[44px]">
                @if (_saving)
                {
                    <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                    <span>@L["Common.Saving"]</span>
                }
                else
                {
                    <span>@L["Common.Save"]</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private GasPricingSettingsDto? _settings;
    private decimal _commodityPrice;
    private decimal _distributionTax;
    private decimal _monthlySubscription;
    private bool _saving;
    private bool _syncing;
    private string? _statusMessage;
    private bool _isStatusError;

    protected override async Task OnInitializedAsync()
    {
        _settings = await GasApi.GetPricingSettingsAsync();
        if (_settings != null)
        {
            _commodityPrice = _settings.CommodityPricePerM3;
            _distributionTax = _settings.DistributionTaxPerM3;
            _monthlySubscription = _settings.MonthlySubscription;
        }
    }

    private async Task SyncFromOkAsync()
    {
        _syncing = true;
        _statusMessage = null;

        try
        {
            var res = await GasApi.SyncOkPriceAsync();
            if (res != null)
            {
                _settings = res;
                _commodityPrice = res.CommodityPricePerM3;
                _statusMessage = L["Gas.PriceSyncedSuccess"];
                _isStatusError = false;
            }
            else
            {
                _statusMessage = L["Gas.PriceSyncedFailed"];
                _isStatusError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isStatusError = true;
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (_commodityPrice < 0 || _distributionTax < 0 || _monthlySubscription < 0)
        {
            _statusMessage = L["Gas.Settings.ValidationNegative"];
            _isStatusError = true;
            return;
        }

        _saving = true;
        _statusMessage = null;

        try
        {
            var req = new UpdateGasPricingRequest
            {
                CommodityPricePerM3 = _commodityPrice,
                DistributionTaxPerM3 = _distributionTax,
                MonthlySubscription = _monthlySubscription
            };
            var res = await GasApi.UpdatePricingSettingsAsync(req);
            if (res != null)
            {
                await OnSaved.InvokeAsync();
            }
            else
            {
                _statusMessage = L["Gas.Settings.SaveFailed"];
                _isStatusError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isStatusError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
