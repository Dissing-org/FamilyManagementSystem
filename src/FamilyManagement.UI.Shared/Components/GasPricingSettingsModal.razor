@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject GasApiClient GasApi

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-w-lg w-full shadow-xl">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-bold text-slate-900">@L["Gas.Settings.Title"]</h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <p class="text-xs text-slate-500 mb-5 leading-relaxed">@L["Gas.Settings.Subtitle"]</p>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="mb-4 p-3 rounded-xl text-xs font-semibold @(_isStatusError ? "bg-rose-50 border border-rose-200 text-rose-700" : "bg-emerald-50 border border-emerald-200 text-emerald-800")">
                @_statusMessage
            </div>
        }

        <div class="space-y-4">
            <!-- Sync OK Button Strip -->
            <div class="bg-amber-50/70 border border-amber-200/70 rounded-xl p-4 flex items-center justify-between gap-3">
                <div>
                    <span class="text-xs font-bold text-amber-900 block">OK Gas Variabelpris</span>
                    <span class="text-[11px] text-amber-700/80">
                        @if (_settings?.LastSyncedAt.HasValue == true)
                        {
                            @($"{L["Gas.Settings.LastSynced"]}: {L.FormatDate(_settings.LastSyncedAt.Value, "d. MMM yyyy HH:mm")}")
                        }
                        else
                        {
                            <span>@L["Gas.Settings.Disclaimer"]</span>
                        }
                    </span>
                </div>
                <button @onclick="SyncFromOkAsync" disabled="@_syncing"
                        class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg shadow-xs transition-colors shrink-0 disabled:opacity-50 flex items-center gap-1.5">
                    @if (_syncing)
                    {
                        <span class="inline-block animate-spin rounded-full h-3 w-3 border-2 border-white border-t-transparent"></span>
                        <span>@L["Gas.Settings.Syncing"]</span>
                    }
                    else
                    {
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span>@L["Gas.Settings.SyncNow"]</span>
                    }
                </button>
            </div>

            <!-- Commodity Price -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Settings.CommodityPrice"]</label>
                <div class="relative">
                    <input type="number" step="0.01" min="0" @bind="_commodityPrice"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white pr-16" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">kr./m³</span>
                </div>
            </div>

            <!-- Distribution & Tax Tariff -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Settings.DistributionTax"]</label>
                <div class="relative">
                    <input type="number" step="0.01" min="0" @bind="_distributionTax"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white pr-16" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">kr./m³</span>
                </div>
            </div>

            <!-- Monthly Subscription -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Settings.Subscription"]</label>
                <div class="relative">
                    <input type="number" step="0.5" min="0" @bind="_monthlySubscription"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white pr-16" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">kr./md.</span>
                </div>
            </div>

            <!-- Total Preview -->
            <div class="p-3 bg-slate-50 border border-slate-200/80 rounded-xl flex items-center justify-between">
                <span class="text-xs font-bold text-slate-600">@L["Gas.Settings.TotalRate"]:</span>
                <span class="text-base font-black text-slate-900">
                    @($"{_commodityPrice + _distributionTax:N2} kr./m³")
                    <span class="text-xs font-medium text-slate-500"> + @($"{_monthlySubscription:N2} kr./md.")</span>
                </span>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 mt-6">
            <button @onclick="Close" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 transition-colors">
                @L["Common.Cancel"]
            </button>
            <button @onclick="SaveSettingsAsync" disabled="@_saving"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold rounded-xl shadow-xs transition-colors disabled:opacity-50">
                @if (_saving)
                {
                    <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                    <span>@L["Common.Saving"]</span>
                }
                else
                {
                    <span>@L["Common.Save"]</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private GasPricingSettingsDto? _settings;
    private decimal _commodityPrice;
    private decimal _distributionTax;
    private decimal _monthlySubscription;
    private bool _saving;
    private bool _syncing;
    private string? _statusMessage;
    private bool _isStatusError;

    protected override async Task OnInitializedAsync()
    {
        _settings = await GasApi.GetPricingSettingsAsync();
        if (_settings != null)
        {
            _commodityPrice = _settings.CommodityPricePerM3;
            _distributionTax = _settings.DistributionTaxPerM3;
            _monthlySubscription = _settings.MonthlySubscription;
        }
    }

    private async Task SyncFromOkAsync()
    {
        _syncing = true;
        _statusMessage = null;

        try
        {
            var res = await GasApi.SyncOkPriceAsync();
            if (res != null)
            {
                _settings = res;
                _commodityPrice = res.CommodityPricePerM3;
                _statusMessage = L["Gas.PriceSyncedSuccess"];
                _isStatusError = false;
            }
            else
            {
                _statusMessage = L["Gas.PriceSyncedFailed"];
                _isStatusError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isStatusError = true;
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        _statusMessage = null;

        try
        {
            var req = new UpdateGasPricingRequest
            {
                CommodityPricePerM3 = _commodityPrice,
                DistributionTaxPerM3 = _distributionTax,
                MonthlySubscription = _monthlySubscription
            };
            var res = await GasApi.UpdatePricingSettingsAsync(req);
            if (res != null)
            {
                await OnSaved.InvokeAsync();
            }
            else
            {
                _statusMessage = "Kunne ikke gemme indstillingerne.";
                _isStatusError = true;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isStatusError = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
