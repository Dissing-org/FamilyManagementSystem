@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject VehicleApiClient VehicleApi

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">@L["Mileage.Title"]</h3>
            <p class="text-xs text-slate-500">@L["Mileage.Subtitle"]</p>
        </div>
        <button @onclick="OpenLogMileageModal" class="inline-flex items-center gap-2 px-4 py-2 bg-[#C85A32] hover:bg-[#A8431F] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] font-bold text-sm rounded-xl shadow-xs transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>@L["Vehicles.LogMileage"]</span>
        </button>
    </div>

    @if (_loading)
    {
        <div class="py-12 text-center text-slate-400 text-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-[#C85A32] border-t-transparent mb-2"></div>
            <p>@L["Mileage.Loading"]</p>
        </div>
    }
    else if (_logs.Count == 0)
    {
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-[#D9822B]/20 text-[#FEF3E2] dark:text-[#ddd0b2] flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <h4 class="text-base font-bold text-slate-800 dark:text-slate-200">@L["Mileage.EmptyTitle"]</h4>
            <p class="text-sm text-slate-500 mt-1 mb-6">@L["Mileage.EmptySubtitle"]</p>
            <button @onclick="OpenLogMileageModal" class="px-5 py-2.5 bg-[#C85A32] hover:bg-[#A8431F] dark:bg-[#FDEEE9] dark:text-[#7B2F14] text-white text-sm font-semibold rounded-xl shadow-xs">
                @L["Mileage.LogFirst"]
            </button>
        </div>
    }
    else
    {
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl overflow-hidden shadow-xs">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 dark:bg-[#1C1512] text-slate-500 dark:text-slate-400 text-xs uppercase font-bold border-b border-[#EADECF] dark:border-[#3D2F28]">
                        <tr>
                            <th class="px-5 py-3.5">@L["Mileage.TableDate"]</th>
                            <th class="px-5 py-3.5">@L["Mileage.TableReading"]</th>
                            <th class="px-5 py-3.5">@L["Mileage.TableDelta"]</th>
                            <th class="px-5 py-3.5">@L["Mileage.TableNotes"]</th>
                            <th class="px-5 py-3.5 text-right">@L["Mileage.TableActions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#EADECF]/60 dark:divide-[#3D2F28]">
                        @for (var i = 0; i < _logs.Count; i++)
                        {
                            var log = _logs[i];
                            var prevLog = (i + 1 < _logs.Count) ? _logs[i + 1] : null;
                            var delta = prevLog != null ? (log.MileageKm - prevLog.MileageKm) : (int?)null;

                            <tr class="hover:bg-slate-50/50 dark:hover:bg-[#163548]/40 transition-colors">
                                <td class="px-5 py-3.5 font-medium text-slate-900 dark:text-slate-100 whitespace-nowrap">
                                    @L.FormatDate(log.RecordedDate, "d. MMM yyyy")
                                </td>
                                <td class="px-5 py-3.5 font-bold text-slate-800 dark:text-slate-200 whitespace-nowrap font-mono">
                                    @log.MileageKm.ToString("N0", L.Culture) km
                                </td>
                                <td class="px-5 py-3.5 whitespace-nowrap">
                                    @if (delta.HasValue)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs font-semibold @(delta.Value >= 0 ? "text-[#C85A32] dark:text-[#FDEEE9]" : "text-rose-500")">
                                            @(delta.Value >= 0 ? $"+{delta.Value.ToString("N0", L.Culture)} km" : $"{delta.Value.ToString("N0", L.Culture)} km")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400">@L["Mileage.Baseline"]</span>
                                    }
                                </td>
                                <td class="px-5 py-3.5 text-slate-600 dark:text-slate-300">
                                    @(string.IsNullOrWhiteSpace(log.Notes) ? "—" : log.Notes)
                                </td>
                                <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                    <button @onclick="() => DeleteLogAsync(log.Id)" class="p-1.5 text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors" title="@L["Mileage.DeleteEntry"]">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (_showLogModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#261D19] rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] p-6 max-w-md w-full shadow-2xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">@L["Mileage.ModalTitle"]</h3>
                <button @onclick="() => _showLogModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-4 p-3 rounded-xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-900 text-rose-700 dark:text-rose-300 text-xs">
                    @_errorMessage
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">@L["Mileage.TableDate"]</label>
                    <input type="date" @bind="_recordedDate" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-slate-800 dark:text-slate-100" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">@L["Mileage.OdometerReadingKm"]</label>
                    <input type="number" @bind="_mileageKm" min="0" placeholder="@L["Mileage.OdometerPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-slate-800 dark:text-slate-100 font-mono" />
                    @if (CurrentOdometer > 0)
                    {
                        <p class="text-[11px] text-slate-400 mt-1">@L.Format("Mileage.CurrentOdometerFormat", CurrentOdometer.ToString("N0", L.Culture))</p>
                    }
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">@L["Mileage.NotesOptional"]</label>
                    <input @bind="_notes" placeholder="@L["Mileage.NotesPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-slate-800 dark:text-slate-100" />
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showLogModal = false" class="px-4 py-2 text-sm font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">
                    @L["Common.Cancel"]
                </button>
                <button @onclick="SaveMileageAsync" disabled="@_saving" class="px-5 py-2 text-sm font-semibold bg-[#C85A32] hover:bg-[#A8431F] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] rounded-xl shadow-xs transition-colors disabled:opacity-50">
                    @(_saving ? L["Common.Saving"] : L["Mileage.SaveEntry"])
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    [Parameter]
    public int CurrentOdometer { get; set; }

    [Parameter]
    public EventCallback OnMileageUpdated { get; set; }

    private List<MileageLogDto> _logs = new();
    private bool _loading = true;
    private bool _showLogModal = false;
    private bool _saving = false;
    private string? _errorMessage;

    private DateTime _recordedDate = DateTime.Today;
    private int _mileageKm;
    private string? _notes;

    protected override async Task OnParametersSetAsync()
    {
        await LoadLogsAsync();
    }

    public void OpenModal()
    {
        OpenLogMileageModal();
        StateHasChanged();
    }

    private async Task LoadLogsAsync()
    {
        _loading = true;
        _logs = await VehicleApi.GetMileageLogsAsync(VehicleId);
        _loading = false;
    }

    private void OpenLogMileageModal()
    {
        _recordedDate = DateTime.Today;
        _mileageKm = CurrentOdometer > 0 ? CurrentOdometer : 0;
        _notes = null;
        _errorMessage = null;
        _showLogModal = true;
    }

    private async Task SaveMileageAsync()
    {
        if (_mileageKm < 0)
        {
            _errorMessage = L["Mileage.NegativeError"];
            return;
        }

        _saving = true;
        _errorMessage = null;

        var request = new LogMileageRequest
        {
            Id = VehicleId,
            RecordedDate = _recordedDate,
            MileageKm = _mileageKm,
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
        };

        var (success, error, _) = await VehicleApi.LogMileageAsync(VehicleId, request);
        _saving = false;

        if (success)
        {
            _showLogModal = false;
            await LoadLogsAsync();
            await OnMileageUpdated.InvokeAsync();
        }
        else
        {
            _errorMessage = error ?? L["Mileage.SaveError"];
        }
    }

    private async Task DeleteLogAsync(Guid logId)
    {
        var ok = await VehicleApi.DeleteMileageLogAsync(VehicleId, logId);
        if (ok)
        {
            await LoadLogsAsync();
            await OnMileageUpdated.InvokeAsync();
        }
    }
}
