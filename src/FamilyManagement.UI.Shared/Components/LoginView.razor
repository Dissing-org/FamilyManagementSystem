@using FamilyManagement.UI.Shared.Services
@inject IAuthSessionService AuthSession

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col justify-center items-center px-4 py-12 selection:bg-sky-100 selection:text-sky-900 relative">
    <div class="w-full max-w-md relative z-10">
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-sky-600 text-white shadow-md shadow-sky-600/20 mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900">
                @L["App.Title"]
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1.5">
                @L["App.Subtitle"]
            </p>
        </div>

        <!-- Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 sm:p-8 shadow-sm">
            <div class="mb-6">
                <h2 class="text-base font-bold text-slate-900">@L["Login.WorkspaceTitle"]</h2>
                <p class="text-xs text-slate-500 mt-1">
                    @L["Login.WorkspaceSubtitle"]
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200/60 text-xs text-rose-700 font-medium flex items-start gap-2.5">
                    <svg class="w-4 h-4 shrink-0 mt-0.5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault class="space-y-4">
                <div>
                    <label for="login-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                        @L["Login.EmailLabel"]
                    </label>
                    <input id="login-email"
                           type="email"
                           readonly
                           value="@_email"
                           placeholder="demo@familyhub.dk"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-slate-100 border border-slate-200 text-sm text-slate-600 placeholder-slate-400 cursor-not-allowed opacity-80 focus:outline-none transition-all" />
                </div>

                <div>
                    <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                        @L["Login.PasswordLabel"]
                    </label>
                    <input id="login-password"
                           type="password"
                           required
                           @bind="_password"
                           @bind:event="oninput"
                           placeholder="••••••••••••"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 border border-slate-200/80 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
                </div>

                <button type="submit"
                        disabled="@_isSubmitting"
                        class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-sky-600 hover:bg-sky-700 disabled:opacity-50 shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer">
                    @if (_isSubmitting)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                        <span>@L["Login.SigningIn"]</span>
                    }
                    else
                    {
                        <span>@L["Login.SignInButton"]</span>
                    }
                </button>
            </form>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative flex justify-center text-[11px] uppercase tracking-wider font-bold">
                    <span class="px-3 bg-white text-slate-500">@L["Login.SandboxBadge"]</span>
                </div>
            </div>

            <!-- 1-Click Fill Demo Credentials Button -->
            <button type="button"
                    @onclick="FillDemoCredentials"
                    class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200/60 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <span>@L["Login.FillDemoCredentials"]</span>
            </button>

            <p class="text-[11px] text-center text-slate-500 mt-4 leading-relaxed">
                @L["Login.SandboxFooter"]
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnLoginSuccess { get; set; }

    private string _email = "demo@familyhub.dk";
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        _email = ResolveDemoEmail();
    }

    protected override void OnParametersSet()
    {
        _email = ResolveDemoEmail();
    }

    private string ResolveDemoEmail() =>
        string.IsNullOrWhiteSpace(AuthSession.Current.DemoEmailHint)
            ? "demo@familyhub.dk"
            : AuthSession.Current.DemoEmailHint;

    private void FillDemoCredentials()
    {
        _errorMessage = null;
        _email = ResolveDemoEmail();
        _password = string.IsNullOrWhiteSpace(AuthSession.Current.DemoPasswordHint)
            ? "FamilyHubDemo2026!"
            : AuthSession.Current.DemoPasswordHint;
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting) return;

        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var demoEmail = ResolveDemoEmail();
            _email = demoEmail;
            var (success, error) = await AuthSession.LoginAsync(demoEmail, _password);
            if (success)
            {
                await OnLoginSuccess.InvokeAsync();
            }
            else
            {
                _errorMessage = error ?? L["Login.InvalidCredentials"];
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
