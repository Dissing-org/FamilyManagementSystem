@using FamilyManagement.UI.Shared.Services
@inject IAuthSessionService AuthSession

<div class="min-h-screen bg-[#FAF6F0] dark:bg-[#1C1512] text-[#2B1D16] dark:text-[#FAF0E6] font-sans flex flex-col justify-center items-center px-4 py-12 selection:bg-[#FDEEE9] selection:text-[#C85A32] relative overflow-hidden">
    
    <!-- Soft Hearth Ambient Glow -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#C85A32]/10 dark:bg-[#C85A32]/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-[#D9822B]/10 dark:bg-[#D9822B]/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[#C85A32] text-white shadow-lg shadow-[#C85A32]/25 mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-[#2B1D16] dark:text-[#FAF0E6]">
                @L["App.Title"]
            </h1>
            <p class="text-xs sm:text-sm text-[#7F6A5D] dark:text-[#A8988B] mt-1.5">
                @L["App.Subtitle"]
            </p>
        </div>

        <!-- Card -->
        <div class="bg-white/95 dark:bg-[#261D19]/95 backdrop-blur-md rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] ring-1 ring-[#261D19]/[0.03] dark:ring-white/[0.05] p-6 sm:p-8 shadow-sm">
            <div class="mb-6">
                <h2 class="text-base font-bold text-[#2B1D16] dark:text-[#FAF0E6]">@L["Login.WorkspaceTitle"]</h2>
                <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] mt-1">
                    @L["Login.WorkspaceSubtitle"]
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="mb-5 p-3.5 rounded-xl bg-[#FDF2F0] dark:bg-[#3A1D19] border border-[#C85A32]/40 text-xs text-[#9E2A1C] dark:text-[#FCA5A5] font-medium flex items-start gap-2.5">
                    <svg class="w-4 h-4 shrink-0 mt-0.5 text-[#C85A32]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault class="space-y-4">
                <div>
                    <label for="login-email" class="block text-xs font-bold uppercase tracking-wider text-[#7F6A5D] dark:text-[#A8988B] mb-1.5">
                        @L["Login.EmailLabel"]
                    </label>
                    <input id="login-email"
                           type="email"
                           required
                           @bind="_email"
                           @bind:event="oninput"
                           placeholder="demo@familyhub.dk"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] text-sm text-[#2B1D16] dark:text-[#FAF0E6] placeholder-[#7F6A5D]/50 focus:outline-none focus:ring-2 focus:ring-[#C85A32] focus:border-transparent transition-all" />
                </div>

                <div>
                    <label for="login-password" class="block text-xs font-bold uppercase tracking-wider text-[#7F6A5D] dark:text-[#A8988B] mb-1.5">
                        @L["Login.PasswordLabel"]
                    </label>
                    <input id="login-password"
                           type="password"
                           required
                           @bind="_password"
                           @bind:event="oninput"
                           placeholder="••••••••••••"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] text-sm text-[#2B1D16] dark:text-[#FAF0E6] placeholder-[#7F6A5D]/50 focus:outline-none focus:ring-2 focus:ring-[#C85A32] focus:border-transparent transition-all" />
                </div>

                <button type="submit"
                        disabled="@_isSubmitting"
                        class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-white bg-[#C85A32] hover:bg-[#A8431F] disabled:opacity-50 shadow-sm shadow-[#C85A32]/20 transition-all flex items-center justify-center gap-2 cursor-pointer">
                    @if (_isSubmitting)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                        <span>@L["Login.SigningIn"]</span>
                    }
                    else
                    {
                        <span>@L["Login.SignInButton"]</span>
                    }
                </button>
            </form>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-[#EADECF] dark:border-[#3D2F28]"></div>
                </div>
                <div class="relative flex justify-center text-[11px] uppercase tracking-wider font-bold">
                    <span class="px-3 bg-white dark:bg-[#261D19] text-[#7F6A5D] dark:text-[#A8988B]">@L["Login.SandboxBadge"]</span>
                </div>
            </div>

            <!-- 1-Click Fill Demo Credentials Button -->
            <button type="button"
                    @onclick="FillDemoCredentials"
                    class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-[#7F3F15] dark:text-[#FCE4BF] bg-[#FEF3E2] dark:bg-[#382618] hover:bg-[#FCE7C5] dark:hover:bg-[#47301E] border border-[#D9822B]/40 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <span>@L["Login.FillDemoCredentials"]</span>
            </button>

            <p class="text-[11px] text-center text-[#7F6A5D] dark:text-[#A8988B] mt-4 leading-relaxed">
                @L["Login.SandboxFooter"]
            </p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnLoginSuccess { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;

    private void FillDemoCredentials()
    {
        _errorMessage = null;
        _email = string.IsNullOrWhiteSpace(AuthSession.Current.DemoEmailHint)
            ? "demo@familyhub.dk"
            : AuthSession.Current.DemoEmailHint;
        _password = string.IsNullOrWhiteSpace(AuthSession.Current.DemoPasswordHint)
            ? "FamilyHubDemo2026!"
            : AuthSession.Current.DemoPasswordHint;
    }

    private async Task HandleLoginAsync()
    {
        if (_isSubmitting) return;

        _errorMessage = null;
        _isSubmitting = true;

        try
        {
            var (success, error) = await AuthSession.LoginAsync(_email.Trim(), _password);
            if (success)
            {
                await OnLoginSuccess.InvokeAsync();
            }
            else
            {
                _errorMessage = error ?? L["Login.InvalidCredentials"];
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
