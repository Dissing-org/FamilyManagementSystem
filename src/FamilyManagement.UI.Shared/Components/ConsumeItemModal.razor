@using FamilyManagement.UI.Shared.Models

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-fade-in">
    <div class="relative w-full max-w-md bg-white border border-slate-200/80 rounded-3xl shadow-xl overflow-hidden flex flex-col">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center font-bold">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-base font-bold text-slate-900">
                        @L["Freezer.ConsumeTitle"]
                    </h3>
                    <p class="text-xs text-slate-500 truncate max-w-[200px]">
                        @Item.Name (@Item.Quantity @L[$"Freezer.Unit.{Item.Unit}"])
                    </p>
                </div>
            </div>
            <button @onclick="OnClose" class="p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Form Body -->
        <div class="p-6 space-y-4">
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="p-3 rounded-xl bg-rose-50 text-rose-700 border border-rose-200/60 text-xs">
                    @_errorMessage
                </div>
            }

            <!-- Quantity to Consume -->
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="block text-xs font-bold text-slate-700">
                        @L["Freezer.QuantityToConsume"] *
                    </label>
                    <span class="text-xs text-slate-500">
                        @L["Freezer.Available"]: @Item.Quantity @L[$"Freezer.Unit.{Item.Unit}"]
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <input type="number"
                           step="any"
                           min="0.01"
                           max="@Item.Quantity"
                           @bind="_quantity"
                           class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
                    <button type="button"
                            @onclick="() => _quantity = Item.Quantity"
                            class="px-3 py-2 rounded-xl text-xs font-bold bg-slate-50 border border-slate-200/80 text-sky-600 hover:bg-white hover:border-sky-500 transition-all shrink-0">
                        @L["Freezer.ConsumeAll"]
                    </button>
                </div>
            </div>

            <!-- Reason -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Freezer.Reason"] *
                </label>
                <select @bind="_reason"
                        class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all">
                    <option value="Consumed">@L["Freezer.Reason.Consumed"]</option>
                    <option value="DiscardedSpoiled">@L["Freezer.Reason.DiscardedSpoiled"]</option>
                    <option value="GivenAway">@L["Freezer.Reason.GivenAway"]</option>
                    <option value="InventoryCorrection">@L["Freezer.Reason.InventoryCorrection"]</option>
                </select>
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                    @L["Common.Notes"]
                </label>
                <input type="text"
                       @bind="_notes"
                       placeholder="f.eks. Aftensmad, udløbet, givet til nabo"
                       class="w-full px-3.5 py-2 rounded-xl text-sm bg-slate-50 border border-slate-200/80 text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white transition-all" />
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2.5">
            <button @onclick="OnClose"
                    class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:text-slate-800 hover:bg-slate-200/60 transition-colors">
                @L["Common.Cancel"]
            </button>
            <button @onclick="HandleConsumeAsync"
                    disabled="@_isSaving"
                    class="px-5 py-2 rounded-xl text-xs font-bold bg-sky-600 text-white hover:bg-sky-700 shadow-xs disabled:opacity-50 transition-all flex items-center gap-1.5 cursor-pointer">
                @if (_isSaving)
                {
                    <span class="animate-spin h-3.5 w-3.5 border-2 border-white border-t-transparent rounded-full"></span>
                }
                <span>@L["Freezer.ConfirmConsume"]</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public FreezerItemDto Item { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<FreezerItemDto> OnConsumed { get; set; }

    [Inject]
    public FreezerApiClient ApiClient { get; set; } = null!;

    private decimal _quantity = 1;
    private string _reason = "Consumed";
    private string? _notes;
    private bool _isSaving;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        _quantity = Math.Min(1, Item.Quantity);
    }

    private async Task HandleConsumeAsync()
    {
        if (_quantity <= 0)
        {
            _errorMessage = L["Freezer.QuantityGreaterThanZero"];
            return;
        }

        if (_quantity > Item.Quantity)
        {
            _errorMessage = L.Format("Freezer.CannotConsumeMoreThanAvailable", Item.Quantity);
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var req = new ConsumeItemRequest
            {
                Id = Item.Id,
                QuantityToConsume = _quantity,
                Reason = _reason,
                Notes = _notes
            };

            var res = await ApiClient.ConsumeItemAsync(Item.Id, req);
            if (res.Success && res.Item != null)
            {
                await OnConsumed.InvokeAsync(res.Item);
            }
            else
            {
                _errorMessage = res.Error ?? "Failed to consume item.";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
