@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject ChildApiClient ChildApi

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6]">Developmental Roadmap</h3>
            <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B]">Expected milestones by age window (e.g. "at 12 months should be able to walk")</p>
        </div>
        <div class="flex items-center gap-2">
            <button @onclick="SeedGuidelinesAsync" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white dark:bg-[#261D19] hover:bg-[#FAF6F0] dark:hover:bg-[#3D2F28] border border-[#EADECF] dark:border-[#3D2F28] text-[#2B1D16] dark:text-[#FAF0E6] font-bold text-xs rounded-xl shadow-2xs transition-colors">
                <svg class="w-3.5 h-3.5 text-[#C85A32] dark:text-[#FDEEE9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                </svg>
                Load Standard Guidelines
            </button>
            <button @onclick="() => _showAddExpectationModal = true" class="inline-flex items-center gap-2 px-4 py-2 bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] font-bold text-sm rounded-xl shadow-xs transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Target
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="py-12 text-center text-[#7F6A5D] dark:text-[#A8988B] text-sm">Loading developmental roadmap...</div>
    }
    else if (_expectations.Count == 0)
    {
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-[#C85A32]/10 dark:bg-[#FDEEE9]/15 text-[#C85A32] dark:text-[#FDEEE9] flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                </svg>
            </div>
            <h4 class="text-base font-bold text-[#2B1D16] dark:text-[#FAF0E6]">No developmental targets configured</h4>
            <p class="text-sm text-[#7F6A5D] dark:text-[#A8988B] mt-1 mb-6">Load standard WHO/CDC milestones or create your own custom targets.</p>
            <div class="flex justify-center gap-3">
                <button @onclick="SeedGuidelinesAsync" class="px-5 py-2.5 bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:text-[#7B2F14] text-white text-sm font-semibold rounded-xl shadow-xs">
                    Load Standard Guidelines
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Grouped by Age Brackets -->
        <div class="space-y-8">
            @foreach (var group in GroupedByAge)
            {
                <div class="space-y-3">
                    <div class="flex items-center gap-3">
                        <h4 class="text-sm font-black text-[#C85A32] dark:text-[#FDEEE9] uppercase tracking-wider">
                            @group.Key
                        </h4>
                        <div class="flex-1 h-px bg-[#EADECF] dark:bg-[#3D2F28]"></div>
                        <span class="text-xs font-semibold text-[#7F6A5D] dark:text-[#A8988B]">
                            @group.Count(m => m.IsAchieved) / @group.Count() completed
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        @foreach (var m in group)
                        {
                            <div class="bg-white dark:bg-[#261D19] border @(m.IsAchieved ? "border-[#5B7553]/40 dark:border-[#5B7553]/60 bg-[#5B7553]/5 dark:bg-[#5B7553]/10" : "border-[#EADECF] dark:border-[#3D2F28]") rounded-2xl p-4 shadow-2xs flex items-start justify-between gap-3">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold @GetCategoryBadgeColor(m.Category)">
                                            @FormatCategory(m.Category)
                                        </span>
                                        <h5 class="text-sm font-bold @(m.IsAchieved ? "text-[#7F6A5D] line-through dark:text-[#A8988B]" : "text-[#2B1D16] dark:text-[#FAF0E6]")">
                                            @m.Title
                                        </h5>
                                    </div>

                                    @if (!string.IsNullOrEmpty(m.Description))
                                    {
                                        <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] leading-relaxed">
                                            @m.Description
                                        </p>
                                    }

                                    <div class="flex items-center gap-2 pt-1 text-[11px] text-[#7F6A5D] dark:text-[#A8988B]">
                                        <span>Target: ~@m.ExpectedAgeMonths mos</span>
                                        @if (m.ExpectedWindowMaxMonths.HasValue)
                                        {
                                            <span>(up to @m.ExpectedWindowMaxMonths mos)</span>
                                        }
                                        @if (m.IsAchieved && m.AchievedDate.HasValue)
                                        {
                                            <span class="text-[#5B7553] dark:text-[#9BBA93] font-semibold">â€¢ Achieved on @m.AchievedDate.Value.ToString("MMM d, yyyy")</span>
                                        }
                                    </div>
                                </div>

                                <div>
                                    @if (m.IsAchieved)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[#5B7553]/15 text-[#5B7553] dark:bg-[#5B7553]/30 dark:text-[#9BBA93] text-xs font-bold">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                            </svg>
                                            Done
                                        </span>
                                    }
                                    else
                                    {
                                        <button @onclick="() => OpenAchieveModal(m)" class="px-3 py-1.5 bg-[#C85A32]/10 hover:bg-[#C85A32]/20 text-[#C85A32] dark:bg-[#FDEEE9]/15 dark:hover:bg-[#FDEEE9]/25 dark:text-[#FDEEE9] font-bold text-xs rounded-lg transition-colors whitespace-nowrap">
                                            Mark Done
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Mark Done -->
@if (_targetToAchieve != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#261D19] rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] p-6 max-w-sm w-full shadow-2xl">
            <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6] mb-1">Mark Milestone Achieved</h3>
            <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] mb-4 font-semibold">@_targetToAchieve.Title</p>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Date Achieved</label>
                    <input @bind="_achieveDate" type="date" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Memory Note (optional)</label>
                    <textarea @bind="_achieveNote" rows="2" placeholder="e.g. Took 5 steps across the living room!" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _targetToAchieve = null" class="px-4 py-2 text-sm font-semibold text-[#7F6A5D] dark:text-[#EADECF] hover:bg-[#FAF6F0] dark:hover:bg-[#3D2F28]/50 rounded-xl">Cancel</button>
                <button @onclick="ConfirmAchieveAsync" class="px-5 py-2 text-sm font-semibold bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] rounded-xl shadow-xs">Complete</button>
            </div>
        </div>
    </div>
}

<!-- Modal: Add Expectation Target -->
@if (_showAddExpectationModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#261D19] rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] p-6 max-w-md w-full shadow-2xl">
            <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6] mb-4">Add Developmental Target</h3>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Milestone Title</label>
                    <input @bind="_newTitle" placeholder="e.g. Hop on one foot or Count to 10" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Expected Age (Months)</label>
                        <input @bind="_newExpectedMonths" type="number" placeholder="e.g. 12" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Category</label>
                        <select @bind="_newCategory" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]">
                            <option value="GrossMotor">Gross Motor</option>
                            <option value="FineMotor">Fine Motor</option>
                            <option value="LanguageSpeech">Speech & Language</option>
                            <option value="Cognitive">Cognitive</option>
                            <option value="SocialEmotional">Social</option>
                            <option value="Dental">Dental</option>
                            <option value="HealthSelfCare">Self Care</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Guideline Details (optional)</label>
                    <textarea @bind="_newDescription" rows="2" placeholder="e.g. Can walk across room without support" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showAddExpectationModal = false" class="px-4 py-2 text-sm font-semibold text-[#7F6A5D] dark:text-[#EADECF] hover:bg-[#FAF6F0] dark:hover:bg-[#3D2F28]/50 rounded-xl">Cancel</button>
                <button @onclick="SaveExpectationAsync" class="px-5 py-2 text-sm font-semibold bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] rounded-xl shadow-xs">Add Target</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ChildId { get; set; }
    [Parameter] public EventCallback OnExpectationsChanged { get; set; }

    private List<ChildMilestoneModel> _expectations = new();
    private bool _loading = true;

    private ChildMilestoneModel? _targetToAchieve;
    private DateTime _achieveDate = DateTime.Today;
    private string? _achieveNote;

    private bool _showAddExpectationModal;
    private string _newTitle = string.Empty;
    private int _newExpectedMonths = 12;
    private string _newCategory = "GrossMotor";
    private string? _newDescription;

    protected override async Task OnParametersSetAsync()
    {
        await LoadExpectationsAsync();
    }

    private async Task LoadExpectationsAsync()
    {
        _loading = true;
        _expectations = await ChildApi.GetMilestonesAsync(ChildId);
        _loading = false;
    }

    private IEnumerable<IGrouping<string, ChildMilestoneModel>> GroupedByAge =>
        _expectations
            .Where(e => e.ExpectedAgeMonths.HasValue)
            .OrderBy(e => e.ExpectedAgeMonths!.Value)
            .GroupBy(e => FormatAgeBracket(e.ExpectedAgeMonths!.Value));

    private string FormatAgeBracket(int months) => months switch
    {
        <= 3 => "0 â€“ 3 Months (Early Infancy)",
        <= 6 => "4 â€“ 6 Months (Rolling & Babbles)",
        <= 9 => "7 â€“ 9 Months (Sitting & Crawling)",
        <= 12 => "10 â€“ 12 Months (Walking & Words)",
        <= 18 => "13 â€“ 18 Months (Toddler Steps)",
        <= 24 => "19 â€“ 24 Months (2-Word Phrases)",
        <= 36 => "2 â€“ 3 Years (Play & Running)",
        <= 48 => "3 â€“ 4 Years (Preschool Skills)",
        _ => "5+ Years (Early Childhood)"
    };

    private void OpenAchieveModal(ChildMilestoneModel target)
    {
        _targetToAchieve = target;
        _achieveDate = DateTime.Today;
        _achieveNote = null;
    }

    private async Task ConfirmAchieveAsync()
    {
        if (_targetToAchieve == null) return;
        var ok = await ChildApi.MarkMilestoneAchievedAsync(_targetToAchieve.Id, _achieveDate, _achieveNote);
        if (ok)
        {
            _targetToAchieve = null;
            await LoadExpectationsAsync();
            await OnExpectationsChanged.InvokeAsync();
        }
    }

    private async Task SaveExpectationAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle)) return;
        var result = await ChildApi.CreateMilestoneAsync(
            ChildId,
            _newTitle,
            _newCategory,
            isAchieved: false,
            expectedAgeMonths: _newExpectedMonths,
            expectedWindowMaxMonths: null,
            achievedDate: null,
            description: _newDescription,
            notes: null,
            photoUrl: null);

        if (result != null)
        {
            _showAddExpectationModal = false;
            _newTitle = string.Empty;
            _newDescription = null;
            await LoadExpectationsAsync();
            await OnExpectationsChanged.InvokeAsync();
        }
    }

    private async Task SeedGuidelinesAsync()
    {
        await ChildApi.SeedStandardMilestonesAsync(ChildId);
        await LoadExpectationsAsync();
        await OnExpectationsChanged.InvokeAsync();
    }

    private string FormatCategory(string cat) => cat switch
    {
        "GrossMotor" => "Motor",
        "FineMotor" => "Fine Motor",
        "LanguageSpeech" => "Speech",
        "Cognitive" => "Cognitive",
        "SocialEmotional" => "Social",
        "Dental" => "Dental",
        "HealthSelfCare" => "Self Care",
        _ => cat
    };

    private string GetCategoryBadgeColor(string cat) => cat switch
    {
        "GrossMotor" => "bg-[#C85A32]/15 text-[#C85A32] dark:bg-[#C85A32]/30 dark:text-[#FDEEE9]",
        "FineMotor" => "bg-[#D9822B]/15 text-[#8F4E0E] dark:bg-[#D9822B]/25 dark:text-[#F4C596]",
        "LanguageSpeech" => "bg-[#5B7553]/15 text-[#5B7553] dark:bg-[#5B7553]/30 dark:text-[#9BBA93]",
        "Dental" => "bg-[#FAF0E6] text-[#7B2F14] dark:bg-[#3D2F28] dark:text-[#EADECF]",
        "SocialEmotional" => "bg-[#FDEEE9] text-[#7B2F14] dark:bg-[#3D2F28] dark:text-[#FDEEE9]",
        _ => "bg-[#FAF6F0] text-[#7F6A5D] dark:bg-[#1C1512] dark:text-[#EADECF]"
    };
}