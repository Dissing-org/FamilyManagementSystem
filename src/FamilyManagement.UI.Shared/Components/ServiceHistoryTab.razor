@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject VehicleApiClient VehicleApi
@inject IReceiptApiClient ReceiptApi

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h3 class="text-lg font-bold text-slate-900">@L["Service.Title"]</h3>
            <p class="text-xs text-slate-500">@L["Service.Subtitle"]</p>
        </div>
        <button @onclick="OpenRecordServiceModal" class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm rounded-xl shadow-xs transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>@L["Vehicles.RecordService"]</span>
        </button>
    </div>

    @if (_loading)
    {
        <div class="py-12 text-center text-slate-500 text-sm">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-sky-600 border-t-transparent mb-2"></div>
            <p>@L["Service.Loading"]</p>
        </div>
    }
    else if (_records.Count == 0)
    {
        <div class="bg-white border border-slate-200/80 rounded-2xl p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-sky-50 text-sky-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
            </div>
            <h4 class="text-base font-bold text-slate-800">@L["Service.EmptyTitle"]</h4>
            <p class="text-sm text-slate-500 mt-1 mb-6">@L["Service.EmptySubtitle"]</p>
            <button @onclick="OpenRecordServiceModal" class="px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold rounded-xl shadow-xs">
                @L["Service.RecordFirst"]
            </button>
        </div>
    }
    else
    {
        <!-- Filter Tabs -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
            <button @onclick='() => _selectedFilter = null' class="px-3 py-1.5 rounded-lg font-bold transition-colors @(_selectedFilter == null ? "bg-sky-600 text-white shadow-xs font-bold" : "bg-white text-slate-600 border border-slate-200/80 hover:border-sky-500 hover:text-sky-700")">
                @L["Common.All"] (@_records.Count)
            </button>
            @foreach (var type in ServiceTypes)
            {
                var count = _records.Count(r => r.Type == type);
                if (count > 0)
                {
                    <button @onclick='() => _selectedFilter = type' class="px-3 py-1.5 rounded-lg font-bold transition-colors @(_selectedFilter == type ? "bg-sky-600 text-white shadow-xs font-bold" : "bg-white text-slate-600 border border-slate-200/80 hover:border-sky-500 hover:text-sky-700")">
                        @L.ServiceType(type) (@count)
                    </button>
                }
            }
        </div>

        <!-- Service Cards Stream -->
        <div class="space-y-3">
            @foreach (var record in FilteredRecords)
            {
                <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs transition-shadow hover:shadow-md">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                        <div class="flex items-start gap-3">
                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold @GetServiceTypeBadgeClass(record.Type) whitespace-nowrap">
                                @L.ServiceType(record.Type)
                            </span>
                            <div>
                                <h4 class="text-base font-bold text-slate-900">
                                    @record.Title
                                </h4>
                                <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-slate-500">
                                    <span class="font-medium">@L.FormatDate(record.ServiceDate, "d. MMM yyyy")</span>
                                    <span>•</span>
                                    <span class="font-mono font-semibold">@record.MileageKm.ToString("N0", L.Culture) km</span>
                                    @if (!string.IsNullOrWhiteSpace(record.Workshop))
                                    {
                                        <span>•</span>
                                        <span class="inline-flex items-center gap-1 text-slate-700 font-medium">
                                            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                            </svg>
                                            @record.Workshop
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center sm:flex-col sm:items-end justify-between gap-1">
                            @if (record.Cost.HasValue)
                            {
                                <div class="text-base font-black text-slate-900">
                                    @record.Cost.Value.ToString("N0", L.Culture) <span class="text-xs font-semibold text-slate-500">kr.</span>
                                </div>
                            }

                            <div class="flex items-center gap-2 mt-1">
                                @if (record.ReceiptId.HasValue)
                                {
                                    <a href="receipts" class="inline-flex items-center gap-1 text-[11px] font-bold text-sky-600 bg-sky-50 hover:bg-sky-100 px-2 py-0.5 rounded-md transition-colors" title="@L["Service.ViewInReceipts"]">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                        @L["Service.Receipt"]
                                    </a>
                                }

                                <button @onclick="() => DeleteRecordAsync(record.Id)" class="p-1 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors" title="@L["Service.DeleteRecord"]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(record.Notes))
                    {
                        <p class="text-sm text-slate-600 mt-3 pt-3 border-t border-slate-100 whitespace-pre-wrap">
                            @record.Notes
                        </p>
                    }
                </div>
            }
        </div>
    }
</div>

@if (_showRecordModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-w-lg w-full shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-slate-900">@L["Service.ModalTitle"]</h3>
                <button @onclick="() => _showRecordModal = false" class="text-slate-400 hover:text-slate-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-4 p-3 rounded-xl bg-rose-50 border border-rose-200/60 text-rose-700 text-xs">
                    @_errorMessage
                </div>
            }

            <div class="space-y-4 max-h-[70vh] overflow-y-auto pr-1">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.ServiceType"]</label>
                        <select @bind="_newType" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white">
                            @foreach (var type in ServiceTypes)
                            {
                                <option value="@type">@L.ServiceType(type)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.ServiceDate"]</label>
                        <input type="date" @bind="_newDate" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.TitleDescription"]</label>
                    <input @bind="_newTitle" placeholder="@L["Service.TitlePlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.OdometerKm"]</label>
                        <input type="number" @bind="_newMileage" min="0" placeholder="@L["Service.OdometerPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.CostDkk"]</label>
                        <input type="number" step="0.01" @bind="_newCost" min="0" placeholder="@L["Service.CostPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.WorkshopOptional"]</label>
                    <input @bind="_newWorkshop" placeholder="@L["Service.WorkshopPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.LinkToReceiptOptional"]</label>
                    <select @bind="_newReceiptId" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white">
                        <option value="">@L["Service.NoLinkedReceipt"]</option>
                        @foreach (var receipt in _availableReceipts)
                        {
                            <option value="@receipt.Id">@receipt.Merchant - @receipt.PurchaseDate.ToString("yyyy-MM-dd") (@receipt.FileName)</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Service.NotesOptional"]</label>
                    <textarea @bind="_newNotes" rows="3" placeholder="@L["Service.NotesPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showRecordModal = false" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">
                    @L["Common.Cancel"]
                </button>
                <button @onclick="SaveServiceRecordAsync" disabled="@_saving" class="px-5 py-2 text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-xs transition-colors disabled:opacity-50">
                    @(_saving ? L["Common.Saving"] : L["Service.SaveRecord"])
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Guid VehicleId { get; set; }

    [Parameter]
    public int CurrentOdometer { get; set; }

    [Parameter]
    public EventCallback OnServiceRecorded { get; set; }

    private List<VehicleServiceRecordDto> _records = new();
    private List<ReceiptViewModel> _availableReceipts = new();
    private bool _loading = true;
    private bool _showRecordModal = false;
    private bool _saving = false;
    private string? _errorMessage;
    private string? _selectedFilter;

    private static readonly string[] ServiceTypes = new[]
    {
        "RegularService",
        "OilChange",
        "InspectionSyn",
        "TireChange",
        "BrakeService",
        "Repair",
        "Other"
    };

    private string _newType = "RegularService";
    private DateTime _newDate = DateTime.Today;
    private string _newTitle = string.Empty;
    private int _newMileage;
    private decimal? _newCost;
    private string? _newWorkshop;
    private string? _newNotes;
    private string? _newReceiptId;

    private IEnumerable<VehicleServiceRecordDto> FilteredRecords =>
        string.IsNullOrEmpty(_selectedFilter)
            ? _records
            : _records.Where(r => r.Type == _selectedFilter);

    protected override async Task OnParametersSetAsync()
    {
        await LoadRecordsAsync();
    }

    public void OpenModal()
    {
        OpenRecordServiceModal();
        StateHasChanged();
    }

    private async Task LoadRecordsAsync()
    {
        _loading = true;
        _records = await VehicleApi.GetServiceRecordsAsync(VehicleId);
        try
        {
            _availableReceipts = await ReceiptApi.GetReceiptsAsync();
        }
        catch
        {
            _availableReceipts = new();
        }
        _loading = false;
    }

    private void OpenRecordServiceModal()
    {
        _newType = "RegularService";
        _newDate = DateTime.Today;
        _newTitle = string.Empty;
        _newMileage = CurrentOdometer > 0 ? CurrentOdometer : 0;
        _newCost = null;
        _newWorkshop = null;
        _newNotes = null;
        _newReceiptId = null;
        _errorMessage = null;
        _showRecordModal = true;
    }

    private async Task SaveServiceRecordAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
        {
            _errorMessage = L["Service.TitleRequiredError"];
            return;
        }

        if (_newMileage < 0)
        {
            _errorMessage = L["Mileage.NegativeError"];
            return;
        }

        _saving = true;
        _errorMessage = null;

        Guid? parsedReceiptId = Guid.TryParse(_newReceiptId, out var rId) ? rId : null;

        var request = new RecordVehicleServiceRequest
        {
            Id = VehicleId,
            ServiceDate = _newDate,
            MileageKm = _newMileage,
            Type = _newType,
            Title = _newTitle.Trim(),
            Workshop = string.IsNullOrWhiteSpace(_newWorkshop) ? null : _newWorkshop.Trim(),
            Cost = _newCost,
            Notes = string.IsNullOrWhiteSpace(_newNotes) ? null : _newNotes.Trim(),
            ReceiptId = parsedReceiptId
        };

        var (success, error, _) = await VehicleApi.RecordServiceAsync(VehicleId, request);
        _saving = false;

        if (success)
        {
            _showRecordModal = false;
            await LoadRecordsAsync();
            await OnServiceRecorded.InvokeAsync();
        }
        else
        {
            _errorMessage = error ?? L["Service.SaveError"];
        }
    }

    private async Task DeleteRecordAsync(Guid serviceId)
    {
        var ok = await VehicleApi.DeleteServiceRecordAsync(VehicleId, serviceId);
        if (ok)
        {
            await LoadRecordsAsync();
            await OnServiceRecorded.InvokeAsync();
        }
    }

    private static string GetServiceTypeBadgeClass(string type) => type switch
    {
        "RegularService" => "bg-blue-100 text-blue-800",
        "OilChange" => "bg-amber-100 text-amber-800",
        "InspectionSyn" => "bg-purple-100 text-purple-800",
        "TireChange" => "bg-slate-200 text-slate-800",
        "BrakeService" => "bg-rose-100 text-rose-800",
        "Repair" => "bg-orange-100 text-orange-800",
        _ => "bg-emerald-100 text-emerald-800"
    };
}
