@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject GasApiClient GasApi

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
    <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-w-md w-full shadow-xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-900">
                @(ReadingToEdit != null ? L["Gas.Modal.EditTitle"] : L["Gas.Modal.LogTitle"])
            </h3>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-xl">
                @_errorMessage
            </div>
        }

        <div class="space-y-4">
            <!-- Date -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Modal.ReadingDate"]</label>
                <input type="date" @bind="_date" max="@DateTime.Now.ToString("yyyy-MM-dd")"
                       class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 focus:bg-white" />
            </div>

            <!-- Reading M3 -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Modal.ReadingM3"]</label>
                <div class="relative">
                    <input type="number" step="0.01" min="0" @bind="_readingM3" placeholder="@L["Gas.Modal.ReadingM3Placeholder"]"
                           class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 focus:bg-white pr-12" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">m³</span>
                </div>
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Modal.Notes"]</label>
                <input type="text" @bind="_notes" placeholder="@L["Gas.Modal.NotesPlaceholder"]"
                       class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 focus:bg-white" />
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 mt-6">
            <button @onclick="Close" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 transition-colors">
                @L["Common.Cancel"]
            </button>
            <button @onclick="SaveAsync" disabled="@_saving"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-bold rounded-xl shadow-xs transition-colors disabled:opacity-50">
                @if (_saving)
                {
                    <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                    <span>@L["Common.Saving"]</span>
                }
                else
                {
                    <span>@L["Common.Save"]</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public GasReadingDto? ReadingToEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DateTime _date = DateTime.Now.Date;
    private decimal _readingM3;
    private string? _notes;
    private bool _saving;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (ReadingToEdit != null)
        {
            _date = ReadingToEdit.RecordedDate.Date;
            _readingM3 = ReadingToEdit.ReadingM3;
            _notes = ReadingToEdit.Notes;
        }
    }

    private async Task SaveAsync()
    {
        if (_readingM3 < 0)
        {
            _errorMessage = "Målerstand kan ikke være negativ.";
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            if (ReadingToEdit != null)
            {
                var req = new UpdateGasReadingRequest
                {
                    Id = ReadingToEdit.Id,
                    RecordedDate = _date,
                    ReadingM3 = _readingM3,
                    Notes = _notes
                };
                var res = await GasApi.UpdateReadingAsync(req);
                if (res != null)
                {
                    await OnSaved.InvokeAsync();
                }
                else
                {
                    _errorMessage = "Kunne ikke opdatere målerstanden. Prøv igen.";
                }
            }
            else
            {
                var req = new LogGasReadingRequest
                {
                    RecordedDate = _date,
                    ReadingM3 = _readingM3,
                    Notes = _notes
                };
                var res = await GasApi.LogReadingAsync(req);
                if (res != null)
                {
                    await OnSaved.InvokeAsync();
                }
                else
                {
                    _errorMessage = "Kunne ikke gemme målerstanden. Prøv igen.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
