@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject GasApiClient GasApi

<div class="fixed inset-0 z-50 overflow-y-auto flex items-center justify-center p-3 sm:p-4 bg-slate-900/40 backdrop-blur-xs"
     @onclick="Close">
    <div class="relative w-full max-w-md bg-white border border-slate-200/80 rounded-2xl sm:rounded-3xl shadow-xl overflow-hidden flex flex-col max-h-[calc(100dvh-2rem)]"
         @onclick:stopPropagation="true"
         role="dialog"
         aria-modal="true"
         aria-labelledby="gas-log-title">
        
        <!-- Pinned Header -->
        <div class="px-5 py-4 sm:px-6 border-b border-slate-100 flex items-center justify-between shrink-0">
            <h3 id="gas-log-title" class="text-base sm:text-lg font-bold text-slate-900">
                @(ReadingToEdit != null ? L["Gas.Modal.EditTitle"] : L["Gas.Modal.LogTitle"])
            </h3>
            <button type="button" @onclick="Close" aria-label="@L["Common.Cancel"]"
                    class="w-10 h-10 min-w-[40px] min-h-[40px] flex items-center justify-center rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Scrollable Form Body -->
        <div class="p-5 sm:p-6 overflow-y-auto flex-1 space-y-4">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold rounded-xl">
                    @_errorMessage
                </div>
            }

            <!-- Date -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Modal.ReadingDate"]</label>
                <input type="date" @bind="_date" max="@DateTime.Now.ToString("yyyy-MM-dd")"
                       class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 focus:bg-white" />
            </div>

            <!-- Reading M3 -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Modal.ReadingM3"]</label>
                <div class="relative">
                    <input type="number" step="any" min="0" inputmode="decimal" @bind="_readingM3" placeholder="@L["Gas.Modal.ReadingM3Placeholder"]"
                           class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 focus:bg-white pr-12" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 pointer-events-none">m³</span>
                </div>
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Gas.Modal.Notes"]</label>
                <input type="text" @bind="_notes" placeholder="@L["Gas.Modal.NotesPlaceholder"]"
                       class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 focus:bg-white" />
            </div>
        </div>

        <!-- Pinned Footer -->
        <div class="px-5 py-3.5 sm:px-6 sm:py-4 bg-slate-50/80 border-t border-slate-100 flex items-center justify-end gap-3 shrink-0">
            <button type="button" @onclick="Close" class="px-4 py-2 text-sm font-semibold text-slate-600 hover:text-slate-800 transition-colors min-h-[44px]">
                @L["Common.Cancel"]
            </button>
            <button type="button" @onclick="SaveAsync" disabled="@_saving"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-bold rounded-xl shadow-xs transition-colors disabled:opacity-50 min-h-[44px]">
                @if (_saving)
                {
                    <span class="inline-block animate-spin rounded-full h-3.5 w-3.5 border-2 border-white border-t-transparent"></span>
                    <span>@L["Common.Saving"]</span>
                }
                else
                {
                    <span>@L["Common.Save"]</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public GasReadingDto? ReadingToEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DateTime _date = DateTime.Now.Date;
    private decimal _readingM3;
    private string? _notes;
    private bool _saving;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (ReadingToEdit != null)
        {
            _date = ReadingToEdit.RecordedDate.Date;
            _readingM3 = ReadingToEdit.ReadingM3;
            _notes = ReadingToEdit.Notes;
        }
    }

    private async Task SaveAsync()
    {
        if (_readingM3 < 0)
        {
            _errorMessage = L["Gas.Modal.ReadingNegative"];
            return;
        }

        _saving = true;
        _errorMessage = null;

        try
        {
            if (ReadingToEdit != null)
            {
                var req = new UpdateGasReadingRequest
                {
                    Id = ReadingToEdit.Id,
                    RecordedDate = _date,
                    ReadingM3 = _readingM3,
                    Notes = _notes
                };
                var res = await GasApi.UpdateReadingAsync(req);
                if (res != null)
                {
                    await OnSaved.InvokeAsync();
                }
                else
                {
                    _errorMessage = L["Gas.Modal.UpdateFailed"];
                }
            }
            else
            {
                var req = new LogGasReadingRequest
                {
                    RecordedDate = _date,
                    ReadingM3 = _readingM3,
                    Notes = _notes
                };
                var res = await GasApi.LogReadingAsync(req);
                if (res != null)
                {
                    await OnSaved.InvokeAsync();
                }
                else
                {
                    _errorMessage = L["Gas.Modal.SaveFailed"];
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}
