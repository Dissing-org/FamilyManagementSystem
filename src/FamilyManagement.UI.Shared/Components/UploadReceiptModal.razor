@using Microsoft.AspNetCore.Components.Forms
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#1b1c36] rounded-2xl shadow-xl border border-[#ebdcd0] dark:border-[#2c2f57] max-w-lg w-full p-6 text-slate-900 dark:text-slate-100">
        <!-- Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[#ebdcd0] dark:border-[#2c2f57]">
            <h2 class="text-xl font-bold flex items-center gap-2">
                <svg class="w-6 h-6 text-[#4d52de] dark:text-[#a7abf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Upload Purchase Receipt
            </h2>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mt-4 p-3 bg-rose-50 dark:bg-rose-900/40 border border-rose-200 dark:border-rose-800 rounded-xl text-rose-700 dark:text-rose-300 text-sm">
                @_errorMessage
            </div>
        }

        <div class="mt-4 space-y-4">
            <!-- File Picker -->
            <div>
                <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Receipt Document or Photo *</label>
                <div class="border-2 border-dashed border-[#ebdcd0] dark:border-[#2c2f57] rounded-xl p-4 text-center hover:border-[#4d52de] transition-colors">
                    <InputFile OnChange="HandleFileSelected" accept="image/*,application/pdf" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-[#4d52de]/10 file:text-[#4d52de] dark:file:bg-[#4d52de]/20 dark:file:text-[#a7abf8] hover:file:bg-[#4d52de]/20" />
                    @if (!string.IsNullOrEmpty(_model.FileName))
                    {
                        <p class="text-xs text-[#4d52de] dark:text-[#a7abf8] font-medium mt-2">
                            Selected: @_model.FileName (@(_model.FileBytes?.Length / 1024 ?? 0) KB)
                        </p>
                    }
                </div>
            </div>

            <!-- Merchant & Category -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Merchant / Store *</label>
                    <input @bind="_model.Merchant" list="modal-merchants" type="text" placeholder="e.g. Costco, Target" required autocomplete="off"
                           class="w-full px-3 py-2 bg-[#faf7f2] dark:bg-[#131427] border border-[#ebdcd0] dark:border-[#2c2f57] rounded-lg focus:ring-2 focus:ring-[#4d52de] focus:outline-none text-slate-900 dark:text-slate-100" />
                    <datalist id="modal-merchants">
                        @foreach (var m in _merchants)
                        {
                            <option value="@m">@m</option>
                        }
                    </datalist>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Category</label>
                    <select @bind="_model.Category" 
                            class="w-full px-3 py-2 bg-[#faf7f2] dark:bg-[#131427] border border-[#ebdcd0] dark:border-[#2c2f57] rounded-lg focus:ring-2 focus:ring-[#4d52de] focus:outline-none text-slate-900 dark:text-slate-100">
                        @foreach (var cat in ReceiptCategories.All)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Date -->
            <div>
                <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Purchase Date</label>
                <input @bind="_model.PurchaseDate" type="date"
                       class="w-full px-3 py-2 bg-[#faf7f2] dark:bg-[#131427] border border-[#ebdcd0] dark:border-[#2c2f57] rounded-lg focus:ring-2 focus:ring-[#4d52de] focus:outline-none text-slate-900 dark:text-slate-100" />
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-sm font-semibold mb-1 text-slate-700 dark:text-slate-300">Notes (Optional)</label>
                <textarea @bind="_model.Notes" rows="2" placeholder="e.g. Weekly family dinner items"
                          class="w-full px-3 py-2 bg-[#faf7f2] dark:bg-[#131427] border border-[#ebdcd0] dark:border-[#2c2f57] rounded-lg focus:ring-2 focus:ring-[#4d52de] focus:outline-none text-slate-900 dark:text-slate-100"></textarea>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-[#ebdcd0] dark:border-[#2c2f57]">
            <button @onclick="Close" disabled="@_isSubmitting"
                    class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                Cancel
            </button>
            <button @onclick="SubmitAsync" disabled="@_isSubmitting"
                    class="px-5 py-2 text-sm font-semibold text-white bg-[#4d52de] hover:bg-[#3d41c4] rounded-lg shadow-sm transition-colors flex items-center gap-2 disabled:opacity-50">
                @if (_isSubmitting)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                    <span>Archiving...</span>
                }
                else
                {
                    <span>Save & Archive</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Inject]
    public IReceiptApiClient ApiClient { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<ReceiptViewModel> OnReceiptUploaded { get; set; }

    [Parameter]
    public IReadOnlyList<string>? ExistingMerchants { get; set; }

    private List<string> _merchants = new();
    private UploadReceiptModel _model = new();
    private bool _isSubmitting = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (ExistingMerchants != null && ExistingMerchants.Count > 0)
        {
            _merchants = ExistingMerchants.ToList();
        }
        else
        {
            try
            {
                _merchants = await ApiClient.GetMerchantsAsync();
            }
            catch
            {
                _merchants = new();
            }
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is not null)
        {
            _model.FileName = file.Name;
            _model.ContentType = file.ContentType;

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(memoryStream);
            _model.FileBytes = memoryStream.ToArray();
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Merchant))
        {
            _errorMessage = "Merchant is required.";
            return;
        }

        if (_model.FileBytes is null || _model.FileBytes.Length == 0)
        {
            _errorMessage = "Please choose a receipt file or image.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var created = await ApiClient.UploadReceiptAsync(_model);
            if (!string.IsNullOrWhiteSpace(created.Merchant) && !_merchants.Any(m => string.Equals(m, created.Merchant.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                _merchants.Add(created.Merchant.Trim());
                _merchants.Sort(StringComparer.OrdinalIgnoreCase);
            }
            await OnReceiptUploaded.InvokeAsync(created);
            await Close();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
