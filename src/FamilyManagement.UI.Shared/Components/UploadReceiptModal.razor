@using Microsoft.AspNetCore.Components.Forms
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/30 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 max-w-lg w-full p-6 text-slate-900">
        <!-- Header -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <h2 class="text-xl font-bold flex items-center gap-2 text-slate-900">
                <svg class="w-6 h-6 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                @L["Receipts.Modal.Title"]
            </h2>
            <button @onclick="Close" class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mt-4 p-3 bg-rose-50 border border-rose-200/60 rounded-xl text-rose-700 text-sm">
                @_errorMessage
            </div>
        }

        <div class="mt-4 space-y-4">
            <!-- File Picker -->
            <div>
                <label class="block text-sm font-semibold mb-1 text-slate-700">@L["Receipts.Modal.FileLabel"]</label>
                <div class="border-2 border-dashed border-slate-300 hover:border-sky-500 bg-slate-50/50 rounded-xl p-4 text-center transition-colors">
                    <InputFile OnChange="HandleFileSelected" accept="image/*,application/pdf" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100" />
                    @if (!string.IsNullOrEmpty(_model.FileName))
                    {
                        <p class="text-xs text-sky-700 font-medium mt-2">
                            @L.Format("Receipts.Modal.SelectedFile", _model.FileName, _model.FileBytes?.Length / 1024 ?? 0)
                        </p>
                    }
                </div>
            </div>

            <!-- Merchant & Category -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold mb-1 text-slate-700">@L["Receipts.Modal.MerchantLabel"]</label>
                    <input @bind="_model.Merchant" list="modal-merchants" type="text" placeholder="@L["Receipts.Modal.MerchantPlaceholder"]" required autocomplete="off"
                           class="w-full px-3 py-2 bg-slate-50 border border-slate-200/80 rounded-xl focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:outline-none focus:bg-white text-sm text-slate-900" />
                    <datalist id="modal-merchants">
                        @foreach (var m in _merchants)
                        {
                            <option value="@m">@m</option>
                        }
                    </datalist>
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-1 text-slate-700">@L["Common.Category"]</label>
                    <select @bind="_model.Category" 
                            class="w-full px-3 py-2 bg-slate-50 border border-slate-200/80 rounded-xl focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:outline-none focus:bg-white text-sm text-slate-900">
                        @foreach (var cat in ReceiptCategories.All)
                        {
                            <option value="@cat">@L.Category(cat)</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Date -->
            <div>
                <label class="block text-sm font-semibold mb-1 text-slate-700">@L["Receipts.Modal.PurchaseDateLabel"]</label>
                <input @bind="_model.PurchaseDate" type="date"
                       class="w-full px-3 py-2 bg-slate-50 border border-slate-200/80 rounded-xl focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:outline-none focus:bg-white text-sm text-slate-900" />
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-sm font-semibold mb-1 text-slate-700">@L["Common.NotesOptional"]</label>
                <textarea @bind="_model.Notes" rows="2" placeholder="@L["Receipts.Modal.NotesPlaceholder"]"
                          class="w-full px-3 py-2 bg-slate-50 border border-slate-200/80 rounded-xl focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:outline-none focus:bg-white text-sm text-slate-900"></textarea>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-6 flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button @onclick="Close" disabled="@_isSubmitting"
                    class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">
                @L["Common.Cancel"]
            </button>
            <button @onclick="SubmitAsync" disabled="@_isSubmitting"
                    class="px-5 py-2 text-sm font-semibold text-white bg-sky-600 hover:bg-sky-700 rounded-xl shadow-xs transition-colors flex items-center gap-2 disabled:opacity-50">
                @if (_isSubmitting)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                    <span>@L["Receipts.Modal.Archiving"]</span>
                }
                else
                {
                    <span>@L["Receipts.Modal.SaveAndArchive"]</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Inject]
    public IReceiptApiClient ApiClient { get; set; } = null!;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<ReceiptViewModel> OnReceiptUploaded { get; set; }

    [Parameter]
    public IReadOnlyList<string>? ExistingMerchants { get; set; }

    private List<string> _merchants = new();
    private UploadReceiptModel _model = new();
    private bool _isSubmitting = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (ExistingMerchants != null && ExistingMerchants.Count > 0)
        {
            _merchants = ExistingMerchants.ToList();
        }
        else
        {
            try
            {
                _merchants = await ApiClient.GetMerchantsAsync();
            }
            catch
            {
                _merchants = new();
            }
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is not null)
        {
            _model.FileName = file.Name;
            _model.ContentType = file.ContentType;

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024).CopyToAsync(memoryStream);
            _model.FileBytes = memoryStream.ToArray();
        }
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Merchant))
        {
            _errorMessage = L["Receipts.Validation.MerchantRequired"];
            return;
        }

        if (_model.FileBytes is null || _model.FileBytes.Length == 0)
        {
            _errorMessage = L["Receipts.Validation.FileRequired"];
            return;
        }

        _isSubmitting = true;
        try
        {
            var created = await ApiClient.UploadReceiptAsync(_model);
            if (!string.IsNullOrWhiteSpace(created.Merchant) && !_merchants.Any(m => string.Equals(m, created.Merchant.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                _merchants.Add(created.Merchant.Trim());
                _merchants.Sort(StringComparer.OrdinalIgnoreCase);
            }
            await OnReceiptUploaded.InvokeAsync(created);
            await Close();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
