@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject ChildApiClient ChildApi

<div class="space-y-6">
    <!-- Quick Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Height Card -->
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-[#7F6A5D] dark:text-[#A8988B] uppercase tracking-wider">Height</span>
                <span class="w-8 h-8 rounded-lg bg-[#C85A32]/10 text-[#C85A32] dark:bg-[#FDEEE9]/15 dark:text-[#FDEEE9] flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10M12 3v18m0-18l-3 3m3-3l3 3"/>
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-[#2B1D16] dark:text-[#FAF0E6]">
                    @(EffectiveHeightMeasurement?.HeightCm.HasValue == true ? $"{EffectiveHeightMeasurement.HeightCm:N1}" : "â€”")
                </span>
                <span class="text-sm font-semibold text-[#7F6A5D]">cm</span>
            </div>
            <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] mt-1">
                @(EffectiveHeightMeasurement?.HeightCm.HasValue == true ? $"Recorded on {EffectiveHeightMeasurement.RecordedDate:MMM d, yyyy}" : "No records yet")
            </p>
        </div>

        <!-- Weight Card -->
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-[#7F6A5D] dark:text-[#A8988B] uppercase tracking-wider">Weight</span>
                <span class="w-8 h-8 rounded-lg bg-[#D9822B]/15 text-[#8F4E0E] dark:bg-[#D9822B]/25 dark:text-[#F4C596] flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-[#2B1D16] dark:text-[#FAF0E6]">
                    @(EffectiveWeightMeasurement?.WeightKg.HasValue == true ? $"{EffectiveWeightMeasurement.WeightKg:N2}" : "â€”")
                </span>
                <span class="text-sm font-semibold text-[#7F6A5D]">kg</span>
            </div>
            <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] mt-1">
                @(EffectiveWeightMeasurement?.WeightKg.HasValue == true ? $"Recorded on {EffectiveWeightMeasurement.RecordedDate:MMM d, yyyy}" : "No records yet")
            </p>
        </div>

        <!-- Head Circumference Card -->
        <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-[#7F6A5D] dark:text-[#A8988B] uppercase tracking-wider">Head Circumference</span>
                <span class="w-8 h-8 rounded-lg bg-[#5B7553]/15 text-[#5B7553] dark:bg-[#5B7553]/25 dark:text-[#9BBA93] flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-[#2B1D16] dark:text-[#FAF0E6]">
                    @(EffectiveHeadMeasurement?.HeadCircumferenceCm.HasValue == true ? $"{EffectiveHeadMeasurement.HeadCircumferenceCm:N1}" : "â€”")
                </span>
                <span class="text-sm font-semibold text-[#7F6A5D]">cm</span>
            </div>
            <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] mt-1">
                @(EffectiveHeadMeasurement?.HeadCircumferenceCm.HasValue == true ? $"Recorded on {EffectiveHeadMeasurement.RecordedDate:MMM d, yyyy}" : "No records yet")
            </p>
        </div>
    </div>

    <!-- Action Bar & History Table -->
    <div class="bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-2xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6]">Growth Log</h3>
                <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B]">Historical height and weight entries</p>
            </div>
            <button @onclick="OpenRecordModal" class="inline-flex items-center gap-2 px-4 py-2 bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] font-bold text-sm rounded-xl shadow-xs transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Record Measurement
            </button>
        </div>

        @if (_loading)
        {
            <div class="py-12 text-center text-[#7F6A5D] dark:text-[#A8988B] text-sm">Loading measurements...</div>
        }
        else if (_measurements.Count == 0)
        {
            <div class="py-12 text-center text-[#7F6A5D] dark:text-[#A8988B]">
                <svg class="w-12 h-12 mx-auto mb-3 text-[#EADECF] dark:text-[#3D2F28]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <p class="text-sm font-medium">No growth measurements recorded yet</p>
                <p class="text-xs text-[#7F6A5D] dark:text-[#A8988B] mt-1">Start by recording your child's current height, weight, or head circumference.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-[#EADECF] dark:border-[#3D2F28] text-xs font-bold text-[#7F6A5D] dark:text-[#A8988B] uppercase tracking-wider">
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3 px-4">Height</th>
                            <th class="py-3 px-4">Weight</th>
                            <th class="py-3 px-4">Head Circ.</th>
                            <th class="py-3 px-4">Notes</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#EADECF]/50 dark:divide-[#3D2F28]/50">
                        @foreach (var m in _measurements)
                        {
                            <tr class="hover:bg-[#FAF6F0]/60 dark:hover:bg-[#1C1512]/60 transition-colors">
                                <td class="py-3 px-4 font-semibold text-[#2B1D16] dark:text-[#FAF0E6]">
                                    @m.RecordedDate.ToString("MMM d, yyyy")
                                </td>
                                <td class="py-3 px-4">
                                    @if (m.HeightCm.HasValue)
                                    {
                                        <span class="font-medium text-[#2B1D16] dark:text-[#FAF0E6]">@($"{m.HeightCm:N1} cm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#A8988B] dark:text-[#7F6A5D]">â€”</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    @if (m.WeightKg.HasValue)
                                    {
                                        <span class="font-medium text-[#2B1D16] dark:text-[#FAF0E6]">@($"{m.WeightKg:N2} kg")</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#A8988B] dark:text-[#7F6A5D]">â€”</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    @if (m.HeadCircumferenceCm.HasValue)
                                    {
                                        <span class="font-medium text-[#2B1D16] dark:text-[#FAF0E6]">@($"{m.HeadCircumferenceCm:N1} cm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-[#A8988B] dark:text-[#7F6A5D]">â€”</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-xs text-[#7F6A5D] dark:text-[#A8988B]">
                                    @(string.IsNullOrEmpty(m.Notes) ? "â€”" : m.Notes)
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <button @onclick="() => DeleteMeasurementAsync(m.Id)" class="text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 text-xs font-semibold">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_showRecordModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
        <div class="bg-white dark:bg-[#261D19] rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] p-6 max-w-md w-full shadow-2xl">
            <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6] mb-3">Record Growth Measurement</h3>

            <!-- Mode Selector Chips -->
            <div class="flex items-center gap-1.5 p-1 bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-xs font-semibold mb-4">
                <button type="button" @onclick='() => SetMetricMode("all")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "all" ? "bg-[#C85A32] text-white dark:bg-[#FDEEE9] dark:text-[#7B2F14] shadow-xs font-bold" : "text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                    All / Any
                </button>
                <button type="button" @onclick='() => SetMetricMode("weight")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "weight" ? "bg-[#C85A32] text-white dark:bg-[#FDEEE9] dark:text-[#7B2F14] shadow-xs font-bold" : "text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                    Weight only
                </button>
                <button type="button" @onclick='() => SetMetricMode("height")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "height" ? "bg-[#C85A32] text-white dark:bg-[#FDEEE9] dark:text-[#7B2F14] shadow-xs font-bold" : "text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                    Height only
                </button>
                <button type="button" @onclick='() => SetMetricMode("head")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "head" ? "bg-[#C85A32] text-white dark:bg-[#FDEEE9] dark:text-[#7B2F14] shadow-xs font-bold" : "text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                    Head Circ. only
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="p-3 mb-4 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 rounded-xl text-xs font-medium text-red-600 dark:text-red-400">
                    @_errorMessage
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Date</label>
                    <input @bind="_newDate" type="date" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                </div>

                @if (_metricMode == "all")
                {
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Height (cm)</label>
                            <input @bind="_newHeight" type="number" step="0.1" placeholder="e.g. 84.5" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Weight (kg)</label>
                            <input @bind="_newWeight" type="number" step="0.01" placeholder="e.g. 11.4" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Head Circumference (cm, optional)</label>
                        <input @bind="_newHead" type="number" step="0.1" placeholder="e.g. 47.0" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                    </div>
                }
                else if (_metricMode == "weight")
                {
                    <div>
                        <label class="block text-xs font-semibold text-[#C85A32] dark:text-[#FDEEE9] mb-1">Weight (kg) *</label>
                        <input @bind="_newWeight" type="number" step="0.01" placeholder="e.g. 11.4" autofocus class="w-full px-3 py-2.5 text-base bg-[#FAF6F0] dark:bg-[#1C1512] border-2 border-[#C85A32]/40 dark:border-[#FDEEE9]/40 rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] font-bold focus:outline-hidden focus:border-[#C85A32] dark:focus:border-[#FDEEE9]" />
                    </div>
                }
                else if (_metricMode == "height")
                {
                    <div>
                        <label class="block text-xs font-semibold text-[#C85A32] dark:text-[#FDEEE9] mb-1">Height (cm) *</label>
                        <input @bind="_newHeight" type="number" step="0.1" placeholder="e.g. 84.5" autofocus class="w-full px-3 py-2.5 text-base bg-[#FAF6F0] dark:bg-[#1C1512] border-2 border-[#C85A32]/40 dark:border-[#FDEEE9]/40 rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] font-bold focus:outline-hidden focus:border-[#C85A32] dark:focus:border-[#FDEEE9]" />
                    </div>
                }
                else if (_metricMode == "head")
                {
                    <div>
                        <label class="block text-xs font-semibold text-[#C85A32] dark:text-[#FDEEE9] mb-1">Head Circumference (cm) *</label>
                        <input @bind="_newHead" type="number" step="0.1" placeholder="e.g. 47.0" autofocus class="w-full px-3 py-2.5 text-base bg-[#FAF6F0] dark:bg-[#1C1512] border-2 border-[#C85A32]/40 dark:border-[#FDEEE9]/40 rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] font-bold focus:outline-hidden focus:border-[#C85A32] dark:focus:border-[#FDEEE9]" />
                    </div>
                }

                <div>
                    <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">Notes (optional)</label>
                    <textarea @bind="_newNotes" rows="2" placeholder="e.g. 1-year pediatrician checkup" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showRecordModal = false" class="px-4 py-2 text-sm font-semibold text-[#7F6A5D] dark:text-[#EADECF] hover:bg-[#FAF6F0] dark:hover:bg-[#3D2F28]/50 rounded-xl">Cancel</button>
                <button @onclick="SaveMeasurementAsync" class="px-5 py-2 text-sm font-semibold bg-[#C85A32] hover:bg-[#B54E29] dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] text-white dark:text-[#7B2F14] rounded-xl shadow-xs">Record</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ChildId { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestMeasurement { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestHeightMeasurement { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestWeightMeasurement { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestHeadCircumferenceMeasurement { get; set; }
    [Parameter] public EventCallback OnMeasurementsChanged { get; set; }

    private GrowthMeasurementModel? EffectiveHeightMeasurement => LatestHeightMeasurement ?? (LatestMeasurement?.HeightCm.HasValue == true ? LatestMeasurement : null);
    private GrowthMeasurementModel? EffectiveWeightMeasurement => LatestWeightMeasurement ?? (LatestMeasurement?.WeightKg.HasValue == true ? LatestMeasurement : null);
    private GrowthMeasurementModel? EffectiveHeadMeasurement => LatestHeadCircumferenceMeasurement ?? (LatestMeasurement?.HeadCircumferenceCm.HasValue == true ? LatestMeasurement : null);

    private List<GrowthMeasurementModel> _measurements = new();
    private bool _loading = true;
    private bool _showRecordModal;
    private string _metricMode = "all";
    private string? _errorMessage;

    private DateTime _newDate = DateTime.Today;
    private decimal? _newHeight;
    private decimal? _newWeight;
    private decimal? _newHead;
    private string? _newNotes;

    protected override async Task OnParametersSetAsync()
    {
        await LoadMeasurementsAsync();
    }

    private void OpenRecordModal()
    {
        _metricMode = "all";
        _errorMessage = null;
        _newDate = DateTime.Today;
        _newHeight = null;
        _newWeight = null;
        _newHead = null;
        _newNotes = null;
        _showRecordModal = true;
    }

    private void SetMetricMode(string mode)
    {
        _metricMode = mode;
        _errorMessage = null;
        if (mode == "weight") { _newHeight = null; _newHead = null; }
        else if (mode == "height") { _newWeight = null; _newHead = null; }
        else if (mode == "head") { _newHeight = null; _newWeight = null; }
    }

    private async Task LoadMeasurementsAsync()
    {
        _loading = true;
        _measurements = await ChildApi.GetGrowthHistoryAsync(ChildId);
        _loading = false;
    }

    private async Task SaveMeasurementAsync()
    {
        if (!_newHeight.HasValue && !_newWeight.HasValue && !_newHead.HasValue)
        {
            _errorMessage = "Please enter at least one measurement (weight, height, or head circumference).";
            return;
        }

        _errorMessage = null;
        var result = await ChildApi.RecordGrowthAsync(ChildId, _newDate, _newHeight, _newWeight, _newHead, _newNotes);
        if (result != null)
        {
            _showRecordModal = false;
            _newHeight = null;
            _newWeight = null;
            _newHead = null;
            _newNotes = null;
            await LoadMeasurementsAsync();
            await OnMeasurementsChanged.InvokeAsync();
        }
    }

    private async Task DeleteMeasurementAsync(Guid id)
    {
        var ok = await ChildApi.DeleteGrowthAsync(id);
        if (ok)
        {
            await LoadMeasurementsAsync();
            await OnMeasurementsChanged.InvokeAsync();
        }
    }
}