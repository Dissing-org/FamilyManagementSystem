@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject ChildApiClient ChildApi

<div class="space-y-6">
    <!-- Quick Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Height Card -->
        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">@L["Growth.Height"]</span>
                <span class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10M12 3v18m0-18l-3 3m3-3l3 3"/>
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900">
                    @(EffectiveHeightMeasurement?.HeightCm.HasValue == true ? $"{EffectiveHeightMeasurement.HeightCm:N1}" : "—")
                </span>
                <span class="text-sm font-semibold text-slate-500">cm</span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
                @(EffectiveHeightMeasurement?.HeightCm.HasValue == true ? L.Format("Growth.RecordedOn", L.FormatDate(EffectiveHeightMeasurement.RecordedDate)) : L["Growth.NoRecordsYet"])
            </p>
        </div>

        <!-- Weight Card -->
        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">@L["Growth.Weight"]</span>
                <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900">
                    @(EffectiveWeightMeasurement?.WeightKg.HasValue == true ? $"{EffectiveWeightMeasurement.WeightKg:N2}" : "—")
                </span>
                <span class="text-sm font-semibold text-slate-500">kg</span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
                @(EffectiveWeightMeasurement?.WeightKg.HasValue == true ? L.Format("Growth.RecordedOn", L.FormatDate(EffectiveWeightMeasurement.RecordedDate)) : L["Growth.NoRecordsYet"])
            </p>
        </div>

        <!-- Head Circumference Card -->
        <div class="bg-white border border-slate-200/80 rounded-2xl p-5 shadow-xs">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">@L["Growth.HeadCircumference"]</span>
                <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-3xl font-black text-slate-900">
                    @(EffectiveHeadMeasurement?.HeadCircumferenceCm.HasValue == true ? $"{EffectiveHeadMeasurement.HeadCircumferenceCm:N1}" : "—")
                </span>
                <span class="text-sm font-semibold text-slate-500">cm</span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
                @(EffectiveHeadMeasurement?.HeadCircumferenceCm.HasValue == true ? L.Format("Growth.RecordedOn", L.FormatDate(EffectiveHeadMeasurement.RecordedDate)) : L["Growth.NoRecordsYet"])
            </p>
        </div>
    </div>

    <!-- Action Bar & History Table -->
    <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-bold text-slate-900">@L["Growth.LogTitle"]</h3>
                <p class="text-xs text-slate-500">@L["Growth.LogSubtitle"]</p>
            </div>
            <button @onclick="OpenRecordModal" class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm rounded-xl shadow-xs transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                @L["Growth.RecordMeasurement"]
            </button>
        </div>

        @if (_loading)
        {
            <div class="py-12 text-center text-slate-500 text-sm">@L["Growth.Loading"]</div>
        }
        else if (_measurements.Count == 0)
        {
            <div class="py-12 text-center text-slate-500">
                <svg class="w-12 h-12 mx-auto mb-3 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <p class="text-sm font-medium">@L["Growth.EmptyTitle"]</p>
                <p class="text-xs text-slate-500 mt-1">@L["Growth.EmptySubtitle"]</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-200/80 text-xs font-bold text-slate-700 uppercase tracking-wider">
                            <th class="py-3 px-4">@L["Common.Date"]</th>
                            <th class="py-3 px-4">@L["Growth.Height"]</th>
                            <th class="py-3 px-4">@L["Growth.Weight"]</th>
                            <th class="py-3 px-4">@L["Growth.HeadCircShort"]</th>
                            <th class="py-3 px-4">@L["Common.Notes"]</th>
                            <th class="py-3 px-4 text-right">@L["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var m in _measurements)
                        {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-3 px-4 font-semibold text-slate-900">
                                    @L.FormatDate(m.RecordedDate)
                                </td>
                                <td class="py-3 px-4">
                                    @if (m.HeightCm.HasValue)
                                    {
                                        <span class="font-medium text-slate-900">@($"{m.HeightCm:N1} cm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    @if (m.WeightKg.HasValue)
                                    {
                                        <span class="font-medium text-slate-900">@($"{m.WeightKg:N2} kg")</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    @if (m.HeadCircumferenceCm.HasValue)
                                    {
                                        <span class="font-medium text-slate-900">@($"{m.HeadCircumferenceCm:N1} cm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">—</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-xs text-slate-600">
                                    @(string.IsNullOrEmpty(m.Notes) ? "—" : m.Notes)
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <button @onclick="() => DeleteMeasurementAsync(m.Id)" class="text-rose-600 hover:text-rose-700 text-xs font-semibold">
                                        @L["Common.Delete"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_showRecordModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-w-md w-full shadow-xl">
            <h3 class="text-lg font-bold text-slate-900 mb-3">@L["Growth.Modal.Title"]</h3>

            <!-- Mode Selector Chips -->
            <div class="flex items-center gap-1.5 p-1 bg-slate-50 border border-slate-200/80 rounded-xl text-xs font-semibold mb-4">
                <button type="button" @onclick='() => SetMetricMode("all")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "all" ? "bg-sky-600 text-white shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
                    @L["Growth.Mode.All"]
                </button>
                <button type="button" @onclick='() => SetMetricMode("weight")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "weight" ? "bg-sky-600 text-white shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
                    @L["Growth.Mode.WeightOnly"]
                </button>
                <button type="button" @onclick='() => SetMetricMode("height")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "height" ? "bg-sky-600 text-white shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
                    @L["Growth.Mode.HeightOnly"]
                </button>
                <button type="button" @onclick='() => SetMetricMode("head")'
                        class="flex-1 py-1.5 px-2 rounded-lg transition-all @(_metricMode == "head" ? "bg-sky-600 text-white shadow-xs font-bold" : "text-slate-600 hover:text-slate-900")">
                    @L["Growth.Mode.HeadOnly"]
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="p-3 mb-4 bg-rose-50 border border-rose-200/60 rounded-xl text-xs font-medium text-rose-700">
                    @_errorMessage
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Common.Date"]</label>
                    <input @bind="_newDate" type="date" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>

                @if (_metricMode == "all")
                {
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Growth.HeightCmLabel"]</label>
                            <input @bind="_newHeight" type="number" step="0.1" placeholder="f.eks. 84,5" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Growth.WeightKgLabel"]</label>
                            <input @bind="_newWeight" type="number" step="0.01" placeholder="f.eks. 11,4" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Growth.HeadCmOptionalLabel"]</label>
                        <input @bind="_newHead" type="number" step="0.1" placeholder="f.eks. 47,0" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                }
                else if (_metricMode == "weight")
                {
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Growth.WeightKgLabel"] *</label>
                        <input @bind="_newWeight" type="number" step="0.01" placeholder="f.eks. 11,4" autofocus class="w-full px-3 py-2.5 text-base bg-slate-50 border-2 border-sky-500/40 rounded-xl text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                }
                else if (_metricMode == "height")
                {
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Growth.HeightCmLabel"] *</label>
                        <input @bind="_newHeight" type="number" step="0.1" placeholder="f.eks. 84,5" autofocus class="w-full px-3 py-2.5 text-base bg-slate-50 border-2 border-sky-500/40 rounded-xl text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                }
                else if (_metricMode == "head")
                {
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Growth.HeadCmLabel"]</label>
                        <input @bind="_newHead" type="number" step="0.1" placeholder="f.eks. 47,0" autofocus class="w-full px-3 py-2.5 text-base bg-slate-50 border-2 border-sky-500/40 rounded-xl text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                    </div>
                }

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Common.NotesOptional"]</label>
                    <textarea @bind="_newNotes" rows="2" placeholder="@L["Growth.NotesPlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white"></textarea>
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showRecordModal = false" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">@L["Common.Cancel"]</button>
                <button @onclick="SaveMeasurementAsync" class="px-5 py-2 text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-xs transition-colors">@L["Growth.RecordButton"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ChildId { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestMeasurement { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestHeightMeasurement { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestWeightMeasurement { get; set; }
    [Parameter] public GrowthMeasurementModel? LatestHeadCircumferenceMeasurement { get; set; }
    [Parameter] public EventCallback OnMeasurementsChanged { get; set; }

    private GrowthMeasurementModel? EffectiveHeightMeasurement => LatestHeightMeasurement ?? (LatestMeasurement?.HeightCm.HasValue == true ? LatestMeasurement : null);
    private GrowthMeasurementModel? EffectiveWeightMeasurement => LatestWeightMeasurement ?? (LatestMeasurement?.WeightKg.HasValue == true ? LatestMeasurement : null);
    private GrowthMeasurementModel? EffectiveHeadMeasurement => LatestHeadCircumferenceMeasurement ?? (LatestMeasurement?.HeadCircumferenceCm.HasValue == true ? LatestMeasurement : null);

    private List<GrowthMeasurementModel> _measurements = new();
    private bool _loading = true;
    private bool _showRecordModal;
    private string _metricMode = "all";
    private string? _errorMessage;

    private DateTime _newDate = DateTime.Today;
    private decimal? _newHeight;
    private decimal? _newWeight;
    private decimal? _newHead;
    private string? _newNotes;

    protected override async Task OnParametersSetAsync()
    {
        await LoadMeasurementsAsync();
    }

    private void OpenRecordModal()
    {
        _metricMode = "all";
        _errorMessage = null;
        _newDate = DateTime.Today;
        _newHeight = null;
        _newWeight = null;
        _newHead = null;
        _newNotes = null;
        _showRecordModal = true;
    }

    private void SetMetricMode(string mode)
    {
        _metricMode = mode;
        _errorMessage = null;
        if (mode == "weight") { _newHeight = null; _newHead = null; }
        else if (mode == "height") { _newWeight = null; _newHead = null; }
        else if (mode == "head") { _newHeight = null; _newWeight = null; }
    }

    private async Task LoadMeasurementsAsync()
    {
        _loading = true;
        _measurements = await ChildApi.GetGrowthHistoryAsync(ChildId);
        _loading = false;
    }

    private async Task SaveMeasurementAsync()
    {
        if (!_newHeight.HasValue && !_newWeight.HasValue && !_newHead.HasValue)
        {
            _errorMessage = L["Growth.Validation.AtLeastOne"];
            return;
        }

        _errorMessage = null;
        var result = await ChildApi.RecordGrowthAsync(ChildId, _newDate, _newHeight, _newWeight, _newHead, _newNotes);
        if (result != null)
        {
            _showRecordModal = false;
            _newHeight = null;
            _newWeight = null;
            _newHead = null;
            _newNotes = null;
            await LoadMeasurementsAsync();
            await OnMeasurementsChanged.InvokeAsync();
        }
    }

    private async Task DeleteMeasurementAsync(Guid id)
    {
        var ok = await ChildApi.DeleteGrowthAsync(id);
        if (ok)
        {
            await LoadMeasurementsAsync();
            await OnMeasurementsChanged.InvokeAsync();
        }
    }
}