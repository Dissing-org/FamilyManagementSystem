@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject ChildApiClient ChildApi

<div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs mb-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <!-- Avatar & Core Info -->
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-sky-600 text-white flex items-center justify-center font-black text-2xl shadow-xs shrink-0">
                @Child.FirstName.Substring(0, 1).ToUpper()
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-2xl font-black text-slate-900">@Child.FullName</h1>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold @(Child.Gender == "Boy" ? "bg-sky-50 text-sky-700 border border-sky-200/60" : "bg-purple-50 text-purple-700 border border-purple-200/60")">
                        @L.Gender(Child.Gender)
                    </span>
                </div>
                <div class="flex items-center gap-3 mt-1 text-sm text-slate-500">
                    <span class="inline-flex items-center gap-1 font-semibold text-slate-700">
                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        @L.Format("Children.Header.Born", L.FormatDate(Child.DateOfBirth, "d. MMMM yyyy"))
                    </span>
                    <span>•</span>
                    <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200/60 font-bold text-xs">
                        @L.FormatAge(Child.Age.Years, Child.Age.Months, Child.Age.Days)
                    </span>
                </div>
            </div>
        </div>

        <!-- Current Wardrobe Sizes Bar -->
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60 flex flex-wrap items-center gap-3">
            <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider pl-1">
                @L["Children.Header.CurrentSizes"]
            </div>
            
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-slate-200/60 text-xs">
                <span class="text-slate-500">@L["Children.Header.Clothes"]</span>
                <span class="font-bold text-slate-900">@(string.IsNullOrEmpty(Child.Sizes?.ClothesSize) ? "—" : Child.Sizes.ClothesSize)</span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-slate-200/60 text-xs">
                <span class="text-slate-500">@L["Children.Header.Shoes"]</span>
                <span class="font-bold text-slate-900">@(string.IsNullOrEmpty(Child.Sizes?.ShoeSize) ? "—" : Child.Sizes.ShoeSize)</span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-slate-200/60 text-xs">
                <span class="text-slate-500">@L["Children.Header.Hat"]</span>
                <span class="font-bold text-slate-900">@(string.IsNullOrEmpty(Child.Sizes?.HatSize) ? "—" : Child.Sizes.HatSize)</span>
            </div>

            <button @onclick="() => _showEditSizesModal = true" class="p-1.5 hover:bg-slate-200/60 rounded-lg text-slate-500 hover:text-slate-700 transition-colors" title="@L["Children.Header.EditSizesTitle"]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                </svg>
            </button>
        </div>
    </div>
</div>

@if (_showEditSizesModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-sm w-full shadow-xl">
            <h3 class="text-lg font-bold text-slate-900 mb-4">@L["Children.Header.EditWardrobeTitle"]</h3>
            
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.ClothesSize"]</label>
                    <input @bind="_clothesSize" placeholder="@L["Children.Header.ClothesPlaceholderLong"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.ShoeSize"]</label>
                    <input @bind="_shoeSize" placeholder="@L["Children.Header.ShoesPlaceholderLong"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.HatSize"]</label>
                    <input @bind="_hatSize" placeholder="@L["Children.Modal.HatSizePlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.DiaperSize"]</label>
                    <input @bind="_diaperSize" placeholder="@L["Children.Modal.DiaperSizePlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                </div>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <button @onclick="() => _showEditSizesModal = false" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">@L["Common.Cancel"]</button>
                <button @onclick="SaveSizesAsync" class="px-5 py-2 text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-xs transition-colors">@L["Common.Save"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ChildProfileModel Child { get; set; } = null!;
    [Parameter] public EventCallback OnSizesUpdated { get; set; }

    private bool _showEditSizesModal;
    private string? _clothesSize;
    private string? _shoeSize;
    private string? _hatSize;
    private string? _diaperSize;

    protected override void OnParametersSet()
    {
        _clothesSize = Child.Sizes?.ClothesSize;
        _shoeSize = Child.Sizes?.ShoeSize;
        _hatSize = Child.Sizes?.HatSize;
        _diaperSize = Child.Sizes?.DiaperSize;
    }

    private async Task SaveSizesAsync()
    {
        var ok = await ChildApi.UpdateSizesAsync(Child.Id, _clothesSize, _shoeSize, _hatSize, _diaperSize);
        if (ok)
        {
            if (Child.Sizes == null) Child.Sizes = new ChildWardrobeSizesModel();
            Child.Sizes.ClothesSize = _clothesSize;
            Child.Sizes.ShoeSize = _shoeSize;
            Child.Sizes.HatSize = _hatSize;
            Child.Sizes.DiaperSize = _diaperSize;
            _showEditSizesModal = false;
            await OnSizesUpdated.InvokeAsync();
        }
    }
}