@page "/insurances"
@using FamilyManagement.UI.Shared.Components
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="min-h-screen bg-[#faf7f2] dark:bg-[#131427] text-slate-800 dark:text-slate-100 font-sans pb-16">
    <!-- Header -->
    <AppHeader CurrentSectionSubtitle="Policy & Coverage Management" OnSettingsSaved="LoadDataAsync">
        <ActionContent>
            <button @onclick="OpenAddModal" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-[#ffbf6e] hover:bg-[#f5b35e] text-[#241300] text-sm font-black rounded-xl shadow-md shadow-[#ffbf6e]/20 transition-all hover:shadow-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Add Policy</span>
            </button>
        </ActionContent>
    </AppHeader>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <!-- Overview Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <!-- 1. Pistachio Green: Total Monthly Cost -->
            <div class="bg-[#56aa69]/15 border-2 border-[#56aa69]/40 p-5 rounded-2xl shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#56aa69] text-white flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-[#56aa69] uppercase tracking-wider">Total Monthly Cost</p>
                    <p class="text-3xl font-black text-[#56aa69]">
                        @(_overview?.TotalMonthlyCost.ToString("N0") ?? "0") @(_overview?.Currency ?? "DKK")
                    </p>
                </div>
            </div>

            <!-- 2. Dark Soft Violet: Annual Equivalent -->
            <div class="bg-[#4d52de]/15 border-2 border-[#4d52de]/40 p-5 rounded-2xl shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#4d52de] text-white flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-[#868aee] dark:text-[#a7abf8] uppercase tracking-wider">Annual Equivalent</p>
                    <p class="text-3xl font-black text-[#4d52de] dark:text-[#b4b7f5]">
                        @(_overview?.TotalAnnualCost.ToString("N0") ?? "0") @(_overview?.Currency ?? "DKK")
                    </p>
                </div>
            </div>

            <!-- 3. Cinnamon Buff: Active Policies -->
            <div class="bg-[#ffbf6e]/15 border-2 border-[#ffbf6e]/40 p-5 rounded-2xl shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#ffbf6e] text-[#241300] flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-[#c0792b] dark:text-[#ffdfad] uppercase tracking-wider">Active Policies</p>
                    <p class="text-3xl font-black text-[#995d24] dark:text-[#ffbf6e]">
                        @(_overview?.ActivePolicies ?? _policies.Count)
                    </p>
                </div>
            </div>
        </div>

        <!-- Upcoming Renewals Alert Banner -->
        @if (_overview?.UpcomingRenewals is not null && _overview.UpcomingRenewals.Count > 0)
        {
            <div class="mb-6 p-4 bg-[#ffbf6e]/15 border-2 border-[#ffbf6e]/40 rounded-2xl">
                <div class="flex items-center gap-2 mb-2 text-[#c0792b] dark:text-[#ffdfad] font-bold text-sm">
                    <svg class="w-5 h-5 text-[#ffbf6e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    <span>Upcoming Policy Renewals</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    @foreach (var alert in _overview.UpcomingRenewals)
                    {
                        <div class="bg-white dark:bg-[#1b1c36] p-3 rounded-xl border border-[#ffbf6e]/30 flex items-center justify-between text-xs shadow-xs">
                            <div>
                                <span class="font-bold text-slate-900 dark:text-slate-100">@alert.Insurer</span>
                                <span class="text-slate-500 dark:text-slate-400 block">@alert.InsuredParty (@alert.Category)</span>
                            </div>
                            <div class="text-right">
                                <span class="font-bold @(alert.IsUrgent ? "text-rose-600" : "text-[#c0792b] dark:text-[#ffbf6e]")">
                                    in @alert.DaysRemaining days
                                </span>
                                <span class="text-[11px] text-slate-400 block">@alert.RenewalDate.ToString("MMM d")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Filters & Search -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between mb-6">
            <!-- Search input -->
            <div class="relative flex-1 max-w-md">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <input @bind="_searchQuery" @bind:event="oninput" type="text" placeholder="Search by insurer, policy #, or insured..."
                       class="w-full pl-9 pr-4 py-2 text-sm bg-white dark:bg-[#1b1c36] border border-[#ebdcd0] dark:border-[#2c2f57] rounded-xl focus:ring-2 focus:ring-[#4d52de] focus:outline-none shadow-sm" />
            </div>

            <!-- Category Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
                <button @onclick='() => _selectedCategory = null'
                        class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == null ? "bg-[#4d52de] text-white shadow-sm" : "bg-white dark:bg-[#1b1c36] text-slate-600 dark:text-slate-300 border border-[#ebdcd0] dark:border-[#2c2f57] hover:border-[#ffbf6e]")">
                    All
                </button>
                @foreach (var cat in InsuranceConstants.Categories)
                {
                    <button @onclick="() => _selectedCategory = cat"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == cat ? "bg-[#4d52de] text-white shadow-sm" : "bg-white dark:bg-[#1b1c36] text-slate-600 dark:text-slate-300 border border-[#ebdcd0] dark:border-[#2c2f57] hover:border-[#ffbf6e]")">
                        @cat
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="mb-6 p-4 bg-rose-50 dark:bg-rose-900/40 border border-rose-200 dark:border-rose-800 rounded-2xl text-rose-700 dark:text-rose-300 text-sm">
                @_errorMessage
            </div>
        }

        <!-- Policy Cards Grid -->
        @if (_isLoading)
        {
            <div class="py-20 flex flex-col items-center justify-center text-slate-400">
                <div class="animate-spin h-8 w-8 border-4 border-[#4d52de] border-t-transparent rounded-full mb-3"></div>
                <p class="text-sm font-medium">Loading family policies...</p>
            </div>
        }
        else if (FilteredPolicies.Count == 0)
        {
            <div class="py-20 text-center bg-white dark:bg-[#1b1c36] rounded-2xl border border-dashed border-[#ebdcd0] dark:border-[#2c2f57] p-8 shadow-sm">
                <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#4d52de]/10 flex items-center justify-center text-[#4d52de]">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <h3 class="text-base font-bold text-slate-800 dark:text-slate-200 mb-1">No insurance policies found</h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-4 max-w-sm mx-auto">
                    @if (!string.IsNullOrWhiteSpace(_searchQuery) || _selectedCategory != null)
                    {
                        <span>No policies match your active search filters. Try clearing your filters.</span>
                    }
                    else
                    {
                        <span>Keep track of home, auto, health, and family policies, premiums, and renewals.</span>
                    }
                </p>
                <button @onclick="OpenAddModal"
                        class="px-4 py-2 bg-[#ffbf6e] hover:bg-[#f5b35e] text-[#241300] font-black text-sm rounded-xl shadow-md transition-colors">
                    Add Policy
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var policy in FilteredPolicies)
                {
                    <InsurancePolicyCard Policy="@policy" OnEdit="OpenEditModal" OnDelete="HandleDeleteAsync" />
                }
            </div>
        }
    </main>
</div>

<!-- Modal -->
@if (_showModal)
{
    <InsurancePolicyModal PolicyToEdit="@_policyToEdit" 
                          OnClose="() => _showModal = false" 
                          OnSaved="HandlePolicySaved" />
}

@code {
    [Inject]
    public IInsuranceApiClient ApiClient { get; set; } = null!;

    private List<InsurancePolicyViewModel> _policies = new();
    private InsuranceOverviewModel? _overview;
    private bool _isLoading = true;
    private string? _errorMessage;

    private string _searchQuery = string.Empty;
    private string? _selectedCategory;

    private bool _showModal = false;
    private InsurancePolicyViewModel? _policyToEdit;

    private List<InsurancePolicyViewModel> FilteredPolicies
    {
        get
        {
            var query = _policies.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(p => 
                    p.Insurer.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.InsuredParty.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (p.PolicyNumber?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.Notes?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(_selectedCategory))
            {
                query = query.Where(p => p.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderBy(p => p.Insurer).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var policiesTask = ApiClient.GetPoliciesAsync();
            var overviewTask = ApiClient.GetOverviewAsync();
            await Task.WhenAll(policiesTask, overviewTask);

            _policies = await policiesTask;
            _overview = await overviewTask;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _policyToEdit = null;
        _showModal = true;
    }

    private void OpenEditModal(InsurancePolicyViewModel policy)
    {
        _policyToEdit = policy;
        _showModal = true;
    }

    private async Task HandlePolicySaved(InsurancePolicyViewModel saved)
    {
        _showModal = false;
        await LoadDataAsync();
    }

    private async Task HandleDeleteAsync(Guid id)
    {
        var success = await ApiClient.DeletePolicyAsync(id);
        if (success)
        {
            _policies.RemoveAll(p => p.Id == id);
            _overview = await ApiClient.GetOverviewAsync();
        }
    }
}
