@page "/"
@using FamilyManagement.UI.Shared.Components
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services
@inject NavigationManager Navigation

<div class="min-h-screen bg-[#fbf9f5] dark:bg-[#0b1a24] text-slate-800 dark:text-slate-100 font-sans pb-16">
    <AppHeader CurrentSectionSubtitle="Family Management Hub" OnSettingsSaved="LoadDataAsync" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
        <!-- Welcome Hero -->
        <div class="bg-gradient-to-br from-[#064f6e] via-[#053f58] to-[#042838] rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 relative overflow-hidden">
            <div class="absolute -right-8 -bottom-8 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
            <div class="relative z-10 max-w-2xl">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-white/15 backdrop-blur-md mb-3 border border-white/20 text-[#abf5ed]">
                    <span class="w-2 h-2 rounded-full bg-[#abf5ed] animate-pulse"></span>
                    Family Cloud System
                </span>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight mb-2">
                    Welcome to Family Hub
                </h1>
                <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
                    Centralized family management. Safely archive purchase receipts to Google Drive and monitor insurance policies, coverage, and renewal schedules.
                </p>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="py-16 flex flex-col items-center justify-center text-slate-400">
                <div class="animate-spin h-8 w-8 border-4 border-[#064f6e] dark:border-[#abf5ed] border-t-transparent rounded-full mb-3"></div>
                <p class="text-sm font-medium">Loading family overview...</p>
            </div>
        }
        else
        {
            <!-- Upcoming Renewal Alert Banner (if any) -->
            @if (_insuranceOverview?.UpcomingRenewals is not null && _insuranceOverview.UpcomingRenewals.Count > 0)
            {
                <div class="mb-8 p-5 bg-[#c0b490]/15 border-2 border-[#c0b490]/40 rounded-3xl shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2 text-[#71644c] dark:text-[#ddd0b2] font-bold text-sm sm:text-base">
                            <svg class="w-5 h-5 text-[#a89874]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                            <span>Action Required: @(_insuranceOverview.UpcomingRenewals.Count) Policy Renewals Approaching</span>
                        </div>
                        <a href="insurances" class="text-xs font-bold text-[#064f6e] dark:text-[#abf5ed] hover:underline">
                            View all in Insurances &rarr;
                        </a>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                        @foreach (var alert in _insuranceOverview.UpcomingRenewals)
                        {
                            <div class="bg-white dark:bg-[#122b3b] p-3.5 rounded-2xl border border-[#c0b490]/30 flex items-center justify-between shadow-xs">
                                <div>
                                    <h4 class="font-bold text-sm text-slate-900 dark:text-slate-100">@alert.Insurer</h4>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">@alert.InsuredParty (@alert.Category)</p>
                                </div>
                                <div class="text-right">
                                    <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold @(alert.IsUrgent ? "bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300" : "bg-[#c0b490] text-[#342d21]")">
                                        @alert.DaysRemaining days left
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Main Module Hub Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Receipts Hub Card -->
                <div class="bg-white dark:bg-[#122b3b] rounded-3xl border border-[#e2d8c7] dark:border-[#1a3b50] shadow-sm p-6 sm:p-7 flex flex-col justify-between hover:border-[#064f6e]/50 dark:hover:border-[#abf5ed]/50 transition-all group">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-[#064f6e]/15 text-[#064f6e] dark:text-[#abf5ed] flex items-center justify-center group-hover:scale-105 transition-transform">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"/>
                                </svg>
                            </div>
                            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-[#fbf9f5] dark:bg-[#0b1a24] text-slate-600 dark:text-slate-300 border border-[#e2d8c7] dark:border-[#1a3b50]">
                                Google Drive
                            </span>
                        </div>

                        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2">Purchase Receipts</h2>
                        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">
                            Store receipt documents and photos categorized with merchant autocomplete and Google Drive archiving.
                        </p>

                        <!-- Stats Row -->
                        <div class="grid grid-cols-2 gap-3 mb-6 bg-[#fbf9f5] dark:bg-[#0b1a24] p-4 rounded-2xl border border-[#e2d8c7] dark:border-[#1a3b50]">
                            <div>
                                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Stored</p>
                                <p class="text-2xl font-black text-slate-900 dark:text-slate-100">@_receipts.Count</p>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-[#064f6e] dark:text-[#abf5ed] uppercase tracking-wider">This Month</p>
                                <p class="text-2xl font-black text-[#064f6e] dark:text-[#abf5ed]">@ReceiptsThisMonth</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 pt-2">
                        <a href="receipts" class="flex-1 py-2.5 px-4 bg-[#064f6e] hover:bg-[#05425c] text-white font-bold text-sm rounded-xl text-center shadow-md transition-all hover:shadow-lg">
                            Open Receipts &rarr;
                        </a>
                        <button @onclick="() => _showUploadReceiptModal = true" class="py-2.5 px-4 bg-[#abf5ed] hover:bg-[#8eebe0] text-[#042838] font-black text-sm rounded-xl transition-colors shadow-sm">
                            + Upload
                        </button>
                    </div>
                </div>

                <!-- Insurances Hub Card -->
                <div class="bg-white dark:bg-[#122b3b] rounded-3xl border border-[#e2d8c7] dark:border-[#1a3b50] shadow-sm p-6 sm:p-7 flex flex-col justify-between hover:border-[#064f6e]/50 dark:hover:border-[#abf5ed]/50 transition-all group">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-[#c0b490]/25 text-[#71644c] dark:text-[#ddd0b2] flex items-center justify-center group-hover:scale-105 transition-transform">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                            </div>
                            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-[#fbf9f5] dark:bg-[#0b1a24] text-slate-600 dark:text-slate-300 border border-[#e2d8c7] dark:border-[#1a3b50]">
                                Policy Tracking
                            </span>
                        </div>

                        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2">Family Insurance Policies</h2>
                        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">
                            Manage home, car, health, and family insurance policies, normalized monthly/annual costs, and renewal alerts.
                        </p>

                        <!-- Stats Row -->
                        <div class="grid grid-cols-2 gap-3 mb-6 bg-[#fbf9f5] dark:bg-[#0b1a24] p-4 rounded-2xl border border-[#e2d8c7] dark:border-[#1a3b50]">
                            <div>
                                <p class="text-xs font-bold text-[#71644c] dark:text-[#ddd0b2] uppercase tracking-wider">Active Policies</p>
                                <p class="text-2xl font-black text-[#71644c] dark:text-[#ddd0b2]">
                                    @(_insuranceOverview?.ActivePolicies ?? 0)
                                </p>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-[#064f6e] dark:text-[#abf5ed] uppercase tracking-wider">Monthly Budget</p>
                                <p class="text-2xl font-black text-[#064f6e] dark:text-[#abf5ed]">
                                    @(_insuranceOverview?.TotalMonthlyCost.ToString("N0") ?? "0") @(_insuranceOverview?.Currency ?? "DKK")
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 pt-2">
                        <a href="insurances" class="flex-1 py-2.5 px-4 bg-[#064f6e] hover:bg-[#05425c] text-white font-bold text-sm rounded-xl text-center shadow-md transition-all hover:shadow-lg">
                            Open Insurances &rarr;
                        </a>
                        <button @onclick="() => _showAddPolicyModal = true" class="py-2.5 px-4 bg-[#abf5ed] hover:bg-[#8eebe0] text-[#042838] font-black text-sm rounded-xl transition-colors shadow-sm">
                            + Add Policy
                        </button>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

<!-- Modals for Quick Actions -->
@if (_showUploadReceiptModal)
{
    <UploadReceiptModal ExistingMerchants="@_merchants"
                        OnClose="() => _showUploadReceiptModal = false" 
                        OnReceiptUploaded="HandleReceiptUploaded" />
}

@if (_showAddPolicyModal)
{
    <InsurancePolicyModal OnClose="() => _showAddPolicyModal = false" 
                          OnSaved="HandlePolicySaved" />
}

@code {
    [Inject]
    public IReceiptApiClient ReceiptApi { get; set; } = null!;

    [Inject]
    public IInsuranceApiClient InsuranceApi { get; set; } = null!;

    private List<ReceiptViewModel> _receipts = new();
    private List<string> _merchants = new();
    private InsuranceOverviewModel? _insuranceOverview;
    private bool _isLoading = true;

    private bool _showUploadReceiptModal = false;
    private bool _showAddPolicyModal = false;

    private int ReceiptsThisMonth =>
        _receipts.Count(r => r.CreatedAt.ToLocalTime() is var created && created.Year == DateTime.Now.Year && created.Month == DateTime.Now.Month);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var receiptsTask = ReceiptApi.GetReceiptsAsync();
            var merchantsTask = ReceiptApi.GetMerchantsAsync();
            var insuranceTask = InsuranceApi.GetOverviewAsync();

            await Task.WhenAll(receiptsTask, merchantsTask, insuranceTask);

            _receipts = await receiptsTask;
            _merchants = await merchantsTask;
            _insuranceOverview = await insuranceTask;
        }
        catch
        {
            // Silently fall back to empty defaults on failure
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleReceiptUploaded(ReceiptViewModel receipt)
    {
        _showUploadReceiptModal = false;
        _receipts.Insert(0, receipt);
    }

    private async Task HandlePolicySaved(InsurancePolicyViewModel policy)
    {
        _showAddPolicyModal = false;
        _insuranceOverview = await InsuranceApi.GetOverviewAsync();
    }
}
