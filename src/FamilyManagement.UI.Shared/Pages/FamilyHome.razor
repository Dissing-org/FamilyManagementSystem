@page "/"
@using FamilyManagement.UI.Shared.Components
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@inject NavigationManager Navigation
@inject IAuthSessionService AuthSession
@inject FreezerApiClient FreezerApi

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans pb-24">
    
    <!-- Slim Frosted Top Header -->
    <AppHeader CurrentSectionSubtitle="@L["Home.Subtitle"]" OnSettingsSaved="LoadDataAsync" UpcomingRenewalCount="UpcomingRenewalCount" />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8">
        
        <!-- Section 1: Editorial Header & Daily Glance -->
        <div class="relative overflow-hidden pb-6 border-b border-slate-200/80">
            <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <p class="text-xs uppercase font-bold tracking-wider text-slate-500">
                        @L.FormatDate(DateTime.Now, "dddd, d. MMMM yyyy")
                    </p>
                    <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 mt-1">
                        @GetGreeting(), @(string.IsNullOrWhiteSpace(AuthSession.Current.DisplayName) ? "Mathi" : AuthSession.Current.DisplayName)
                    </h1>
                    <p class="text-sm text-slate-500 mt-1">
                        @L["Home.SnapshotSubtitle"]
                    </p>
                </div>

                <!-- Quick Status Pill Capsule -->
                <div class="flex items-center gap-2 self-start md:self-auto">
                    @if (UpcomingRenewalCount > 0)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200/60 shadow-xs">
                            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                            @L.Format("Home.RenewalsPending", UpcomingRenewalCount)
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60 shadow-xs">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            @L["Home.AllPoliciesUpToDate"]
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Section 2: Quick Action Bar (Tactile One-Tap Pills) -->
        <div class="py-4 flex items-center gap-2.5 overflow-x-auto scrollbar-none">
            <button @onclick="() => _showUploadReceiptModal = true"
                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-sky-600 text-white hover:bg-sky-700 shadow-xs transition-all shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>@L["Home.Action.LogExpense"]</span>
            </button>

            <a href="vehicles"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200/80 text-slate-700 hover:border-sky-500 hover:bg-sky-50/50 hover:text-sky-700 shadow-xs transition-all shrink-0">
                <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span>@L["Home.Action.RecordMileage"]</span>
            </a>

            <a href="children"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200/80 text-slate-700 hover:border-sky-500 hover:bg-sky-50/50 hover:text-sky-700 shadow-xs transition-all shrink-0">
                <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>@L["Home.Action.MeasureChild"]</span>
            </a>

            <button @onclick="() => _showAddPolicyModal = true"
                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200/80 text-slate-700 hover:border-sky-500 hover:bg-sky-50/50 hover:text-sky-700 shadow-xs transition-all shrink-0">
                <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span>@L["Home.Action.NewPolicy"]</span>
            </button>

            <a href="freezer"
               class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200/80 text-slate-700 hover:border-sky-500 hover:bg-sky-50/50 hover:text-sky-700 shadow-xs transition-all shrink-0">
                <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v18m-9-9h18m-4.5-6.5l-9 9m0-9l9 9M5 7l2 2m10 10l2 2m-2-14l-2 2M7 17l-2 2" />
                </svg>
                <span>@L["Home.Action.Freezer"]</span>
            </a>
        </div>

        @if (_isLoading)
        {
            <div class="py-20 flex flex-col items-center justify-center text-slate-500">
                <div class="animate-spin h-8 w-8 border-3 border-sky-600 border-t-transparent rounded-full mb-3"></div>
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">@L["Home.SyncingRecords"]</p>
            </div>
        }
        else
        {
            <!-- Section 3: Urgent Attention Strip (When Applicable) -->
            @if (_insuranceOverview?.UpcomingRenewals is not null && _insuranceOverview.UpcomingRenewals.Count > 0)
            {
                <div class="my-4 p-4 rounded-2xl bg-amber-50 border border-amber-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-amber-800 uppercase tracking-wider">@L["Home.UpcomingRenewalTitle"]</span>
                            <p class="text-xs text-slate-700 mt-0.5">
                                <strong>@_insuranceOverview.UpcomingRenewals.First().Insurer</strong> (@L.InsuranceCategory(_insuranceOverview.UpcomingRenewals.First().Category)) @L["Home.ExpiresInDays"] <strong>@_insuranceOverview.UpcomingRenewals.First().DaysRemaining @L["Home.Days"]</strong>.
                            </p>
                        </div>
                    </div>
                    <a href="insurances" class="text-xs font-bold text-sky-600 hover:underline self-end sm:self-auto shrink-0">
                        @L["Home.ReviewInInsurances"] &rarr;
                    </a>
                </div>
            }

            <!-- Section 4: Asymmetric Editorial 8:4 Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-4">
                
                <!-- Left 8/12: Chronological Activity Feed -->
                <div class="lg:col-span-8 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xs uppercase font-bold tracking-wider text-slate-500">
                            @L["Home.RecentActivity"]
                        </h2>
                        <span class="text-xs text-slate-500">@L["Home.LiveEventStream"]</span>
                    </div>

                    <div class="bg-white rounded-2xl border border-slate-200/80 divide-y divide-slate-100 shadow-xs overflow-hidden">
                        
                        @if (_receipts.Take(5).Any())
                        {
                            @foreach (var receipt in _receipts.Take(5))
                            {
                                <div class="p-4 flex items-center justify-between hover:bg-slate-50/70 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="w-9 h-9 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z"/>
                                            </svg>
                                        </div>
                                        <div class="truncate">
                                            <p class="text-xs font-bold text-slate-900 truncate">@receipt.Merchant</p>
                                            <p class="text-[11px] text-slate-500 truncate">@L.Category(receipt.Category) · @L["Home.ArchivedToDrive"]</p>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0 ml-3">
                                        <span class="text-[11px] font-semibold text-slate-500">@L.FormatDate(receipt.PurchaseDate)</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-8 text-center text-slate-500">
                                <p class="text-xs">@L["Home.NoTransactionsYet"]</p>
                            </div>
                        }

                        <!-- Quick Vehicle Inspection Alert Row if present -->
                        @if (_vehicles.Any(v => v.NextInspectionDate.HasValue))
                        {
                            var nextCar = _vehicles.Where(v => v.NextInspectionDate.HasValue).OrderBy(v => v.NextInspectionDate).First();
                            <div class="p-4 flex items-center justify-between bg-emerald-50/50">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10M5 16h10m4 0h1a1 1 0 001-1v-3.5a1 1 0 00-.293-.707l-3.5-3.5A1 1 0 0016.5 7H15v9m4 0a2 2 0 100-4 2 2 0 000 4z"/>
                                        </svg>
                                    </div>
                                    <div class="truncate">
                                        <p class="text-xs font-bold text-slate-900 truncate">@L["Home.InspectionSchedule"]: @nextCar.Make @nextCar.Model</p>
                                        <p class="text-[11px] text-emerald-700 font-medium">@L.Format("Home.BilsynDue", nextCar.NextInspectionDate.HasValue ? L.FormatDate(nextCar.NextInspectionDate.Value, "MMM yyyy") : string.Empty)</p>
                                    </div>
                                </div>
                                <a href="vehicles" class="text-xs font-semibold text-emerald-700 hover:underline shrink-0">@L["Common.View"]</a>
                            </div>
                        }

                    </div>
                </div>

                <!-- Right 4/12: Domain Intelligence Rail -->
                <div class="lg:col-span-4 flex flex-col gap-4">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xs uppercase font-bold tracking-wider text-slate-500">
                            @L["Home.DomainSnapshots"]
                        </h2>
                        <span class="text-xs text-slate-500">@L["Home.FourPillars"]</span>
                    </div>

                    <!-- 1. Children Wardrobe & Milestone Glance -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs hover:border-slate-300 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">@L["Home.ChildrenAndSizes"]</span>
                            <a href="children" class="text-xs font-semibold text-sky-600 hover:underline">@L["Home.ProfilesLink"] &rarr;</a>
                        </div>
                        <div class="space-y-2 mt-2">
                            @if (_children.Any())
                            {
                                @foreach (var child in _children)
                                {
                                    <div class="flex items-center justify-between py-1 border-b border-slate-100 last:border-0 text-xs">
                                        <div class="font-bold text-slate-900">
                                            @child.FirstName <span class="font-normal text-slate-500">(@L.FormatAge(child.Age.Years, child.Age.Months, child.Age.Days))</span>
                                        </div>
                                        <div class="text-slate-500 text-[11px]">
                                            @L["Home.ClothesShort"]: <strong>@(child.Sizes?.ClothesSize ?? "—")</strong> · @L["Home.ShoesShort"]: <strong>@(child.Sizes?.ShoeSize ?? "—")</strong>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-500">@L["Home.NoChildrenYet"]</p>
                            }
                        </div>
                    </div>

                    <!-- 2. Vehicles Fleet & Odometer Glance -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs hover:border-slate-300 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">@L["Home.VehiclesFleet"]</span>
                            <a href="vehicles" class="text-xs font-semibold text-sky-600 hover:underline">@L["Home.GarageLink"] &rarr;</a>
                        </div>
                        <div class="space-y-1.5 mt-2">
                            @if (_vehicles.Any())
                            {
                                @foreach (var vehicle in _vehicles)
                                {
                                    <div class="flex items-center justify-between text-xs py-1">
                                        <span class="font-bold text-slate-900">@vehicle.Make @vehicle.Model</span>
                                        <span class="font-semibold text-slate-600 bg-slate-50 px-2 py-0.5 rounded-lg border border-slate-200/80">
                                            @vehicle.CurrentMileageKm.ToString("N0") km
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-slate-500">@L["Home.NoVehiclesTracked"]</p>
                            }
                        </div>
                    </div>

                    <!-- 3. Insurances Monthly Burn -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs hover:border-slate-300 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">@L["Home.FamilyInsurances"]</span>
                            <a href="insurances" class="text-xs font-semibold text-sky-600 hover:underline">@L["Common.ViewAll"] &rarr;</a>
                        </div>
                        <div class="flex items-baseline justify-between mt-1">
                            <div>
                                <span class="text-2xl font-black text-slate-900">@(_insuranceOverview?.ActivePolicies ?? 0)</span>
                                <span class="text-xs text-slate-500 ml-1">@L["Home.PoliciesActive"]</span>
                            </div>
                            <span class="text-xs font-bold text-sky-700 bg-sky-50 border border-sky-200/60 px-2 py-0.5 rounded-full">
                                @(_insuranceOverview?.TotalMonthlyCost.ToString("N0") ?? "0") @(_insuranceOverview?.Currency ?? "DKK")/@L["Home.PerMonthShort"]
                            </span>
                        </div>
                    </div>

                    <!-- 4. Purchase Receipts Telemetry -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs hover:border-slate-300 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">@L["Home.PurchaseReceipts"]</span>
                            <a href="receipts" class="text-xs font-semibold text-sky-600 hover:underline">@L["Common.ViewAll"] &rarr;</a>
                        </div>
                        <div class="flex items-baseline justify-between mt-1">
                            <div>
                                <span class="text-2xl font-black text-slate-900">@_receipts.Count</span>
                                <span class="text-xs text-slate-500 ml-1">@L["Home.TotalFiles"]</span>
                            </div>
                            <span class="text-xs font-bold text-sky-700 bg-sky-50 border border-sky-200/60 px-2 py-0.5 rounded-full">
                                @L.Format("Home.ThisMonthAdded", ReceiptsThisMonth)
                            </span>
                        </div>
                    </div>

                    <!-- 5. Freezer Inventory Telemetry -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 p-4 shadow-xs hover:border-slate-300 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">@L["Home.FreezerInventory"]</span>
                            <a href="freezer" class="text-xs font-semibold text-sky-600 hover:underline">@L["Home.FreezerLink"] &rarr;</a>
                        </div>
                        <div class="flex items-baseline justify-between mt-1">
                            <div>
                                <span class="text-2xl font-black text-slate-900">@(_freezerDashboard?.TotalItemCount ?? 0)</span>
                                <span class="text-xs text-slate-500 ml-1">@L["Home.ItemsFrozen"]</span>
                            </div>
                            @if ((_freezerDashboard?.ExpiringSoonCount ?? 0) + (_freezerDashboard?.ExpiredCount ?? 0) + (_freezerDashboard?.LowStockCount ?? 0) > 0)
                            {
                                <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200/60">
                                    @L.Format("Home.ExpiringOrLow", (_freezerDashboard?.ExpiringSoonCount ?? 0) + (_freezerDashboard?.ExpiredCount ?? 0) + (_freezerDashboard?.LowStockCount ?? 0))
                                </span>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200/60">
                                    @L["Home.AllFrozenFresh"]
                                </span>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    </main>
</div>

<!-- Global Modals for Quick Actions -->
@if (_showUploadReceiptModal)
{
    <UploadReceiptModal ExistingMerchants="@_merchants"
                        OnClose="() => _showUploadReceiptModal = false" 
                        OnReceiptUploaded="HandleReceiptUploaded" />
}

@if (_showAddPolicyModal)
{
    <InsurancePolicyModal OnClose="() => _showAddPolicyModal = false" 
                          OnSaved="HandlePolicySaved" />
}

@code {
    [Inject] public IReceiptApiClient ReceiptApi { get; set; } = null!;
    [Inject] public IInsuranceApiClient InsuranceApi { get; set; } = null!;
    [Inject] public ChildApiClient ChildApi { get; set; } = null!;
    [Inject] public VehicleApiClient VehicleApi { get; set; } = null!;

    private List<ReceiptViewModel> _receipts = new();
    private List<string> _merchants = new();
    private InsuranceOverviewModel? _insuranceOverview;
    private List<ChildProfileModel> _children = new();
    private List<VehicleDto> _vehicles = new();
    private FreezerDashboardDto? _freezerDashboard;
    private bool _isLoading = true;

    private bool _showUploadReceiptModal = false;
    private bool _showAddPolicyModal = false;

    private int ReceiptsThisMonth =>
        _receipts.Count(r => r.CreatedAt.ToLocalTime() is var created && created.Year == DateTime.Now.Year && created.Month == DateTime.Now.Month);

    private int UpcomingRenewalCount => _insuranceOverview?.UpcomingRenewals?.Count ?? 0;

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return L["Home.GreetingMorning"];
        if (hour < 18) return L["Home.GreetingAfternoon"];
        return L["Home.GreetingEvening"];
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var receiptsTask = ReceiptApi.GetReceiptsAsync();
            var merchantsTask = ReceiptApi.GetMerchantsAsync();
            var insuranceTask = InsuranceApi.GetOverviewAsync();
            var childrenTask = ChildApi.ListChildrenAsync();
            var vehiclesTask = VehicleApi.GetVehiclesAsync();
            var freezerTask = FreezerApi.GetDashboardAsync();

            await Task.WhenAll(receiptsTask, merchantsTask, insuranceTask, childrenTask, vehiclesTask, freezerTask);

            _receipts = await receiptsTask;
            _merchants = await merchantsTask;
            _insuranceOverview = await insuranceTask;
            _children = await childrenTask;
            _vehicles = await vehiclesTask;
            _freezerDashboard = await freezerTask;
        }
        catch
        {
            // Silently fall back to empty state on network issue
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleReceiptUploaded(ReceiptViewModel receipt)
    {
        _showUploadReceiptModal = false;
        _receipts.Insert(0, receipt);
    }

    private async Task HandlePolicySaved(InsurancePolicyViewModel policy)
    {
        _showAddPolicyModal = false;
        _insuranceOverview = await InsuranceApi.GetOverviewAsync();
    }
}
