@page "/children"
@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@using FamilyManagement.UI.Shared.Components
@inject ChildApiClient ChildApi

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans pb-24">
    <AppHeader CurrentSectionSubtitle="@L["Children.Subtitle"]" OnSettingsSaved="LoadChildrenAsync">
        <ActionContent>
            <button @onclick="() => _showRegisterChildModal = true" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold rounded-xl shadow-xs transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                <span>@L["Children.AddChild"]</span>
            </button>
        </ActionContent>
    </AppHeader>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        @if (_loading)
        {
            <div class="py-24 text-center">
                <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-sky-600 border-t-transparent"></div>
                <p class="mt-4 text-sm font-medium text-slate-500">@L["Children.Loading"]</p>
            </div>
        }
        else if (_children.Count == 0)
        {
            <div class="max-w-lg mx-auto bg-white border border-slate-200/80 rounded-3xl p-8 sm:p-10 text-center shadow-xs my-12">
                <div class="w-20 h-20 rounded-3xl bg-sky-50 text-sky-600 flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-black text-slate-900">@L["Children.WelcomeTitle"]</h2>
                <p class="text-sm text-slate-500 mt-2 mb-8 leading-relaxed">
                    @L["Children.WelcomeDescription"]
                </p>

                <button @onclick="() => _showRegisterChildModal = true" class="w-full py-3.5 px-6 bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm rounded-xl shadow-xs transition-all">
                    @L["Children.RegisterChildButton"]
                </button>
            </div>
        }
        else
        {
            @if (_children.Count > 1)
            {
                <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2">
                    @foreach (var c in _children)
                    {
                        <button @onclick="() => SelectChild(c.Id)" class="px-4 py-2 rounded-xl text-xs font-bold transition-all @(c.Id == _selectedChildId ? "bg-sky-600 text-white shadow-xs" : "bg-white text-slate-600 border border-slate-200/80 hover:border-sky-500 hover:text-sky-700")">
                            @c.FirstName
                        </button>
                    }
                    <button @onclick="() => _showRegisterChildModal = true" class="px-3 py-2 text-xs font-bold text-slate-500 hover:text-slate-900">
                        @L["Children.AddAnother"]
                    </button>
                </div>
            }

            @if (_activeChild != null)
            {
                <ChildHeaderCard Child="_activeChild" OnSizesUpdated="ReloadActiveChildAsync" />

                <div class="flex items-center gap-3 border-b border-slate-200/80 mb-6">
                    <button @onclick='() => _activeTab = "growth"' class="pb-3 text-sm font-bold border-b-2 transition-colors @(_activeTab == "growth" ? "border-sky-600 text-sky-600" : "border-transparent text-slate-500 hover:text-slate-900")">
                        @L["Children.Tab.Growth"]
                    </button>
                    <button @onclick='() => _activeTab = "roadmap"' class="pb-3 text-sm font-bold border-b-2 transition-colors @(_activeTab == "roadmap" ? "border-sky-600 text-sky-600" : "border-transparent text-slate-500 hover:text-slate-900")">
                        @L["Children.Tab.Roadmap"]
                    </button>
                    <button @onclick='() => _activeTab = "timeline"' class="pb-3 text-sm font-bold border-b-2 transition-colors @(_activeTab == "timeline" ? "border-sky-600 text-sky-600" : "border-transparent text-slate-500 hover:text-slate-900")">
                        @L["Children.Tab.Timeline"]
                    </button>
                </div>

                @if (_activeTab == "growth")
                {
                    <GrowthTab ChildId="_activeChild.Id"
                               LatestMeasurement="_dashboard?.LatestMeasurement"
                               LatestHeightMeasurement="_dashboard?.LatestHeightMeasurement"
                               LatestWeightMeasurement="_dashboard?.LatestWeightMeasurement"
                               LatestHeadCircumferenceMeasurement="_dashboard?.LatestHeadCircumferenceMeasurement"
                               OnMeasurementsChanged="ReloadActiveChildAsync" />
                }
                else if (_activeTab == "roadmap")
                {
                    <MilestonesRoadmapTab ChildId="_activeChild.Id" OnExpectationsChanged="ReloadActiveChildAsync" />
                }
                else if (_activeTab == "timeline")
                {
                    <MilestonesTimelineTab ChildId="_activeChild.Id" OnMilestonesChanged="ReloadActiveChildAsync" />
                }
            }
        }
    </main>

    @if (_showRegisterChildModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs">
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 max-w-md w-full shadow-xl">
                <h3 class="text-lg font-bold text-slate-900 mb-4">@L["Children.Modal.RegisterTitle"]</h3>

                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.FirstName"]</label>
                            <input @bind="_regFirstName" placeholder="@L["Children.Modal.FirstNamePlaceholder"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.LastName"]</label>
                            <input @bind="_regLastName" placeholder="@L["Common.Optional"]" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.DateOfBirth"]</label>
                            <input @bind="_regDob" type="date" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">@L["Children.Modal.Gender"]</label>
                            <select @bind="_regGender" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-200/80 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white">
                                <option value="Boy">@L.Gender("Boy")</option>
                                <option value="Girl">@L.Gender("Girl")</option>
                                <option value="Other">@L.Gender("Other")</option>
                            </select>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-slate-100">
                        <span class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">@L["Children.Modal.InitialSizes"]</span>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-1">@L["Children.Modal.ClothesSize"]</label>
                                <input @bind="_regClothesSize" placeholder="@L["Children.Modal.ClothesSizePlaceholder"]" class="w-full px-3 py-1.5 text-xs bg-slate-50 border border-slate-200/80 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                            </div>
                            <div>
                                <label class="block text-[11px] text-slate-500 mb-1">@L["Children.Modal.ShoeSize"]</label>
                                <input @bind="_regShoeSize" placeholder="@L["Children.Modal.ShoeSizePlaceholder"]" class="w-full px-3 py-1.5 text-xs bg-slate-50 border border-slate-200/80 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:bg-white" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-2 mt-6">
                    <button @onclick="() => _showRegisterChildModal = false" class="px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">@L["Common.Cancel"]</button>
                    <button @onclick="RegisterChildAsync" class="px-5 py-2 text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white rounded-xl shadow-xs transition-all">@L["Children.Modal.RegisterSubmit"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ChildProfileModel> _children = new();
    private Guid _selectedChildId;
    private ChildProfileModel? _activeChild;
    private ChildDashboardModel? _dashboard;
    private bool _loading = true;
    private string _activeTab = "growth";

    private bool _showRegisterChildModal;
    private string _regFirstName = string.Empty;
    private string? _regLastName;
    private DateTime _regDob = DateTime.Today.AddYears(-1);
    private string _regGender = "Boy";
    private string? _regClothesSize;
    private string? _regShoeSize;

    protected override async Task OnInitializedAsync()
    {
        await LoadChildrenAsync();
    }

    private async Task LoadChildrenAsync()
    {
        _loading = true;
        _children = await ChildApi.ListChildrenAsync();
        if (_children.Count > 0)
        {
            if (_selectedChildId == Guid.Empty || !_children.Any(c => c.Id == _selectedChildId))
            {
                _selectedChildId = _children[0].Id;
            }
            await LoadActiveChildDashboardAsync();
        }
        _loading = false;
    }

    private async Task SelectChild(Guid childId)
    {
        _selectedChildId = childId;
        await LoadActiveChildDashboardAsync();
    }

    private async Task LoadActiveChildDashboardAsync()
    {
        _dashboard = await ChildApi.GetDashboardAsync(_selectedChildId);
        _activeChild = _dashboard?.Child ?? _children.FirstOrDefault(c => c.Id == _selectedChildId);
    }

    private async Task ReloadActiveChildAsync()
    {
        await LoadActiveChildDashboardAsync();
    }

    private async Task RegisterChildAsync()
    {
        if (string.IsNullOrWhiteSpace(_regFirstName)) return;

        var child = await ChildApi.CreateChildAsync(
            _regFirstName,
            _regLastName,
            _regDob,
            _regGender,
            avatarUrl: null,
            clothesSize: _regClothesSize,
            shoeSize: _regShoeSize,
            hatSize: null,
            diaperSize: null);

        if (child != null)
        {
            _showRegisterChildModal = false;
            _selectedChildId = child.Id;
            await LoadChildrenAsync();
        }
    }
}