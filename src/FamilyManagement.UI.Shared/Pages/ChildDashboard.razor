@page "/children"
@using FamilyManagement.UI.Shared.Models.Children
@using FamilyManagement.UI.Shared.Services
@using FamilyManagement.UI.Shared.Components
@inject ChildApiClient ChildApi

<div class="min-h-screen bg-[#FAF6F0] dark:bg-[#1C1512] text-[#2B1D16] dark:text-[#FAF0E6] font-sans pb-16">
    <AppHeader CurrentSectionSubtitle="@L["Children.Subtitle"]" OnSettingsSaved="LoadChildrenAsync">
        <ActionContent>
            <button @onclick="() => _showRegisterChildModal = true" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-[#FDEEE9] hover:bg-[#F9DDD4] text-[#7B2F14] text-sm font-black rounded-xl shadow-md transition-all hover:shadow-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                <span>@L["Children.AddChild"]</span>
            </button>
        </ActionContent>
    </AppHeader>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        @if (_loading)
        {
            <div class="py-24 text-center">
                <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-[#C85A32] border-t-transparent"></div>
                <p class="mt-4 text-sm font-medium text-[#7F6A5D] dark:text-[#A8988B]">@L["Children.Loading"]</p>
            </div>
        }
        else if (_children.Count == 0)
        {
            <div class="max-w-lg mx-auto bg-white dark:bg-[#261D19] border border-[#EADECF] dark:border-[#3D2F28] rounded-3xl p-8 sm:p-10 text-center shadow-lg my-12">
                <div class="w-20 h-20 rounded-3xl bg-[#C85A32]/10 dark:bg-[#FDEEE9]/15 text-[#C85A32] dark:text-[#FDEEE9] flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h2 class="text-2xl font-black text-[#2B1D16] dark:text-[#FAF0E6]">@L["Children.WelcomeTitle"]</h2>
                <p class="text-sm text-[#7F6A5D] dark:text-[#A8988B] mt-2 mb-8 leading-relaxed">
                    @L["Children.WelcomeDescription"]
                </p>

                <button @onclick="() => _showRegisterChildModal = true" class="w-full py-3.5 px-6 bg-[#C85A32] hover:bg-[#B54E29] text-white dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] dark:text-[#7B2F14] font-bold text-sm rounded-xl shadow-md transition-all">
                    @L["Children.RegisterChildButton"]
                </button>
            </div>
        }
        else
        {
            @if (_children.Count > 1)
            {
                <div class="flex items-center gap-2 mb-6 overflow-x-auto pb-2">
                    @foreach (var c in _children)
                    {
                        <button @onclick="() => SelectChild(c.Id)" class="px-4 py-2 rounded-xl text-xs font-bold transition-all @(c.Id == _selectedChildId ? "bg-[#C85A32] text-white dark:bg-[#FDEEE9] dark:text-[#7B2F14] shadow-xs" : "bg-white dark:bg-[#261D19] text-[#7F6A5D] dark:text-[#EADECF] border border-[#EADECF] dark:border-[#3D2F28]")">
                            @c.FirstName
                        </button>
                    }
                    <button @onclick="() => _showRegisterChildModal = true" class="px-3 py-2 text-xs font-bold text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]">
                        @L["Children.AddAnother"]
                    </button>
                </div>
            }

            @if (_activeChild != null)
            {
                <ChildHeaderCard Child="_activeChild" OnSizesUpdated="ReloadActiveChildAsync" />

                <div class="flex items-center gap-3 border-b border-[#EADECF] dark:border-[#3D2F28] mb-6">
                    <button @onclick='() => _activeTab = "growth"' class="pb-3 text-sm font-bold border-b-2 transition-colors @(_activeTab == "growth" ? "border-[#C85A32] text-[#C85A32] dark:border-[#FDEEE9] dark:text-[#FDEEE9]" : "border-transparent text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                        @L["Children.Tab.Growth"]
                    </button>
                    <button @onclick='() => _activeTab = "roadmap"' class="pb-3 text-sm font-bold border-b-2 transition-colors @(_activeTab == "roadmap" ? "border-[#C85A32] text-[#C85A32] dark:border-[#FDEEE9] dark:text-[#FDEEE9]" : "border-transparent text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                        @L["Children.Tab.Roadmap"]
                    </button>
                    <button @onclick='() => _activeTab = "timeline"' class="pb-3 text-sm font-bold border-b-2 transition-colors @(_activeTab == "timeline" ? "border-[#C85A32] text-[#C85A32] dark:border-[#FDEEE9] dark:text-[#FDEEE9]" : "border-transparent text-[#7F6A5D] hover:text-[#2B1D16] dark:text-[#A8988B] dark:hover:text-[#FAF0E6]")">
                        @L["Children.Tab.Timeline"]
                    </button>
                </div>

                @if (_activeTab == "growth")
                {
                    <GrowthTab ChildId="_activeChild.Id"
                               LatestMeasurement="_dashboard?.LatestMeasurement"
                               LatestHeightMeasurement="_dashboard?.LatestHeightMeasurement"
                               LatestWeightMeasurement="_dashboard?.LatestWeightMeasurement"
                               LatestHeadCircumferenceMeasurement="_dashboard?.LatestHeadCircumferenceMeasurement"
                               OnMeasurementsChanged="ReloadActiveChildAsync" />
                }
                else if (_activeTab == "roadmap")
                {
                    <MilestonesRoadmapTab ChildId="_activeChild.Id" OnExpectationsChanged="ReloadActiveChildAsync" />
                }
                else if (_activeTab == "timeline")
                {
                    <MilestonesTimelineTab ChildId="_activeChild.Id" OnMilestonesChanged="ReloadActiveChildAsync" />
                }
            }
        }
    </main>

    @if (_showRegisterChildModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
            <div class="bg-white dark:bg-[#261D19] rounded-2xl border border-[#EADECF] dark:border-[#3D2F28] p-6 max-w-md w-full shadow-2xl">
                <h3 class="text-lg font-bold text-[#2B1D16] dark:text-[#FAF0E6] mb-4">@L["Children.Modal.RegisterTitle"]</h3>

                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Children.Modal.FirstName"]</label>
                            <input @bind="_regFirstName" placeholder="@L["Children.Modal.FirstNamePlaceholder"]" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Children.Modal.LastName"]</label>
                            <input @bind="_regLastName" placeholder="@L["Common.Optional"]" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Children.Modal.DateOfBirth"]</label>
                            <input @bind="_regDob" type="date" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-[#7F6A5D] dark:text-[#EADECF] mb-1">@L["Children.Modal.Gender"]</label>
                            <select @bind="_regGender" class="w-full px-3 py-2 text-sm bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-xl text-[#2B1D16] dark:text-[#FAF0E6] focus:outline-hidden focus:border-[#C85A32]">
                                <option value="Boy">@L.Gender("Boy")</option>
                                <option value="Girl">@L.Gender("Girl")</option>
                                <option value="Other">@L.Gender("Other")</option>
                            </select>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-[#EADECF] dark:border-[#3D2F28]">
                        <span class="block text-xs font-bold text-[#7F6A5D] dark:text-[#A8988B] uppercase tracking-wider mb-2">@L["Children.Modal.InitialSizes"]</span>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[11px] text-[#7F6A5D] dark:text-[#A8988B] mb-1">@L["Children.Modal.ClothesSize"]</label>
                                <input @bind="_regClothesSize" placeholder="@L["Children.Modal.ClothesSizePlaceholder"]" class="w-full px-3 py-1.5 text-xs bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-lg text-[#2B1D16] dark:text-[#FAF0E6]" />
                            </div>
                            <div>
                                <label class="block text-[11px] text-[#7F6A5D] dark:text-[#A8988B] mb-1">@L["Children.Modal.ShoeSize"]</label>
                                <input @bind="_regShoeSize" placeholder="@L["Children.Modal.ShoeSizePlaceholder"]" class="w-full px-3 py-1.5 text-xs bg-[#FAF6F0] dark:bg-[#1C1512] border border-[#EADECF] dark:border-[#3D2F28] rounded-lg text-[#2B1D16] dark:text-[#FAF0E6]" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-2 mt-6">
                    <button @onclick="() => _showRegisterChildModal = false" class="px-4 py-2 text-sm font-semibold text-[#7F6A5D] dark:text-[#EADECF] hover:bg-[#FAF6F0] dark:hover:bg-[#3D2F28]/50 rounded-xl">@L["Common.Cancel"]</button>
                    <button @onclick="RegisterChildAsync" class="px-5 py-2 text-sm font-semibold bg-[#C85A32] hover:bg-[#B54E29] text-white dark:bg-[#FDEEE9] dark:hover:bg-[#F9DDD4] dark:text-[#7B2F14] rounded-xl shadow-xs">@L["Children.Modal.RegisterSubmit"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ChildProfileModel> _children = new();
    private Guid _selectedChildId;
    private ChildProfileModel? _activeChild;
    private ChildDashboardModel? _dashboard;
    private bool _loading = true;
    private string _activeTab = "growth";

    private bool _showRegisterChildModal;
    private string _regFirstName = string.Empty;
    private string? _regLastName;
    private DateTime _regDob = DateTime.Today.AddYears(-1);
    private string _regGender = "Boy";
    private string? _regClothesSize;
    private string? _regShoeSize;

    protected override async Task OnInitializedAsync()
    {
        await LoadChildrenAsync();
    }

    private async Task LoadChildrenAsync()
    {
        _loading = true;
        _children = await ChildApi.ListChildrenAsync();
        if (_children.Count > 0)
        {
            if (_selectedChildId == Guid.Empty || !_children.Any(c => c.Id == _selectedChildId))
            {
                _selectedChildId = _children[0].Id;
            }
            await LoadActiveChildDashboardAsync();
        }
        _loading = false;
    }

    private async Task SelectChild(Guid childId)
    {
        _selectedChildId = childId;
        await LoadActiveChildDashboardAsync();
    }

    private async Task LoadActiveChildDashboardAsync()
    {
        _dashboard = await ChildApi.GetDashboardAsync(_selectedChildId);
        _activeChild = _dashboard?.Child ?? _children.FirstOrDefault(c => c.Id == _selectedChildId);
    }

    private async Task ReloadActiveChildAsync()
    {
        await LoadActiveChildDashboardAsync();
    }

    private async Task RegisterChildAsync()
    {
        if (string.IsNullOrWhiteSpace(_regFirstName)) return;

        var child = await ChildApi.CreateChildAsync(
            _regFirstName,
            _regLastName,
            _regDob,
            _regGender,
            avatarUrl: null,
            clothesSize: _regClothesSize,
            shoeSize: _regShoeSize,
            hatSize: null,
            diaperSize: null);

        if (child != null)
        {
            _showRegisterChildModal = false;
            _selectedChildId = child.Id;
            await LoadChildrenAsync();
        }
    }
}