@page "/receipts"
@using FamilyManagement.UI.Shared.Components
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="min-h-screen bg-[#fbf9f5] dark:bg-[#0b1a24] text-slate-800 dark:text-slate-100 font-sans pb-16">
    <!-- Top Navigation Bar -->
    <AppHeader CurrentSectionSubtitle="Archived to Google Drive" OnSettingsSaved="LoadReceiptsAsync">
        <ActionContent>
            <button @onclick="() => _showUploadModal = true" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-[#abf5ed] hover:bg-[#8eebe0] text-[#042838] text-sm font-black rounded-xl shadow-md shadow-[#abf5ed]/20 transition-all hover:shadow-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                <span>Upload</span>
            </button>
        </ActionContent>
    </AppHeader>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <!-- 1. Pale King's Blue: This Month -->
            <div class="bg-[#abf5ed]/15 border-2 border-[#abf5ed]/40 p-5 rounded-2xl shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#abf5ed] text-[#042838] flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-[#064f6e] dark:text-[#abf5ed] uppercase tracking-wider">This Month</p>
                    <p class="text-3xl font-black text-[#064f6e] dark:text-[#abf5ed]">@ReceiptsThisMonth</p>
                </div>
            </div>

            <!-- 2. Vandar Poel's Blue: Total Receipts -->
            <div class="bg-[#064f6e]/15 border-2 border-[#064f6e]/40 p-5 rounded-2xl shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#064f6e] text-white flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-[#064f6e] dark:text-[#7bece0] uppercase tracking-wider">Total Receipts</p>
                    <p class="text-3xl font-black text-[#064f6e] dark:text-[#abf5ed]">@_receipts.Count</p>
                </div>
            </div>

            <!-- 3. Ecru: Top Category -->
            <div class="bg-[#c0b490]/20 border-2 border-[#c0b490]/50 p-5 rounded-2xl shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-[#c0b490] text-[#342d21] flex items-center justify-center shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-[#71644c] dark:text-[#ddd0b2] uppercase tracking-wider">Top Category</p>
                    <p class="text-2xl font-black text-[#71644c] dark:text-[#ddd0b2]">@TopCategory</p>
                </div>
            </div>
        </div>

        <!-- Filters & Search -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between mb-6">
            <!-- Search input -->
            <div class="relative flex-1 max-w-md">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <input @bind="_searchQuery" @bind:event="oninput" list="dashboard-merchants" type="text" placeholder="Search by merchant..."
                       class="w-full pl-9 pr-4 py-2 text-sm bg-white dark:bg-[#122b3b] border border-[#e2d8c7] dark:border-[#1a3b50] rounded-xl focus:ring-2 focus:ring-[#064f6e] dark:focus:ring-[#abf5ed] focus:outline-none shadow-sm" />
                <datalist id="dashboard-merchants">
                    @foreach (var m in _distinctMerchants)
                    {
                        <option value="@m">@m</option>
                    }
                </datalist>
            </div>

            <!-- Category Filter Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
                <button @onclick='() => _selectedCategory = null'
                        class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == null ? "bg-[#064f6e] text-white dark:bg-[#abf5ed] dark:text-[#042838] shadow-sm" : "bg-white dark:bg-[#122b3b] text-slate-600 dark:text-slate-300 border border-[#e2d8c7] dark:border-[#1a3b50] hover:border-[#abf5ed]")">
                    All
                </button>
                @foreach (var cat in ReceiptCategories.All)
                {
                    <button @onclick="() => _selectedCategory = cat"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == cat ? "bg-[#064f6e] text-white dark:bg-[#abf5ed] dark:text-[#042838] shadow-sm" : "bg-white dark:bg-[#122b3b] text-slate-600 dark:text-slate-300 border border-[#e2d8c7] dark:border-[#1a3b50] hover:border-[#abf5ed]")">
                        @cat
                    </button>
                }
            </div>
        </div>

        <!-- Receipt Grid or States -->
        @if (_isLoading)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="h-44 bg-slate-200/60 dark:bg-[#122b3b]/60 animate-pulse rounded-2xl"></div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="bg-rose-50 dark:bg-rose-900/30 border border-rose-200 dark:border-rose-800 rounded-2xl p-6 text-center">
                <p class="text-rose-700 dark:text-rose-300 font-semibold mb-2">Could not connect to Family Management API</p>
                <p class="text-xs text-slate-500 mb-4">@_errorMessage</p>
                <div class="flex justify-center gap-3">
                    <button @onclick="LoadReceiptsAsync" class="px-4 py-2 bg-rose-600 text-white text-xs font-semibold rounded-lg">Retry</button>
                    <button @onclick="() => _showSettingsModal = true" class="px-4 py-2 bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold rounded-lg">Check Server URL</button>
                </div>
            </div>
        }
        else if (FilteredReceipts.Count == 0)
        {
            <div class="bg-white dark:bg-[#122b3b] rounded-2xl border border-[#e2d8c7] dark:border-[#1a3b50] p-12 text-center shadow-sm">
                <div class="w-16 h-16 bg-[#064f6e]/10 dark:bg-[#abf5ed]/15 text-[#064f6e] dark:text-[#abf5ed] rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-bold">No receipts found</h3>
                <p class="text-sm text-slate-500 mt-1 mb-6">
                    @(_receipts.Count == 0 ? "You haven't uploaded any receipts yet. Add your first purchase receipt!" : "No receipts match your search filter.")
                </p>
                <button @onclick="() => _showUploadModal = true" class="px-5 py-2.5 bg-[#064f6e] hover:bg-[#05425c] text-white dark:bg-[#abf5ed] dark:hover:bg-[#8eebe0] dark:text-[#042838] text-sm font-semibold rounded-xl shadow-md">
                    Upload First Receipt
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var receipt in FilteredReceipts)
                {
                    <ReceiptCard Receipt="@receipt" OnDelete="HandleDeleteAsync" />
                }
            </div>
        }
    </main>
</div>

<!-- Modals -->
@if (_showUploadModal)
{
    <UploadReceiptModal ExistingMerchants="@_distinctMerchants" OnClose="() => _showUploadModal = false" OnReceiptUploaded="HandleReceiptUploaded" />
}

@if (_showSettingsModal)
{
    <ApiSettingsModal OnClose="() => _showSettingsModal = false" OnSaved="LoadReceiptsAsync" />
}

@code {
    [Inject]
    public IReceiptApiClient ApiClient { get; set; } = null!;

    private List<ReceiptViewModel> _receipts = new();
    private List<string> _distinctMerchants = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private string _searchQuery = string.Empty;
    private string? _selectedCategory;

    private bool _showUploadModal = false;
    private bool _showSettingsModal = false;

    private int ReceiptsThisMonth =>
        _receipts.Count(r => r.CreatedAt.ToLocalTime() is var created && created.Year == DateTime.Now.Year && created.Month == DateTime.Now.Month);

    private string TopCategory
    {
        get
        {
            if (_receipts.Count == 0) return "None";
            return _receipts
                .GroupBy(r => r.Category)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault()?.Key ?? "None";
        }
    }

    private List<ReceiptViewModel> FilteredReceipts
    {
        get
        {
            var query = _receipts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(r => r.Merchant.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                                      || (r.Notes?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(_selectedCategory))
            {
                query = query.Where(r => r.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(r => r.PurchaseDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReceiptsAsync();
    }

    private async Task LoadReceiptsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var receiptsTask = ApiClient.GetReceiptsAsync();
            var merchantsTask = ApiClient.GetMerchantsAsync();
            await Task.WhenAll(receiptsTask, merchantsTask);
            _receipts = await receiptsTask;
            _distinctMerchants = await merchantsTask;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleReceiptUploaded(ReceiptViewModel newReceipt)
    {
        _receipts.Insert(0, newReceipt);
        if (!string.IsNullOrWhiteSpace(newReceipt.Merchant) &&
            !_distinctMerchants.Any(m => string.Equals(m, newReceipt.Merchant.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            _distinctMerchants.Add(newReceipt.Merchant.Trim());
            _distinctMerchants.Sort(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task HandleDeleteAsync(Guid id)
    {
        var success = await ApiClient.DeleteReceiptAsync(id);
        if (success)
        {
            _receipts.RemoveAll(r => r.Id == id);
        }
    }
}
