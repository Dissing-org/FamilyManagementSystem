@page "/"
@page "/receipts"
@using FamilyManagement.UI.Shared.Components
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="min-h-screen bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans pb-16">
    <!-- Top Navigation Bar -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-500/20">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight">Family Receipts</h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Archived to Google Drive</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button @onclick="() => _showSettingsModal = true" 
                        class="p-2 text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
                        title="Server Settings">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </button>

                <button @onclick="() => _showUploadModal = true" 
                        class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm shadow-indigo-600/30 transition-all hover:shadow-md">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span>Upload</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Tracked</p>
                    <p class="text-2xl font-black text-slate-900 dark:text-slate-100">@TotalSpend.ToString("C2")</p>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Receipts</p>
                    <p class="text-2xl font-black text-slate-900 dark:text-slate-100">@_receipts.Count</p>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-100 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Top Category</p>
                    <p class="text-xl font-bold text-slate-900 dark:text-slate-100">@TopCategory</p>
                </div>
            </div>
        </div>

        <!-- Filters & Search -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between mb-6">
            <!-- Search input -->
            <div class="relative flex-1 max-w-md">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <input @bind="_searchQuery" @bind:event="oninput" type="text" placeholder="Search by merchant..."
                       class="w-full pl-9 pr-4 py-2 text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none shadow-sm" />
            </div>

            <!-- Category Filter Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
                <button @onclick='() => _selectedCategory = null'
                        class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == null ? "bg-indigo-600 text-white" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700")">
                    All
                </button>
                @foreach (var cat in ReceiptCategories.All)
                {
                    <button @onclick="() => _selectedCategory = cat"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == cat ? "bg-indigo-600 text-white" : "bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700")">
                        @cat
                    </button>
                }
            </div>
        </div>

        <!-- Receipt Grid or States -->
        @if (_isLoading)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="h-44 bg-slate-200 dark:bg-slate-800 animate-pulse rounded-2xl"></div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="bg-rose-50 dark:bg-rose-900/30 border border-rose-200 dark:border-rose-800 rounded-2xl p-6 text-center">
                <p class="text-rose-700 dark:text-rose-300 font-semibold mb-2">Could not connect to Family Management API</p>
                <p class="text-xs text-slate-500 mb-4">@_errorMessage</p>
                <div class="flex justify-center gap-3">
                    <button @onclick="LoadReceiptsAsync" class="px-4 py-2 bg-rose-600 text-white text-xs font-semibold rounded-lg">Retry</button>
                    <button @onclick="() => _showSettingsModal = true" class="px-4 py-2 bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold rounded-lg">Check Server URL</button>
                </div>
            </div>
        }
        else if (FilteredReceipts.Count == 0)
        {
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-12 text-center">
                <div class="w-16 h-16 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-bold">No receipts found</h3>
                <p class="text-sm text-slate-500 mt-1 mb-6">
                    @(_receipts.Count == 0 ? "You haven't uploaded any receipts yet. Add your first purchase receipt!" : "No receipts match your search filter.")
                </p>
                <button @onclick="() => _showUploadModal = true" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm">
                    Upload First Receipt
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var receipt in FilteredReceipts)
                {
                    <ReceiptCard Receipt="@receipt" OnDelete="HandleDeleteAsync" />
                }
            </div>
        }
    </main>
</div>

<!-- Modals -->
@if (_showUploadModal)
{
    <UploadReceiptModal OnClose="() => _showUploadModal = false" OnReceiptUploaded="HandleReceiptUploaded" />
}

@if (_showSettingsModal)
{
    <ApiSettingsModal OnClose="() => _showSettingsModal = false" OnSaved="LoadReceiptsAsync" />
}

@code {
    [Inject]
    public IReceiptApiClient ApiClient { get; set; } = null!;

    private List<ReceiptViewModel> _receipts = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private string _searchQuery = string.Empty;
    private string? _selectedCategory;

    private bool _showUploadModal = false;
    private bool _showSettingsModal = false;

    private decimal TotalSpend => _receipts.Sum(r => r.Amount);

    private string TopCategory
    {
        get
        {
            if (_receipts.Count == 0) return "None";
            return _receipts
                .GroupBy(r => r.Category)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault()?.Key ?? "None";
        }
    }

    private List<ReceiptViewModel> FilteredReceipts
    {
        get
        {
            var query = _receipts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(r => r.Merchant.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                                      || (r.Notes?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(_selectedCategory))
            {
                query = query.Where(r => r.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(r => r.PurchaseDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReceiptsAsync();
    }

    private async Task LoadReceiptsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            _receipts = await ApiClient.GetReceiptsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleReceiptUploaded(ReceiptViewModel newReceipt)
    {
        _receipts.Insert(0, newReceipt);
    }

    private async Task HandleDeleteAsync(Guid id)
    {
        var success = await ApiClient.DeleteReceiptAsync(id);
        if (success)
        {
            _receipts.RemoveAll(r => r.Id == id);
        }
    }
}
