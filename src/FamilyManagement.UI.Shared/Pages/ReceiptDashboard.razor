@page "/receipts"
@using FamilyManagement.UI.Shared.Components
@using FamilyManagement.UI.Shared.Models
@using FamilyManagement.UI.Shared.Services

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans pb-24">
    <!-- Top Navigation Bar -->
    <AppHeader CurrentSectionSubtitle="@L["Receipts.Subtitle"]" OnSettingsSaved="LoadReceiptsAsync">
        <ActionContent>
            <button @onclick="() => _showUploadModal = true" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold rounded-xl shadow-xs transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
                <span>@L["Receipts.Upload"]</span>
            </button>
        </ActionContent>
    </AppHeader>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <!-- 1. This Month -->
            <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shadow-xs">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">@L["Receipts.ThisMonth"]</p>
                    <p class="text-3xl font-black text-slate-900">@ReceiptsThisMonth</p>
                </div>
            </div>

            <!-- 2. Total Receipts -->
            <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center shadow-xs">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">@L["Receipts.TotalReceipts"]</p>
                    <p class="text-3xl font-black text-slate-900">@_receipts.Count</p>
                </div>
            </div>

            <!-- 3. Top Category -->
            <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-xs flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-xs">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">@L["Receipts.TopCategory"]</p>
                    <p class="text-2xl font-black text-slate-900">@L.Category(TopCategory)</p>
                </div>
            </div>
        </div>

        <!-- Filters & Search -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between mb-6">
            <!-- Search input -->
            <div class="relative flex-1 max-w-md">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
                <input @bind="_searchQuery" @bind:event="oninput" list="dashboard-merchants" type="text" placeholder="@L["Receipts.SearchPlaceholder"]"
                       class="w-full pl-9 pr-4 py-2 text-sm bg-white border border-slate-200/80 rounded-xl focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 focus:outline-none shadow-xs text-slate-900 placeholder-slate-400" />
                <datalist id="dashboard-merchants">
                    @foreach (var m in _distinctMerchants)
                    {
                        <option value="@m">@m</option>
                    }
                </datalist>
            </div>

            <!-- Category Filter Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
                <button @onclick='() => _selectedCategory = null'
                        class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == null ? "bg-sky-600 text-white shadow-xs font-bold" : "bg-white text-slate-600 border border-slate-200/80 hover:border-sky-500 hover:text-sky-700")">
                    @L["Common.All"]
                </button>
                @foreach (var cat in ReceiptCategories.All)
                {
                    <button @onclick="() => _selectedCategory = cat"
                            class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors whitespace-nowrap @(_selectedCategory == cat ? "bg-sky-600 text-white shadow-xs font-bold" : "bg-white text-slate-600 border border-slate-200/80 hover:border-sky-500 hover:text-sky-700")">
                        @L.Category(cat)
                    </button>
                }
            </div>
        </div>

        <!-- Receipt Grid or States -->
        @if (_isLoading)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="h-44 bg-slate-200 animate-pulse rounded-2xl"></div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="bg-rose-50 border border-rose-200/60 rounded-2xl p-6 text-center shadow-xs">
                <p class="text-rose-700 font-semibold mb-2">@L["Receipts.ConnectionErrorTitle"]</p>
                <p class="text-xs text-slate-500 mb-4">@_errorMessage</p>
                <div class="flex justify-center gap-3">
                    <button @onclick="LoadReceiptsAsync" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg transition-colors">@L["Common.Retry"]</button>
                    <button @onclick="() => _showSettingsModal = true" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold rounded-lg transition-colors">@L["Receipts.CheckServerUrl"]</button>
                </div>
            </div>
        }
        else if (FilteredReceipts.Count == 0)
        {
            <div class="bg-white rounded-2xl border border-slate-200/80 p-12 text-center shadow-xs">
                <div class="w-16 h-16 bg-sky-50 text-sky-600 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900">@L["Receipts.NoReceiptsTitle"]</h3>
                <p class="text-sm text-slate-500 mt-1 mb-6">
                    @(_receipts.Count == 0 ? L["Receipts.EmptyStateNoReceipts"] : L["Receipts.EmptyStateNoMatch"])
                </p>
                <button @onclick="() => _showUploadModal = true" class="px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-sm font-bold rounded-xl shadow-xs transition-all">
                    @L["Receipts.UploadFirstReceipt"]
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var receipt in FilteredReceipts)
                {
                    <ReceiptCard Receipt="@receipt" OnDelete="HandleDeleteAsync" />
                }
            </div>
        }
    </main>
</div>

<!-- Modals -->
@if (_showUploadModal)
{
    <UploadReceiptModal ExistingMerchants="@_distinctMerchants" OnClose="() => _showUploadModal = false" OnReceiptUploaded="HandleReceiptUploaded" />
}

@if (_showSettingsModal)
{
    <ApiSettingsModal OnClose="() => _showSettingsModal = false" OnSaved="LoadReceiptsAsync" />
}

@code {
    [Inject]
    public IReceiptApiClient ApiClient { get; set; } = null!;

    private List<ReceiptViewModel> _receipts = new();
    private List<string> _distinctMerchants = new();
    private bool _isLoading = true;
    private string? _errorMessage;

    private string _searchQuery = string.Empty;
    private string? _selectedCategory;

    private bool _showUploadModal = false;
    private bool _showSettingsModal = false;

    private int ReceiptsThisMonth =>
        _receipts.Count(r => r.CreatedAt.ToLocalTime() is var created && created.Year == DateTime.Now.Year && created.Month == DateTime.Now.Month);

    private string TopCategory
    {
        get
        {
            if (_receipts.Count == 0) return "None";
            return _receipts
                .GroupBy(r => r.Category)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault()?.Key ?? "None";
        }
    }

    private List<ReceiptViewModel> FilteredReceipts
    {
        get
        {
            var query = _receipts.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(r => r.Merchant.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                                      || (r.Notes?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrWhiteSpace(_selectedCategory))
            {
                query = query.Where(r => r.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderByDescending(r => r.PurchaseDate).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadReceiptsAsync();
    }

    private async Task LoadReceiptsAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var receiptsTask = ApiClient.GetReceiptsAsync();
            var merchantsTask = ApiClient.GetMerchantsAsync();
            await Task.WhenAll(receiptsTask, merchantsTask);
            _receipts = await receiptsTask;
            _distinctMerchants = await merchantsTask;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleReceiptUploaded(ReceiptViewModel newReceipt)
    {
        _receipts.Insert(0, newReceipt);
        if (!string.IsNullOrWhiteSpace(newReceipt.Merchant) &&
            !_distinctMerchants.Any(m => string.Equals(m, newReceipt.Merchant.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            _distinctMerchants.Add(newReceipt.Merchant.Trim());
            _distinctMerchants.Sort(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task HandleDeleteAsync(Guid id)
    {
        var success = await ApiClient.DeleteReceiptAsync(id);
        if (success)
        {
            _receipts.RemoveAll(r => r.Id == id);
        }
    }
}
